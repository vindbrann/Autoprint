<Project Sdk="WixToolset.Sdk/7.0.1">
  <!-- Contrat OSMF de WiX 7 accepté par le propriétaire du projet le 11/11/2026 (redevance seulement au-delà de 10 000 $ de revenus annuels
       tirés des projets qui utilisent WiX ; voir Docs/projet/POLITIQUE_VERSIONS.md). Porte de sortie : WiX compilé depuis ses sources (MS-RL). -->
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
		<Cultures>fr-FR</Cultures>
		<DefineConstants>PublishFolder=..\Autoprint.Server\bin\Release\net10.0\publish\;AppVersion=$(Version)</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<Cultures>fr-FR</Cultures>
		<DefineConstants>PublishFolder=..\Autoprint.Server\bin\Release\net10.0\publish\;AppVersion=$(Version)</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.Iis.wixext" Version="7.0.1" />
		<PackageReference Include="WixToolset.UI.wixext" Version="7.0.1" />
		<PackageReference Include="WixToolset.Util.wixext" Version="7.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Platform=x64 (MSI) ne doit pas descendre jusqu'à Autoprint.Web (browser-wasm) : erreur NETSDK1032 -->
		<ProjectReference Include="..\Autoprint.Server\Autoprint.Server.csproj" GlobalPropertiesToRemove="Platform;PlatformTarget" />
	</ItemGroup>

	<!-- Après la compilation des projets référencés (Autoprint.Server…) : sinon ce dotnet publish, lancé dans un autre processus,
	     écrit dans leurs dossiers obj pendant que la compilation parallèle de la solution les compile (B65).
	     La solution fait aussi dépendre ce projet de tous les projets C# (ProjectDependencies) : la référence ci-dessus compile
	     Autoprint.Server sous d'autres propriétés globales que la solution, donc en parallèle de celle-ci (échec revu le 11/11/2026). -->
	<Target Name="PublishApp" BeforeTargets="BeforeBuild" DependsOnTargets="ResolveProjectReferences">
		<!-- Le MSI embarque tout le dossier publié (publish\**) : le vider avant, sinon les fichiers des publications
		     précédentes (anciennes versions de la console, paquets supprimés) partent aussi dans le MSI -->
		<RemoveDir Directories="..\Autoprint.Server\bin\Release\net10.0\publish;..\Autoprint.SpoolerService\bin\Release\publish" />
		<!-- B45 : publication pour Windows x64 seulement (plus de bibliothèques natives Linux / macOS, ~110 Mo), dans le dossier habituel -->
    <Exec Command="dotnet publish ..\Autoprint.Server\Autoprint.Server.csproj -c Release -f net10.0 -r win-x64 --self-contained false -o ..\Autoprint.Server\bin\Release\net10.0\publish" />
		<!-- Service Windows AutoprintSpooler (exécutable unique) : seul composant privilégié du serveur -->
		<Exec Command="dotnet publish ..\Autoprint.SpoolerService\Autoprint.SpoolerService.csproj -c Release -o ..\Autoprint.SpoolerService\bin\Release\publish" />
	</Target>

</Project>