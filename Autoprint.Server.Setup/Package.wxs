<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
	<Package Name="Autoprint Server" Manufacturer="Nicolas CARUANA" Version="$(var.AppVersion)" UpgradeCode="a6f8f87a-9c9d-4e9f-8b8a-1234567890ab">
		<MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Une version plus récente est déjà installée." />

		<MediaTemplate EmbedCab="yes" />

		<!-- Désinstallation (pas lors d'une mise à jour) : l'assistant crée le site IIS, le pool et la règle de pare-feu hors du MSI ;
		     sans ces actions, ils restaient après désinstallation (site orphelin, port du site ouvert dans le pare-feu) (B74) -->
		<CustomAction Id="RemoveFirewallRule" Directory="System64Folder"
		              ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;Autoprint Server&quot;"
		              Execute="deferred" Impersonate="no" Return="ignore" />
		<CustomAction Id="RemoveIisSite" Directory="System64Folder"
		              ExeCommand="&quot;[System64Folder]inetsrv\appcmd.exe&quot; delete site &quot;Autoprint&quot;"
		              Execute="deferred" Impersonate="no" Return="ignore" />
		<CustomAction Id="RemoveIisPool" Directory="System64Folder"
		              ExeCommand="&quot;[System64Folder]inetsrv\appcmd.exe&quot; delete apppool &quot;Autoprint&quot;"
		              Execute="deferred" Impersonate="no" Return="ignore" />

		<InstallExecuteSequence>
			<Custom Action="RemoveIisSite" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
			<Custom Action="RemoveIisPool" After="RemoveIisSite" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
			<Custom Action="RemoveFirewallRule" After="RemoveIisPool" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
		</InstallExecuteSequence>

		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="Autoprint Server">
				<Directory Id="SPOOLERFOLDER" Name="Spooler" />
			</Directory>
		</StandardDirectory>

		<Feature Id="Main">
			<ComponentGroupRef Id="AppFiles" />
			<ComponentGroupRef Id="ConfigFiles" />
			<ComponentGroupRef Id="SpoolerServiceFiles" />
		</Feature>

		<ui:WixUI Id="WixUI_InstallDir" />
		<!-- Charte graphique (B77) : bandeau 493×58 et page d'accueil / fin 493×312 -->
		<WixVariable Id="WixUIBannerBmp" Value="Resources\banniere-493x58.bmp" />
		<WixVariable Id="WixUIDialogBmp" Value="Resources\accueil-493x312.bmp" />
		<Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
	</Package>
</Wix>