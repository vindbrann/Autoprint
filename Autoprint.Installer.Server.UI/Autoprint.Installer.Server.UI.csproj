<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Version du Hosting Bundle embarqué (Resources\dotnet-hosting-10.exe, non versionné dans git).
         C'est aussi la version minimale exigée sur le serveur : un runtime plus ancien est signalé et mis à jour.
         À relever à chaque publication (voir Docs/_POLITIQUE_VERSIONS.md). -->
    <HostingBundleVersion>10.0.15</HostingBundleVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="HostingBundleVersion" Value="$(HostingBundleVersion)" />
  </ItemGroup>

  <!-- Empêche de publier un installeur dont le Hosting Bundle embarqué ne correspond pas à la version déclarée -->
  <Target Name="CheckHostingBundleVersion" BeforeTargets="BeforeBuild" Condition="Exists('Resources\dotnet-hosting-10.exe')">
    <Exec Command="powershell -NoProfile -Command &quot;(Get-Item 'Resources\dotnet-hosting-10.exe').VersionInfo.ProductVersion&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_EmbeddedBundleVersion" />
    </Exec>
    <Error Condition="'$(_EmbeddedBundleVersion.Trim().StartsWith(`$(HostingBundleVersion).`))' != 'True'"
           Text="Resources\dotnet-hosting-10.exe est en version $(_EmbeddedBundleVersion) alors que HostingBundleVersion vaut $(HostingBundleVersion) : remplacer le fichier ou corriger la propriété." />
  </Target>

  <ItemGroup>
    <None Remove="Resources\dotnet-hosting-10.exe" />
    <None Remove="Resources\License.rtf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.Web.Administration" Version="11.1.0" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="10.0.15" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\dotnet-hosting-10.exe" />
    <EmbeddedResource Include="Resources\License.rtf" />
  </ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\Autoprint.Server.Setup\bin\x64\$(Configuration)\fr-FR\Autoprint.Server.Setup.msi">
			<Link>Resources\Autoprint.Server.Setup.msi</Link>
			<LogicalName>Autoprint.Installer.Server.UI.Resources.Autoprint.Server.Setup.msi</LogicalName>
			<Visible>false</Visible>
		</EmbeddedResource>
	</ItemGroup>

	<Target Name="BuildServerMsi" BeforeTargets="BeforeBuild" Condition="'$(SkipBuildServerMsi)' != 'true'">
		<Message Text="📦 Génération automatique du MSI Serveur..." Importance="high" />
		<MSBuild Projects="..\Autoprint.Server.Setup\Autoprint.Server.Setup.wixproj" Properties="Configuration=$(Configuration);Platform=x64" Targets="Build" />
	</Target>
	
</Project>
