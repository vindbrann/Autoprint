<Project Sdk="WixToolset.Sdk/7.0.1">
  <!-- Contrat OSMF de WiX 7 accepté par le propriétaire du projet le 11/11/2026 (redevance seulement au-delà de 10 000 $ de revenus annuels
       tirés des projets qui utilisent WiX ; voir Docs/projet/POLITIQUE_VERSIONS.md). Porte de sortie : WiX compilé depuis ses sources (MS-RL). -->
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>
	<PropertyGroup>
		<Platform>x64</Platform>
		<Cultures>fr-FR</Cultures>
		<DefineConstants>ExeSource=..\Executables;AppVersion=$(Version)</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.UI.wixext" Version="7.0.1" />
		<PackageReference Include="WixToolset.Firewall.wixext" Version="7.0.1" />
		<PackageReference Include="WixToolset.Util.wixext" Version="7.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Autoprint.Client\Autoprint.Client.csproj" />
	</ItemGroup>

	<Target Name="PrepareFiles" BeforeTargets="BeforeBuild">
		<MakeDir Directories="..\Executables" />
		<Exec Command="dotnet publish &quot;..\Autoprint.Client\Autoprint.Client.csproj&quot; -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o &quot;..\Executables&quot;" />
	</Target>
</Project>