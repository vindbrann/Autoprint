@page "/snmp-credentials"
@using Autoprint.Shared
@using Autoprint.Shared.DTOs
@using Autoprint.Web.Services
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject CustomAuthStateProvider AuthProvider

<PageTitle>Identifiants SNMP</PageTitle>

<div class="ap-page-header">
    <div class="ap-titles"><h1>Identifiants SNMP</h1></div>
    <span class="ap-grow"></span>
    @if (canWrite)
    {
        <RadzenButton Icon="add" Text="Nouveaux identifiants" ButtonStyle="ButtonStyle.Primary" Click="@(() => OuvrirModal(null))" />
    }
</div>

@if (messageErreur != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Icon="lock" Variant="Variant.Flat" Shade="Shade.Lighter">@messageErreur</RadzenAlert>
}
else if (credentials == null)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-tertiary-color); margin-bottom: 1.5rem;">
        Un profil d'identifiants (communauté v1 / v2c ou utilisateur SNMPv3) s'attribue à un <strong>modèle</strong> d'imprimante :
        toutes ses imprimantes l'utilisent par défaut. Une imprimante peut en choisir un autre dans sa fiche (cas particuliers).
        Les mots de passe et communautés sont chiffrés et ne sont jamais réaffichés.
    </RadzenText>

    <div class="ap-grid-wrap"><RadzenDataGrid Data="@credentials" TItem="SnmpCredentialViewDto" AllowSorting="true" AllowPaging="true" PageSize="15"
                        AllowFiltering="true" FilterMode="FilterMode.Advanced" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <Columns>
            <RadzenDataGridColumn TItem="SnmpCredentialViewDto" Property="Name" Title="Nom" Width="220px" />
            <RadzenDataGridColumn TItem="SnmpCredentialViewDto" Property="Version" Title="Version" Width="110px" FilterMode="FilterMode.CheckBoxList">
                <Template Context="c">
                    <RadzenBadge BadgeStyle="@(c.Version == 3 ? BadgeStyle.Success : BadgeStyle.Warning)" Text="@(c.Version == 3 ? "v3" : c.Version == 1 ? "v1" : "v2c")" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SnmpCredentialViewDto" Property="V3Username" Title="Détails">
                <Template Context="c">
                    @if (c.Version == 3)
                    {
                        <span>Utilisateur « @c.V3Username » · @Niveau(c.V3SecurityLevel)
                            @if (c.V3SecurityLevel != SnmpV3SecurityLevel.NoAuthNoPriv) { <text> · @c.V3AuthProtocol.ToString().ToUpper()</text> }
                            @if (c.V3SecurityLevel == SnmpV3SecurityLevel.AuthPriv) { <text> / @c.V3PrivProtocol.ToString().ToUpper()</text> }
                        </span>
                    }
                    else
                    {
                        <span style="color: var(--rz-text-tertiary-color);">Communauté enregistrée (masquée)</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SnmpCredentialViewDto" Property="PrinterCount" Title="Utilisé par" Width="200px">
                <Template Context="c">@c.ModelCount modèle(s), @c.PrinterCount imprimante(s) en direct</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SnmpCredentialViewDto" Title="Actions" Width="130px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                <Template Context="c">
                    @if (canWrite)
                    {
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => OuvrirModal(c))" Tooltip="Modifier" />
                    }
                    @if (canDelete)
                    {
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => Supprimer(c))" Tooltip="Supprimer" />
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid></div>
}

@code {
    private List<SnmpCredentialViewDto>? credentials;
    private string? messageErreur;
    private bool canWrite;
    private bool canDelete;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthProvider.HasPermission("Permission", "SNMP_PROFILE_READ"))
        {
            messageErreur = "Vous n'avez pas l'autorisation de consulter les identifiants SNMP.";
            return;
        }
        canWrite = await AuthProvider.HasPermission("Permission", "SNMP_PROFILE_WRITE");
        canDelete = await AuthProvider.HasPermission("Permission", "SNMP_PROFILE_DELETE");
        await Charger();
    }

    private async Task Charger()
    {
        try { credentials = await Http.GetFromJsonAsync<List<SnmpCredentialViewDto>>("api/SnmpCredentials") ?? new(); }
        catch (Exception ex) { messageErreur = "Erreur de chargement : " + ex.Message; }
    }

    private static string Niveau(SnmpV3SecurityLevel level) => level switch
    {
        SnmpV3SecurityLevel.NoAuthNoPriv => "sans authentification (déconseillé)",
        SnmpV3SecurityLevel.AuthNoPriv => "authentification",
        _ => "authentification + chiffrement"
    };

    private async Task OuvrirModal(SnmpCredentialViewDto? existing)
    {
        var result = await DialogService.OpenAsync<SnmpCredentialModal>(existing == null ? "Nouveaux identifiants SNMP" : $"Identifiants : {existing.Name}",
            new Dictionary<string, object?> { { "Existing", existing } },
            new DialogOptions { Width = "600px" });
        if (result is true) await Charger();
    }

    private async Task Supprimer(SnmpCredentialViewDto c)
    {
        var ok = await DialogService.Confirm(
            $"Supprimer « {c.Name} » ? Les {c.ModelCount} modèle(s) et {c.PrinterCount} imprimante(s) qui l'utilisent reviendront à leurs paramètres par défaut.",
            "Suppression", new ConfirmOptions { OkButtonText = "Supprimer", CancelButtonText = "Annuler" });
        if (ok != true) return;

        var response = await Http.DeleteAsync($"api/SnmpCredentials/{c.Id}");
        if (response.IsSuccessStatusCode)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Supprimé", $"Profil « {c.Name} » supprimé.");
            await Charger();
        }
        else NotificationService.Notify(NotificationSeverity.Error, "Erreur", await response.Content.ReadAsStringAsync());
    }
}
