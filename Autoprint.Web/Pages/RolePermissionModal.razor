@using Autoprint.Shared.DTOs
@using Autoprint.Web.Services
@using Radzen
@using Radzen.Blazor
@inject IRoleService RoleService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<RadzenTemplateForm TItem="RoleEditDto" Data="@roleEdit" Submit="@OnSubmit">
    <RadzenStack Gap="1rem" Style="height: 100%;">
        @* Backlog B21 : conséquence de l'enregistrement sur les sessions *@
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Size="AlertSize.Small" AllowClose="false">
            Enregistrer ce rôle ferme les sessions ouvertes de tous ses membres : ils devront se reconnecter pour obtenir leurs nouveaux droits.
            Si vous êtes vous-même membre de ce rôle, vous serez déconnecté.
        </RadzenAlert>

        <RadzenCard Variant="Variant.Outlined" Class="rz-p-3">
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="Nom du Rôle" Component="Name" />
                    <RadzenTextBox Name="Name" @bind-Value="@roleEdit.Name" Style="width: 100%;"
                                   Disabled="@isSuperAdmin" />
                    <RadzenRequiredValidator Component="Name" Text="Nom requis" Popup="true" />
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenLabel Text="Description" Component="Desc" />
                    <RadzenTextBox Name="Desc" @bind-Value="@roleEdit.Description" Style="width: 100%;" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" Size="AlertSize.Small">
            Cochez les cases pour accorder les permissions. « Administration » donne tous les droits et ne peut être accordée que par un administrateur ;
            « Système » (paramètres du serveur, dont l'Active Directory) ne peut être accordé que par un compte qui l'a déjà.
            « Rôles - écriture » permet de créer, modifier et supprimer des rôles.
        </RadzenAlert>

        <RadzenDataGrid Data="@ModuleRows" TItem="ModulePermissionRow" AllowSorting="false" Density="Density.Compact"
                        Style="height: 400px; border: 1px solid var(--rz-border-color);">
            <Columns>

                <RadzenDataGridColumn TItem="ModulePermissionRow" Property="Title" Title="Module" Width="150px">
                    <Template Context="m">
                        <span style="font-weight: bold; color: var(--rz-primary);">@m.Title</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ModulePermissionRow" Title="Lecture" Width="80px" TextAlign="TextAlign.Center">
                    <Template Context="m">
                        @if (m.ReadId > 0)
                        {
                            <RadzenCheckBox TValue="bool" Value="@roleEdit.PermissionIds.Contains(m.ReadId)"
                                            Change="@(args => TogglePermission(m.ReadId, args))" TriState="false" Disabled="@IsLocked(m.ReadId)" />
                        }
                        else
                        {
                            <span style="color: var(--rz-text-disabled-color);">-</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ModulePermissionRow" Title="Écriture" Width="80px" TextAlign="TextAlign.Center">
                    <Template Context="m">
                        @if (m.WriteId > 0)
                        {
                            <RadzenCheckBox TValue="bool" Value="@roleEdit.PermissionIds.Contains(m.WriteId)"
                                            Change="@(args => TogglePermission(m.WriteId, args))" TriState="false" Disabled="@IsLocked(m.WriteId)" />
                        }
                        else
                        {
                            <span style="color: var(--rz-text-disabled-color);">-</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ModulePermissionRow" Title="Suppr." Width="80px" TextAlign="TextAlign.Center">
                    <Template Context="m">
                        @if (m.DeleteId > 0)
                        {
                            <RadzenCheckBox TValue="bool" Value="@roleEdit.PermissionIds.Contains(m.DeleteId)"
                                            Change="@(args => TogglePermission(m.DeleteId, args))" TriState="false" Disabled="@IsLocked(m.DeleteId)" />
                        }
                        else
                        {
                            <span style="color: var(--rz-text-disabled-color);">-</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ModulePermissionRow" Title="Options Avancées">
                    <Template Context="m">
                        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                            @foreach (var perm in m.Others)
                            {
                                <div style="display: flex; align-items: center; gap: 4px;">
                                    <RadzenCheckBox TValue="bool" Value="@roleEdit.PermissionIds.Contains(perm.Id)"
                                                    Change="@(args => TogglePermission(perm.Id, args))" TriState="false" Disabled="@IsLocked(perm.Id)" />
                                    <span style="font-size: 0.85em;">@perm.Description.Replace(m.Title, "").Trim()</span>
                                </div>
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>

        <RadzenStack Class="ap-dlg-footer" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem">
            <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => DialogService.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Enregistrer" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>

    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public int RoleId { get; set; }
    [Parameter] public List<PermissionDto> AllPermissions { get; set; } = new();

    private RoleEditDto roleEdit = new();
    private bool isSuperAdmin = false;
    private List<ModulePermissionRow> ModuleRows = new();

    public class ModulePermissionRow
    {
        public string Title { get; set; } = "";
        public string Prefix { get; set; } = "";
        public int ReadId { get; set; }
        public int WriteId { get; set; }
        public int DeleteId { get; set; }
        public List<PermissionDto> Others { get; set; } = new();
    }

    private HashSet<string> callerPermissions = new(StringComparer.OrdinalIgnoreCase);

    // Même règle que le serveur (PermissionGuard.CanGrant) : la case est grisée si le serveur refuserait la modification
    private bool IsLocked(int permissionId)
    {
        var code = AllPermissions.FirstOrDefault(p => p.Id == permissionId)?.Code;
        return code != null && !Autoprint.Shared.PermissionRules.CanGrant(callerPermissions, code);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        callerPermissions = authState.User.Claims.Where(c => c.Type == "Permission").Select(c => c.Value)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (RoleId != 0)
        {
            roleEdit = await RoleService.GetRoleForEdit(RoleId);
            isSuperAdmin = (roleEdit.Name == "SuperAdmin");
        }

        BuildMatrix();
    }

    private void BuildMatrix()
    {
        var groups = new List<(string Prefix, string Title)>
        {
            ("PRINTER", "Imprimantes"), ("LOCATION", "Lieux"), ("BRAND", "Marques"),
            ("MODEL", "Modèles"), ("DRIVER", "Pilotes"), ("USER", "Utilisateurs"),
            ("ROLE", "Rôles"), ("SETTINGS", "Système"), ("AUDIT", "Audit"),
            ("SNMP_PROFILE", "Profils SNMP"), ("ADMIN", "Administration")
        };
        ModuleRows = new List<ModulePermissionRow>();

        foreach (var g in groups)
        {
            var row = new ModulePermissionRow { Title = g.Title, Prefix = g.Prefix };
            row.ReadId = AllPermissions.FirstOrDefault(p => p.Code == $"{g.Prefix}_READ")?.Id ?? 0;
            row.WriteId = AllPermissions.FirstOrDefault(p => p.Code == $"{g.Prefix}_WRITE")?.Id ?? 0;
            row.DeleteId = AllPermissions.FirstOrDefault(p => p.Code == $"{g.Prefix}_DELETE")?.Id ?? 0;
            row.Others = AllPermissions
                .Where(p => p.Code.StartsWith(g.Prefix + "_")
                            && !p.Code.EndsWith("_READ")
                            && !p.Code.EndsWith("_WRITE")
                            && !p.Code.EndsWith("_DELETE")
                            && p.Code != "PRINTER_ARCHIVE")
                .ToList();
            ModuleRows.Add(row);
        }

        // Ligne dédiée à l'Archivage
        var archivePerm = AllPermissions.FirstOrDefault(p => p.Code == "PRINTER_ARCHIVE");
        if (archivePerm != null)
        {
            var archiveRow = new ModulePermissionRow 
            { 
                Title = "Archivage", 
                Prefix = "PRINTER_ARCHIVE",
                Others = new List<PermissionDto> { archivePerm }
            };
            ModuleRows.Add(archiveRow);
        }

        // Ligne dédiée aux Rapports & Planification
        var reportPerm = AllPermissions.FirstOrDefault(p => p.Code == "REPORT_MANAGE");
        if (reportPerm != null)
        {
            var reportRow = new ModulePermissionRow 
            { 
                Title = "Rapports & Plannif.", 
                Prefix = "REPORT",
                Others = new List<PermissionDto> { reportPerm }
            };
            ModuleRows.Add(reportRow);
        }

        // Ligne dédiée au Scan Réseau & Découverte
        var networkScanPerm = AllPermissions.FirstOrDefault(p => p.Code == "NETWORK_SCAN");
        if (networkScanPerm != null)
        {
            var scanRow = new ModulePermissionRow 
            { 
                Title = "Scan Réseau", 
                Prefix = "NETWORK_SCAN",
                Others = new List<PermissionDto> { networkScanPerm }
            };
            ModuleRows.Add(scanRow);
        }
    }

    private void TogglePermission(int permId, bool value)
    {
        if (value)
        {
            if (!roleEdit.PermissionIds.Contains(permId)) roleEdit.PermissionIds.Add(permId);
        }
        else
        {
            roleEdit.PermissionIds.Remove(permId);
        }
    }

    private async Task OnSubmit(RoleEditDto args)
    {
        try
        {
            if (RoleId == 0) await RoleService.CreateRole(roleEdit);
            else await RoleService.UpdateRole(RoleId, roleEdit);

            NotificationService.Notify(NotificationSeverity.Success, "Succès", "Rôle enregistré.");
            DialogService.Close(true);
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message); }
    }
}