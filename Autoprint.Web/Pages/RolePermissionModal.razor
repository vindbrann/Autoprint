@using Autoprint.Shared.DTOs
@using Autoprint.Web.Services
@using Radzen
@using Radzen.Blazor
@inject IRoleService RoleService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

@* Maquette « modales » (retour de recette du 11/11) : en-tête sans cadre, matrice des droits sans bandeaux superflus,
   conséquence de l'enregistrement rappelée près du bouton *@
<RadzenTemplateForm TItem="RoleEditDto" Data="@roleEdit" Submit="@OnSubmit">
    <div class="ap-dlg">
        <div class="ap-dlg-group" style="padding-top: 0;">
            <h3>Rôle</h3>
            <div class="ap-dlg-grid" style="grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);">
                <div class="ap-field">
                    <RadzenLabel Text="Nom" Component="Name" />
                    <RadzenTextBox Name="Name" @bind-Value="@roleEdit.Name" Style="width: 100%;" Disabled="@isSuperAdmin" Placeholder="Helpdesk" />
                    <RadzenRequiredValidator Component="Name" Text="Saisissez le nom du rôle" Popup="true" />
                </div>
                <div class="ap-field">
                    <RadzenLabel Component="Desc"><ChildContent>Description <span class="ap-opt">(facultatif)</span></ChildContent></RadzenLabel>
                    <RadzenTextBox Name="Desc" @bind-Value="@roleEdit.Description" Style="width: 100%;" Placeholder="Support de proximité : imprimantes et comptes" />
                </div>
            </div>
        </div>

        <div class="ap-dlg-group">
            <h3>Droits</h3>
            <p class="ap-dlg-lead" style="margin: 0;">« Administration » donne tous les droits et ne peut être accordée que par un administrateur ; « Système » (paramètres du serveur, dont l'Active Directory) ne peut être accordé que par un compte qui l'a déjà.</p>
            <div class="ap-grid-wrap">
                <RadzenDataGrid Data="@ModuleRows" TItem="ModulePermissionRow" AllowSorting="false" Density="Density.Compact" Style="max-height: 420px;">
                    <Columns>
                        <RadzenDataGridColumn TItem="ModulePermissionRow" Property="Title" Title="Module" Width="160px">
                            <Template Context="m"><span style="font-weight: 500;">@m.Title</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ModulePermissionRow" Title="Lecture" Width="84px" TextAlign="TextAlign.Center">
                            <Template Context="m">
                                @if (m.ReadId > 0)
                                {
                                    <RadzenCheckBox TValue="bool" Value="@roleEdit.PermissionIds.Contains(m.ReadId)" Change="@(args => TogglePermission(m.ReadId, args))" TriState="false" Disabled="@IsLocked(m.ReadId)" InputAttributes="@(new Dictionary<string, object> { { "aria-label", $"{m.Title} : lecture" } })" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ModulePermissionRow" Title="Écriture" Width="84px" TextAlign="TextAlign.Center">
                            <Template Context="m">
                                @if (m.WriteId > 0)
                                {
                                    <RadzenCheckBox TValue="bool" Value="@roleEdit.PermissionIds.Contains(m.WriteId)" Change="@(args => TogglePermission(m.WriteId, args))" TriState="false" Disabled="@IsLocked(m.WriteId)" InputAttributes="@(new Dictionary<string, object> { { "aria-label", $"{m.Title} : écriture" } })" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ModulePermissionRow" Title="Suppression" Width="104px" TextAlign="TextAlign.Center">
                            <Template Context="m">
                                @if (m.DeleteId > 0)
                                {
                                    <RadzenCheckBox TValue="bool" Value="@roleEdit.PermissionIds.Contains(m.DeleteId)" Change="@(args => TogglePermission(m.DeleteId, args))" TriState="false" Disabled="@IsLocked(m.DeleteId)" InputAttributes="@(new Dictionary<string, object> { { "aria-label", $"{m.Title} : suppression" } })" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ModulePermissionRow" Title="Autres droits">
                            <Template Context="m">
                                <div style="display: flex; gap: 6px 14px; flex-wrap: wrap;">
                                    @foreach (var perm in m.Others)
                                    {
                                        <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                                            <RadzenCheckBox TValue="bool" Value="@roleEdit.PermissionIds.Contains(perm.Id)" Change="@(args => TogglePermission(perm.Id, args))" TriState="false" Disabled="@IsLocked(perm.Id)" />
                                            <span style="font-size: 13px;">@perm.Description.Replace(m.Title, "").Trim()</span>
                                        </label>
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>

        <div class="ap-dlg-footer">
            @* Backlog B21 : conséquence de l'enregistrement sur les sessions, rappelée au moment d'enregistrer *@
            <span class="ap-help">Les membres de ce rôle seront déconnectés pour recevoir leurs nouveaux droits (vous aussi si vous en faites partie)</span>
            <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => DialogService.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(RoleId == 0 ? "Créer le rôle" : "Enregistrer les modifications")" ButtonStyle="ButtonStyle.Primary" />
        </div>
    </div>
</RadzenTemplateForm>

@code {
    [Parameter] public int RoleId { get; set; }
    [Parameter] public List<PermissionDto> AllPermissions { get; set; } = new();

    private RoleEditDto roleEdit = new();
    private bool isSuperAdmin = false;
    private List<ModulePermissionRow> ModuleRows = new();

    public class ModulePermissionRow
    {
        public string Title { get; set; } = "";
        public string Prefix { get; set; } = "";
        public int ReadId { get; set; }
        public int WriteId { get; set; }
        public int DeleteId { get; set; }
        public List<PermissionDto> Others { get; set; } = new();
    }

    private HashSet<string> callerPermissions = new(StringComparer.OrdinalIgnoreCase);

    // Même règle que le serveur (PermissionGuard.CanGrant) : la case est grisée si le serveur refuserait la modification
    private bool IsLocked(int permissionId)
    {
        var code = AllPermissions.FirstOrDefault(p => p.Id == permissionId)?.Code;
        return code != null && !Autoprint.Shared.PermissionRules.CanGrant(callerPermissions, code);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        callerPermissions = authState.User.Claims.Where(c => c.Type == "Permission").Select(c => c.Value)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (RoleId != 0)
        {
            roleEdit = await RoleService.GetRoleForEdit(RoleId);
            isSuperAdmin = (roleEdit.Name == "SuperAdmin");
        }

        BuildMatrix();
    }

    private void BuildMatrix()
    {
        var groups = new List<(string Prefix, string Title)>
        {
            ("PRINTER", "Imprimantes"), ("LOCATION", "Lieux"), ("BRAND", "Marques"),
            ("MODEL", "Modèles"), ("DRIVER", "Pilotes"), ("USER", "Utilisateurs"),
            ("ROLE", "Rôles"), ("SETTINGS", "Système"), ("AUDIT", "Audit"),
            ("SNMP_PROFILE", "Profils SNMP"), ("ADMIN", "Administration")
        };
        ModuleRows = new List<ModulePermissionRow>();

        foreach (var g in groups)
        {
            var row = new ModulePermissionRow { Title = g.Title, Prefix = g.Prefix };
            row.ReadId = AllPermissions.FirstOrDefault(p => p.Code == $"{g.Prefix}_READ")?.Id ?? 0;
            row.WriteId = AllPermissions.FirstOrDefault(p => p.Code == $"{g.Prefix}_WRITE")?.Id ?? 0;
            row.DeleteId = AllPermissions.FirstOrDefault(p => p.Code == $"{g.Prefix}_DELETE")?.Id ?? 0;
            row.Others = AllPermissions
                .Where(p => p.Code.StartsWith(g.Prefix + "_")
                            && !p.Code.EndsWith("_READ")
                            && !p.Code.EndsWith("_WRITE")
                            && !p.Code.EndsWith("_DELETE")
                            && p.Code != "PRINTER_ARCHIVE")
                .ToList();
            ModuleRows.Add(row);
        }

        // Ligne dédiée à l'Archivage
        var archivePerm = AllPermissions.FirstOrDefault(p => p.Code == "PRINTER_ARCHIVE");
        if (archivePerm != null)
        {
            var archiveRow = new ModulePermissionRow 
            { 
                Title = "Archivage", 
                Prefix = "PRINTER_ARCHIVE",
                Others = new List<PermissionDto> { archivePerm }
            };
            ModuleRows.Add(archiveRow);
        }

        // Ligne dédiée aux Rapports & Planification
        var reportPerm = AllPermissions.FirstOrDefault(p => p.Code == "REPORT_MANAGE");
        if (reportPerm != null)
        {
            var reportRow = new ModulePermissionRow 
            { 
                Title = "Rapports & Plannif.", 
                Prefix = "REPORT",
                Others = new List<PermissionDto> { reportPerm }
            };
            ModuleRows.Add(reportRow);
        }

        // Ligne dédiée au Scan Réseau & Découverte
        var networkScanPerm = AllPermissions.FirstOrDefault(p => p.Code == "NETWORK_SCAN");
        if (networkScanPerm != null)
        {
            var scanRow = new ModulePermissionRow 
            { 
                Title = "Scan Réseau", 
                Prefix = "NETWORK_SCAN",
                Others = new List<PermissionDto> { networkScanPerm }
            };
            ModuleRows.Add(scanRow);
        }
    }

    private void TogglePermission(int permId, bool value)
    {
        if (value)
        {
            if (!roleEdit.PermissionIds.Contains(permId)) roleEdit.PermissionIds.Add(permId);
        }
        else
        {
            roleEdit.PermissionIds.Remove(permId);
        }
    }

    private async Task OnSubmit(RoleEditDto args)
    {
        try
        {
            if (RoleId == 0) await RoleService.CreateRole(roleEdit);
            else await RoleService.UpdateRole(RoleId, roleEdit);

            NotificationService.Notify(NotificationSeverity.Success, "Succès", "Rôle enregistré.");
            DialogService.Close(true);
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message); }
    }
}