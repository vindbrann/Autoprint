@page "/imprimantes"
@using Autoprint.Shared
@using Autoprint.Shared.DTOs
@using Autoprint.Shared.Enums
@using Autoprint.Web.Services
@using Radzen
@using Radzen.Blazor
@using System.Text
@inject HttpClient Http
@inject CustomAuthStateProvider AuthProvider
@inject ISyncService SyncService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject ILocalStorageService LocalStorage

<PageTitle>Imprimantes</PageTitle>

@* Charte B77, maquette « Imprimantes » : en-tête, onglets, grille dans une carte avec recherche, filtres en pastilles
   et actions groupées sur la sélection ; statut unique (couleur + icône + texte) ; lieu et détail sur deux lignes. *@
<div class="ap-page-header">
    <div class="ap-titles">
        <h1>Parc d'imprimantes</h1>
        @if (imprimantes != null)
        {
            <span class="ap-sub">@ActiveCount active@(ActiveCount > 1 ? "s" : "") · @ArchivedCount archivée@(ArchivedCount > 1 ? "s" : "")</span>
        }
    </div>
    <span class="ap-grow"></span>
    <RadzenButton Icon="download" Text="Exporter en CSV" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Click="@ExporterEnCsv" Disabled="@(imprimantes == null || !imprimantes.Any())" />
    <AuthorizeView Policy="PRINTER_SYNC">
        <Authorized>
            <RadzenButton Icon="fact_check" Text="Audit serveur" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Click="@AuditerServeur" IsBusy="@isAuditing" BusyText="Audit…" />
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="PRINTER_WRITE">
        <Authorized Context="authContext">
            <RadzenButton Icon="radar" Text="Scanner le réseau" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="OuvrirScanModal" />
            <RadzenButton Icon="add" Text="Ajouter" ButtonStyle="ButtonStyle.Primary" Click="@(() => OuvrirModal(new Imprimante { ModeleId = 0, EmplacementId = 0, Status = PrinterStatus.PendingCreation, IsDirectPrintingEnabled = _defaultDirectMode, EstPartagee = _defaultShare }))" />
        </Authorized>
    </AuthorizeView>
</div>

@if (imprimantes != null)
{
    var toCreate = imprimantes.Count(i => i.Status == PrinterStatus.PendingCreation);
    var toUpdate = imprimantes.Count(i => i.Status == PrinterStatus.PendingUpdate);
    var toDelete = imprimantes.Count(i => i.Status == PrinterStatus.PendingDelete);
    var errors = imprimantes.Count(i => i.Status == PrinterStatus.SyncError);
    var totalPending = toCreate + toUpdate + toDelete;

    @if (errors > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Icon="error" AllowClose="false" Variant="Variant.Flat" Shade="Shade.Lighter" Style="margin-bottom: var(--ap-s4);">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <span>@errors erreur@(errors > 1 ? "s" : "") de synchronisation.</span>
                <AuthorizeView Policy="PRINTER_SYNC">
                    <RadzenButton Text="Réessayer la synchronisation" Icon="sync_problem" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="ApplyChanges" Disabled="@isSyncing" />
                </AuthorizeView>
            </RadzenStack>
        </RadzenAlert>
    }
    else if (totalPending > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Icon="sync" AllowClose="false" Variant="Variant.Flat" Shade="Shade.Lighter" Style="margin-bottom: var(--ap-s4);">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <span>
                    Modifications en attente de synchronisation :
                    @if (toCreate > 0) { <span class="ap-tag">@toCreate création@(toCreate > 1 ? "s" : "")</span> }
                    @if (toUpdate > 0) { <span class="ap-tag">@toUpdate mise@(toUpdate > 1 ? "s" : "") à jour</span> }
                    @if (toDelete > 0) { <span class="ap-tag">@toDelete suppression@(toDelete > 1 ? "s" : "")</span> }
                </span>
                <AuthorizeView Policy="PRINTER_SYNC">
                    <RadzenButton Text="Synchroniser maintenant" Icon="sync" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="ApplyChanges" IsBusy="@isSyncing" BusyText="Analyse…" />
                </AuthorizeView>
            </RadzenStack>
        </RadzenAlert>
    }
}

@if (syncResult != null)
{
    <RadzenAlert AlertStyle="@(syncResult.Success ? AlertStyle.Success : AlertStyle.Danger)" AllowClose="true" Variant="Variant.Flat" Shade="Shade.Lighter" Style="margin-bottom: var(--ap-s4);">
        <strong>@(syncResult.Success ? "Opération terminée" : "Erreur")</strong>
        <ul style="margin: 0; padding-left: 1rem;">
            @foreach (var msg in syncResult.Messages)
            {
                <li>@msg</li>
            }
        </ul>
    </RadzenAlert>
}

<div class="ap-tabs" role="tablist">
    <button class="@(selectedTab == 0 ? "ap-tab is-active" : "ap-tab")" role="tab" aria-selected="@(selectedTab == 0)" @onclick="@(() => OnTabChanged(0))">
        Parc actif <span class="ap-tab-count">@ActiveCount</span>
    </button>
    <button class="@(selectedTab == 1 ? "ap-tab is-active" : "ap-tab")" role="tab" aria-selected="@(selectedTab == 1)" @onclick="@(() => OnTabChanged(1))">
        Archives, inactives depuis 30 jours <span class="ap-tab-count">@ArchivedCount</span>
    </button>
</div>

@if (isLoading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <div class="ap-grid-wrap">
        @if (isSyncing || isAuditing)
        {
            <div class="ap-busy-overlay">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                <strong>@(isAuditing ? "Audit du serveur en cours…" : "Synchronisation en cours…")</strong>
                <span class="ap-caption">Cette opération peut prendre quelques instants.</span>
            </div>
        }

        @* Filtres dans les en-têtes de colonnes, comme toutes les grilles (plus de recherche ni de pastille « Statut » au-dessus) *@
        @if (selected?.Any() == true)
        {
        <div class="ap-toolbar">
            <span class="ap-grow"></span>
            <span class="ap-selection">
                <span class="ap-caption">@selected.Count sélectionnée@(selected.Count > 1 ? "s" : "")</span>
                <AuthorizeView Policy="PRINTER_SYNC">
                    <RadzenButton Icon="sync" Text="Synchroniser" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="SynchroniserSelection" Disabled="@isSyncing" />
                </AuthorizeView>
                <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@(() => selected = null)" title="Effacer la sélection" aria-label="Effacer la sélection" />
            </span>
        </div>
        }

        <RadzenDataGrid @ref="grid" Data="@imprimantesFiltrees" TItem="Imprimante"
                        AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
                        AllowSorting="true" AllowColumnResize="true" AllowColumnPicking="true"
                        AllowFiltering="true" FilterMode="FilterMode.Advanced" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        SelectionMode="DataGridSelectionMode.Multiple" @bind-Value="@selected" AllowRowSelectOnRowClick="false"
                        @bind-Settings="gridSettings" EmptyText="Aucune imprimante" Style="width: 100%;">
            <Columns>
                <RadzenDataGridColumn TItem="Imprimante" Width="44px" Sortable="false" Filterable="false" Pickable="false" Resizable="false" TextAlign="TextAlign.Center">
                    <HeaderTemplate>
                        <RadzenCheckBox TriState="false" TValue="bool" Value="@AllVisibleSelected" Change="@(v => ToggleAll(v))" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Tout sélectionner" } })" />
                    </HeaderTemplate>
                    <Template Context="imp">
                        <RadzenCheckBox TriState="false" TValue="bool" Value="@(selected?.Contains(imp) == true)" Change="@(_ => grid.SelectRow(imp))" InputAttributes="@(new Dictionary<string, object> { { "aria-label", $"Sélectionner {imp.NomAffiche}" } })" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Imprimante" Property="NomAffiche" Title="Nom" MinWidth="140px" Width="220px">
                    <Template Context="imp">
                        <strong style="font-weight: 500;">@imp.NomAffiche</strong>
                        @if (imp.Status == PrinterStatus.SyncError && !string.IsNullOrEmpty(imp.Commentaire))
                        {
                            <span class="ap-cell-sub" style="color: var(--ap-danger);">@imp.Commentaire</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                @* Statut calculé (synchronisation + supervision) : la grille ne sait pas le filtrer, d'où un filtre d'en-tête
                   personnalisé (cases à cocher, comme Lieu ou Modèle) appliqué aux données avant la grille *@
                <RadzenDataGridColumn TItem="Imprimante" Property="Status" Title="Statut" Width="170px" SortProperty="Status">
                    <FilterTemplate>
                        <div class="ap-status-filter" role="group" aria-label="Filtrer par statut">
                            @foreach (var opt in statutOptions)
                            {
                                bool coche = filtresStatut.Contains(opt.Value);
                                <label class="ap-status-filter-item">
                                    <RadzenCheckBox TValue="bool" Value="@coche" Change="@(v => BasculerStatut(opt.Value, v))" />
                                    <span>@opt.Text</span>
                                </label>
                            }
                            @if (filtresStatut.Count > 0)
                            {
                                <RadzenButton Text="Effacer" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => { filtresStatut.Clear(); AppliquerFiltres(); })" />
                            }
                        </div>
                    </FilterTemplate>
                    <Template Context="imp">
                        @{ var st = Statut(imp); }
                        <span class="@($"ap-status-badge ap-status-badge--{st.Css}")" title="@st.Detail"><RadzenIcon Icon="@st.Icon" />@st.Text</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Imprimante" Property="Emplacement.Nom" Title="Lieu" MinWidth="140px" Width="230px" FilterMode="FilterMode.CheckBoxList">
                    <Template Context="imp">
                        <span class="ap-place"><RadzenIcon Icon="location_on" />@(imp.Emplacement?.Nom ?? "—")</span>
                        @if (!string.IsNullOrEmpty(imp.Localisation))
                        {
                            <span class="ap-cell-sub">@imp.Localisation</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Imprimante" Property="Modele.Nom" Title="Modèle" MinWidth="120px" Width="200px" FilterMode="FilterMode.CheckBoxList">
                    <Template Context="imp">@NomModele(imp)</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Imprimante" Property="AdresseIp" Title="Adresse IP" Width="140px">
                    <Template Context="imp">
                        @if (!string.IsNullOrEmpty(imp.AdresseIp)) { <span class="ap-label-tag">@imp.AdresseIp</span> }
                    </Template>
                </RadzenDataGridColumn>

                @* Colonnes facultatives, à afficher par le choix des colonnes *@
                <RadzenDataGridColumn TItem="Imprimante" Property="Code" Title="Code inventaire" Width="140px" Visible="false">
                    <Template Context="imp">
                        @if (!string.IsNullOrEmpty(imp.Code)) { <span class="ap-label-tag">@imp.Code</span> }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Imprimante" Property="SerialNumber" Title="N° de série" Width="150px" Visible="false">
                    <Template Context="imp"><span class="ap-mono">@imp.SerialNumber</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Imprimante" Property="IsDirectPrintingEnabled" Title="Impression directe" Width="150px" Visible="false">
                    <Template Context="imp">@(imp.IsDirectPrintingEnabled ? "Oui (RAW)" : "Non")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Imprimante" Property="EstPartagee" Title="Partage Windows" Width="150px" Visible="false">
                    <Template Context="imp">@(imp.EstPartagee ? imp.NomPartage : "Non")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Imprimante" Property="LastSeen" Title="Vue le" Width="140px" Visible="false">
                    <Template Context="imp">@(imp.LastSeen?.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Imprimante" Title="Actions" Width="140px" Sortable="false" Filterable="false" Pickable="false" Resizable="false" TextAlign="TextAlign.Center"
                                      Frozen="true" FrozenPosition="FrozenColumnPosition.Right" CssClass="ap-col-actions" HeaderCssClass="ap-col-actions">
                    <Template Context="imp">
                        <span class="ap-row-actions">
                            <AuthorizeView Policy="PRINTER_WRITE">
                                <Authorized Context="auth">
                                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => OuvrirModal(imp))" title="Modifier" aria-label="@($"Modifier {imp.NomAffiche}")" />
                                </Authorized>
                            </AuthorizeView>
                            <RadzenButton Icon="stethoscope" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => OuvrirDiagnosticModal(imp))" title="Diagnostic" aria-label="@($"Diagnostic {imp.NomAffiche}")" />
                            <AuthorizeView Policy="PRINTER_ARCHIVE">
                                <Authorized Context="archiveAuth">
                                    <RadzenButton Icon="@(imp.IsArchived ? "unarchive" : "archive")" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => ToggleArchive(imp))"
                                                  title="@(imp.IsArchived ? "Restaurer" : "Archiver")" aria-label="@($"{(imp.IsArchived ? "Restaurer" : "Archiver")} {imp.NomAffiche}")" />
                                </Authorized>
                            </AuthorizeView>
                        </span>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
}
@code {
    RadzenDataGrid<Imprimante> grid = default!;
    private DataGridSettings? _gridSettings;
    private DataGridSettings? gridSettings
    {
        get => _gridSettings;
        set
        {
            _gridSettings = value;
            if (value != null)
            {
                _ = SaveSettingsAsync(value);
            }
        }
    }

    private List<Imprimante>? imprimantes;
    private List<Imprimante> imprimantesFiltrees = new();
    private int selectedTab = 0;
    private const string GridSettingsKey = "PrintersGridSettings.v2"; // colonnes changées par la charte (B77) : anciens réglages ignorés
    private readonly HashSet<string> filtresStatut = new();
    private IList<Imprimante>? selected;
    private bool isLoading = true;
    private bool isSyncing = false;
    private bool isAuditing = false;
    private BatchResult? syncResult;
    private bool CanReadPrinters { get; set; }
    private bool _defaultDirectMode = false;
    private bool _defaultShare = false;

    protected override async Task OnInitializedAsync()
    {
        CanReadPrinters = await AuthProvider.HasPermission("Permission", "PRINTER_READ");
        if (CanReadPrinters)
        {
            try
            {
                var settings = await Http.GetFromJsonAsync<List<Autoprint.Shared.ServerSetting>>("api/Settings");
                var val = settings?.FirstOrDefault(s => s.Key == "Printer_DefaultDirectModeEnabled")?.Value;
                bool.TryParse(val, out _defaultDirectMode);
                var valShare = settings?.FirstOrDefault(s => s.Key == "NamingSameShare")?.Value;
                bool.TryParse(valShare, out _defaultShare);
            }
            catch {  }
            await ChargerListe();
        }

        else
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Accès refusé", "Vous n'avez pas les droits.");
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var settingsJson = await LocalStorage.GetItemAsync<string>(GridSettingsKey);
                if (!string.IsNullOrEmpty(settingsJson))
                {
                    _gridSettings = System.Text.Json.JsonSerializer.Deserialize<DataGridSettings>(settingsJson);
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task SaveSettingsAsync(DataGridSettings settings)
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(settings);
            await LocalStorage.SetItemAsync(GridSettingsKey, json);
        }
        catch { }
    }

    private async Task ChargerListe()
    {
        isLoading = true;
        try 
        { 
            string url = "api/Imprimantes?includeArchived=true"; // parc actif et archives ensemble : compteurs des onglets, filtrage côté navigateur
            imprimantes = await Http.GetFromJsonAsync<List<Imprimante>>(url); 
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message); }
        finally 
        { 
            isLoading = false;
            MettreAJourFiltre();
            if (grid != null)
            {
                await grid.Reload();
            }
            StateHasChanged();
        }
    }

    private Task OnTabChanged(int index)
    {
        selectedTab = index;
        selected = null;
        AppliquerFiltres();
        return Task.CompletedTask;
    }

    private void MettreAJourFiltre()
    {
        AppliquerFiltres();
    }

    // Onglet courant + filtre d'en-tête « Statut » (valeur calculée) ; les autres colonnes se filtrent dans la grille
    private void AppliquerFiltres()
    {
        IEnumerable<Imprimante> q = (imprimantes ?? new List<Imprimante>()).Where(i => i.IsArchived == (selectedTab == 1));
        if (filtresStatut.Count > 0) q = q.Where(i => filtresStatut.Contains(Statut(i).Key));
        imprimantesFiltrees = q.ToList();
        if (selected != null) selected = selected.Where(imprimantesFiltrees.Contains).ToList();
    }

    private void BasculerStatut(string key, bool coche)
    {
        if (coche) filtresStatut.Add(key); else filtresStatut.Remove(key);
        AppliquerFiltres();
    }

    private int ActiveCount => imprimantes?.Count(i => !i.IsArchived) ?? 0;
    private int ArchivedCount => imprimantes?.Count(i => i.IsArchived) ?? 0;

    private bool AllVisibleSelected => imprimantesFiltrees.Count > 0 && selected != null && imprimantesFiltrees.All(selected.Contains);
    private void ToggleAll(bool all) => selected = all ? imprimantesFiltrees.ToList() : null;

    private static string NomModele(Imprimante imp)
    {
        if (imp.Modele == null) return "";
        var marque = imp.Modele.Marque?.Nom;
        return string.IsNullOrWhiteSpace(marque) || marque == "NON DÉFINI" ? imp.Modele.Nom : $"{marque} {imp.Modele.Nom}";
    }

    // Statut unique : synchronisation d'abord (action requise), puis supervision ; couleur + icône + texte
    private sealed record PrinterState(string Key, string Text, string Css, string Icon, string? Detail);
    private PrinterState Statut(Imprimante imp) => imp.Status switch
    {
        PrinterStatus.SyncError => new("sync-error", "Erreur de synchro", "offline", "error", imp.Commentaire),
        PrinterStatus.PendingCreation => new("pending", "À créer", "info", "add_circle", "En attente de synchronisation"),
        PrinterStatus.PendingUpdate => new("pending", "À synchroniser", "info", "sync", "En attente de synchronisation"),
        PrinterStatus.PendingDelete => new("pending", "À supprimer", "info", "delete", "En attente de synchronisation"),
        PrinterStatus.ImportedNeedsFix => new("needs-fix", "À compléter", "warning", "build", GenererMessageIncomplet(imp)),
        _ when imp.IsArchived => new("archived", "Archivée", "archived", "archive", null),
        _ => imp.MonitoringStatus switch
        {
            "Ok" => new("online", "En ligne", "online", "check_circle", null),
            "Warning" => new("warning", "Avertissement", "warning", "warning", "Toner bas ou alerte de l'imprimante"),
            "Critical" => new("critical", "Critique", "offline", "report", "Alerte critique de l'imprimante"),
            "Offline" => new("offline", "Hors ligne", "offline", "cloud_off", imp.LastSeen.HasValue ? $"Vue le {imp.LastSeen.Value.ToLocalTime():dd/MM/yyyy HH:mm}" : null),
            _ => new("unknown", "Inconnu", "unknown", "help", "Pas encore supervisée")
        }
    };

    private static readonly List<FilterOption<string>> statutOptions = new()
    {
        new("online", "En ligne"), new("offline", "Hors ligne"), new("warning", "Avertissement"), new("critical", "Critique"),
        new("pending", "À synchroniser"), new("sync-error", "Erreur de synchro"), new("needs-fix", "À compléter"), new("unknown", "Inconnu")
    };

    private sealed record FilterOption<T>(T Value, string Text);

    private async Task SynchroniserSelection()
    {
        if (selected == null || !selected.Any()) return;
        var ok = await DialogService.Confirm($"Appliquer la configuration Windows de {selected.Count} imprimante{(selected.Count > 1 ? "s" : "")} sur le serveur ?",
            "Synchroniser la sélection", new ConfirmOptions { OkButtonText = "Synchroniser", CancelButtonText = "Annuler" });
        if (ok != true) return;
        isSyncing = true;
        try
        {
            await ExecuterSynchroReelle(selected.Select(i => i.Id).ToList());
            selected = null;
        }
        finally { isSyncing = false; }
    }

    private async Task ToggleArchive(Imprimante imp)
    {
        var confirmMsg = imp.IsArchived ? "Désarchiver cette imprimante ?" : "Archiver cette imprimante ?";
        var confirm = await DialogService.Confirm(confirmMsg, "Confirmation", new ConfirmOptions { OkButtonText = "Oui", CancelButtonText = "Non" });
        if (confirm == true)
        {
            try
            {
                imp.IsArchived = !imp.IsArchived;
                if (!imp.IsArchived)
                {
                    imp.MonitoringStatus = "Inconnu";
                }

                var response = await Http.PutAsJsonAsync($"api/Imprimantes/{imp.Id}", imp);
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Succès", imp.IsArchived ? "Imprimante archivée." : "Imprimante restaurée.");
                    await ChargerListe();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    NotificationService.Notify(NotificationSeverity.Error, "Erreur", error);
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
            }
        }
    }

    private async Task ApplyChanges()
    {
        isSyncing = true;
        try
        {
            var previewItems = await SyncService.GetPreview();
            var selectedIds = await DialogService.OpenAsync<SyncPreviewModal>("Aperçu des modifications",
                new Dictionary<string, object?> { { "Items", previewItems } },
                new DialogOptions() { Width = "800px", Height = "600px", CloseDialogOnOverlayClick = false }
            );
            if (selectedIds is List<int> idsToSync && idsToSync.Any())
            {
                await ExecuterSynchroReelle(idsToSync);
            }
        }
        catch (Exception ex)
        {
            syncResult = new BatchResult { Success = false, Messages = new List<string> { "Erreur : " + ex.Message } };
        }
        finally { isSyncing = false; }
    }

    private async Task ExecuterSynchroReelle(List<int> ids)
    {
        syncResult = null;
        try
        {
            syncResult = await SyncService.ApplyChanges(ids);
            if (syncResult.Success) await ChargerListe();
        }
        catch (Exception ex)
        {
            syncResult = new BatchResult { Success = false, Messages = new List<string> { ex.Message } };
        }
    }

    private async Task AuditerServeur()
    {
        isAuditing = true;
        try
        {
            var response = await Http.PostAsync("api/Imprimantes/Audit", null);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                string msg = (json.TryGetProperty("message", out var p) ? p.GetString() : null) ?? "Audit terminé.";

                NotificationService.Notify(NotificationSeverity.Info, "Audit Terminé", msg);
                await ChargerListe();
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Erreur Audit", await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Exception", ex.Message);
        }
        finally
        {
            isAuditing = false;
        }
    }

    private async Task OuvrirScanModal()
    {
        await DialogService.OpenAsync<ScanPrintersModal>("Scanner le réseau",
             null,
             new DialogOptions() { Width = "90%", Height = "85%", CloseDialogOnOverlayClick = false }
        );
        await ChargerListe();
    }

    private async Task OuvrirModal(Imprimante imp)
    {
        var impClone = new Imprimante
        {
            Id = imp.Id,
            NomAffiche = imp.NomAffiche,
            Code = imp.Code,
            AdresseIp = imp.AdresseIp,
            Localisation = imp.Localisation,
            EstPartagee = imp.EstPartagee,
            NomPartage = imp.NomPartage,
            Commentaire = imp.Commentaire,
            ModeleId = imp.ModeleId,
            EmplacementId = imp.EmplacementId,
            Status = imp.Status,
            IsDirectPrintingEnabled = imp.IsDirectPrintingEnabled,
            SerialNumber = imp.SerialNumber,
            SnmpPort = imp.SnmpPort,
            SnmpCommunity = imp.SnmpCommunity,
            SnmpVersion = imp.SnmpVersion,
            // Sans lui, enregistrer la fiche retirait le profil d'identifiants SNMP propre à l'imprimante (vu avec B32)
            SnmpCredentialId = imp.SnmpCredentialId
        };

        var title = imp.Id == 0 ? "Nouvelle imprimante" : "Modifier l'imprimante";
        var result = await DialogService.OpenAsync<ImprimanteModal>(title,
            new Dictionary<string, object?> { { "ImprimanteToEdit", impClone } },
            new DialogOptions() { Width = "680px", CloseDialogOnOverlayClick = true }
        );
        if (result == true)
        {
            await ChargerListe();
        }
    }

    private async Task OuvrirDiagnosticModal(Imprimante imp)
    {
        await DialogService.OpenAsync<PrinterDiagnosticModal>($"Diagnostic : {imp.NomAffiche}",
            new Dictionary<string, object?> { { "Imprimante", imp } },
            new DialogOptions() { Width = "750px", CloseDialogOnOverlayClick = true }
        );
        await ChargerListe();
    }

    private async Task ExporterEnCsv()
    {
        if (imprimantes == null || !imprimantes.Any()) return;
        var csvBuilder = new StringBuilder();
        csvBuilder.AppendLine("Id;Nom;Code;N° Série;Modele;IP;Lieu;Emplacement;Partage;modeDirect");

        foreach (var i in imprimantes)
        {
            var nom = i.NomAffiche?.Replace(";", ",") ?? "";
            var sn = i.SerialNumber?.Replace(";", ",") ?? "";
            var modele = i.Modele?.Nom?.Replace(";", ",") ?? "";
            var lieu = i.Emplacement?.Nom?.Replace(";", ",") ?? "";
            var modeDirect = i.IsDirectPrintingEnabled ? "Oui" : "Non";
            csvBuilder.AppendLine($"{i.Id};{nom};{i.Code};{sn};{modele};{i.AdresseIp};{lieu};{i.Localisation};{i.EstPartagee};{modeDirect}");
        }

        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csvBuilder.ToString())).ToArray();
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);

        var nomFichier = $"Parc_Imprimantes_{DateTime.Now:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("downloadFileFromStream", nomFichier, streamRef);
        NotificationService.Notify(NotificationSeverity.Info, "Export", "CSV généré.");
    }

    private string GenererMessageIncomplet(Imprimante imp)
    {
        var manquants = new List<string>();
        if (imp.ModeleId <= 1) manquants.Add("Modèle");
        if (imp.EmplacementId == 0) manquants.Add("Emplacement");
        if (string.IsNullOrWhiteSpace(imp.AdresseIp)) manquants.Add("Adresse IP");
        return manquants.Any() ? "Action requise : Sélectionnez " + string.Join(", ", manquants) : "Données incomplètes";
    }


