@using Autoprint.Shared
@using Autoprint.Shared.DTOs
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="SnmpCredentialEditDto" Data="@model" Submit="@Enregistrer">
    <RadzenStack Gap="1rem">
        <RadzenRow RowGap="1rem">
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenLabel Text="Nom" Component="Name" />
                <RadzenTextBox Name="Name" @bind-Value="@model.Name" Style="width: 100%;" Placeholder="ex : SNMPv3 Parc HP" />
                <RadzenRequiredValidator Component="Name" Text="Nom obligatoire" Popup="false" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenLabel Text="Version" Component="Version" />
                <RadzenDropDown Name="Version" TValue="int" @bind-Value="@model.Version" Data="@versions" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenLabel Text="Description" Component="Description" />
                <RadzenTextBox Name="Description" @bind-Value="@model.Description" Style="width: 100%;" />
            </RadzenColumn>
        </RadzenRow>

        @if (model.Version != 3)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Size="AlertSize.Small" AllowClose="false">
                En v1 / v2c, la communauté circule en clair sur le réseau. Préférez SNMPv3 quand l'imprimante le permet.
            </RadzenAlert>
            <div>
                <RadzenLabel Text="Communauté" Component="Community" />
                <RadzenPassword Name="Community" @bind-Value="@model.Community" Style="width: 100%;" AutoComplete="false"
                                Placeholder="@(Existing?.HasCommunity == true ? "Laisser vide pour conserver la communauté actuelle" : "")" />
            </div>
        }
        else
        {
            <RadzenRow RowGap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Utilisateur SNMPv3" Component="User" />
                    <RadzenTextBox Name="User" @bind-Value="@model.V3Username" Style="width: 100%;" AutoComplete="false" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Niveau de sécurité" Component="Level" />
                    <RadzenDropDown Name="Level" TValue="SnmpV3SecurityLevel" @bind-Value="@model.V3SecurityLevel" Data="@levels" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" />
                </RadzenColumn>

                @if (model.V3SecurityLevel != SnmpV3SecurityLevel.NoAuthNoPriv)
                {
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Authentification" Component="Auth" />
                        <RadzenDropDown Name="Auth" TValue="SnmpAuthProtocol" @bind-Value="@model.V3AuthProtocol" Data="@authProtocols" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Mot de passe d'authentification" Component="AuthPwd" />
                        <RadzenPassword Name="AuthPwd" @bind-Value="@model.V3AuthPassword" Style="width: 100%;" AutoComplete="false"
                                        Placeholder="@(Existing?.HasAuthPassword == true ? "Laisser vide pour conserver" : "8 caractères minimum")" />
                    </RadzenColumn>
                }

                @if (model.V3SecurityLevel == SnmpV3SecurityLevel.AuthPriv)
                {
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Chiffrement" Component="Priv" />
                        <RadzenDropDown Name="Priv" TValue="SnmpPrivProtocol" @bind-Value="@model.V3PrivProtocol" Data="@privProtocols" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Mot de passe de chiffrement" Component="PrivPwd" />
                        <RadzenPassword Name="PrivPwd" @bind-Value="@model.V3PrivPassword" Style="width: 100%;" AutoComplete="false"
                                        Placeholder="@(Existing?.HasPrivPassword == true ? "Laisser vide pour conserver" : "8 caractères minimum")" />
                    </RadzenColumn>
                }
            </RadzenRow>

            @if (model.V3SecurityLevel == SnmpV3SecurityLevel.NoAuthNoPriv)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Size="AlertSize.Small" AllowClose="false">
                    Sans authentification, SNMPv3 n'apporte aucune protection. Utilisez au moins « authentification ».
                </RadzenAlert>
            }
        }

        @if (!string.IsNullOrEmpty(erreur))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Size="AlertSize.Small" AllowClose="false">@erreur</RadzenAlert>
        }

        <RadzenStack Class="ap-dlg-footer" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => DialogService.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Enregistrer" ButtonStyle="ButtonStyle.Primary" IsBusy="@busy" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public SnmpCredentialViewDto? Existing { get; set; }

    private SnmpCredentialEditDto model = new();
    private bool busy;
    private string? erreur;

    private readonly object[] versions = { new { Text = "SNMPv3 (recommandé)", Value = 3 }, new { Text = "v2c", Value = 2 }, new { Text = "v1", Value = 1 } };
    private readonly object[] levels =
    {
        new { Text = "Authentification + chiffrement (recommandé)", Value = SnmpV3SecurityLevel.AuthPriv },
        new { Text = "Authentification seule", Value = SnmpV3SecurityLevel.AuthNoPriv },
        new { Text = "Aucune (déconseillé)", Value = SnmpV3SecurityLevel.NoAuthNoPriv }
    };
    private readonly object[] authProtocols =
    {
        new { Text = "SHA-256 (recommandé)", Value = SnmpAuthProtocol.Sha256 },
        new { Text = "SHA-384", Value = SnmpAuthProtocol.Sha384 },
        new { Text = "SHA-512", Value = SnmpAuthProtocol.Sha512 },
        new { Text = "SHA-1", Value = SnmpAuthProtocol.Sha1 },
        new { Text = "MD5 (déconseillé, anciens matériels)", Value = SnmpAuthProtocol.Md5 }
    };
    private readonly object[] privProtocols =
    {
        new { Text = "AES-128 (recommandé)", Value = SnmpPrivProtocol.Aes128 },
        new { Text = "AES-192", Value = SnmpPrivProtocol.Aes192 },
        new { Text = "AES-256", Value = SnmpPrivProtocol.Aes256 },
        new { Text = "3DES (déconseillé, anciens matériels)", Value = SnmpPrivProtocol.TripleDes }
    };

    protected override void OnInitialized()
    {
        model = Existing == null
            ? new SnmpCredentialEditDto { Version = 3 }
            : new SnmpCredentialEditDto
            {
                Name = Existing.Name,
                Description = Existing.Description,
                Version = Existing.Version,
                V3Username = Existing.V3Username,
                V3SecurityLevel = Existing.V3SecurityLevel,
                V3AuthProtocol = Existing.V3AuthProtocol,
                V3PrivProtocol = Existing.V3PrivProtocol
            };
    }

    private async Task Enregistrer()
    {
        busy = true;
        erreur = null;
        try
        {
            var response = Existing == null
                ? await Http.PostAsJsonAsync("api/SnmpCredentials", model)
                : await Http.PutAsJsonAsync($"api/SnmpCredentials/{Existing.Id}", model);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Enregistré", $"Identifiants « {model.Name} » enregistrés.");
                DialogService.Close(true);
            }
            else erreur = await response.Content.ReadAsStringAsync();
        }
        catch (Exception ex) { erreur = ex.Message; }
        finally { busy = false; }
    }
}
