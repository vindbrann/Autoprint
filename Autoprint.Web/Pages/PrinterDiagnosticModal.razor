@using Autoprint.Shared
@using Autoprint.Shared.DTOs
@inject HttpClient Http
@inject DialogService DialogService

<RadzenStack Gap="1.5rem" Class="rz-p-2">
    @if (loading)
    {
        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Class="rz-py-12" Gap="1rem">
            <RadzenProgressBar Circular="true" Value="100" ProgressValue="100" Mode="ProgressBarMode.Indeterminate" Style="width: 60px; height: 60px;" />
            <RadzenText TextStyle="TextStyle.Body1">Interrogation de l'imprimante en cours (Ping &amp; SNMP)...</RadzenText>
        </RadzenStack>
    }
    else if (diagnostic == null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">
            Impossible de charger le diagnostic de cette imprimante.
        </RadzenAlert>
    }
    else
    {
        <!-- Statut Réseau / Ping -->
        <RadzenCard Variant="Variant.Outlined" Class="@(diagnostic.PingSuccess ? "ping-card-ok" : "ping-card-error")">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="@(diagnostic.PingSuccess ? "wifi" : "wifi_off")" 
                                IconColor="@(diagnostic.PingSuccess ? "var(--rz-success)" : "var(--rz-danger)")" 
                                Style="font-size: 2.2rem;" />
                    <RadzenStack Gap="0">
                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; font-weight: bold;">
                            @(diagnostic.PingSuccess ? "Machine Connectée" : "Machine Hors Ligne")
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-tertiary-color);">
                            IP : @Imprimante.AdresseIp
                        </RadzenText>
                    </RadzenStack>
                </RadzenStack>
                
                <RadzenBadge BadgeStyle="@(diagnostic.PingSuccess ? BadgeStyle.Success : BadgeStyle.Danger)" 
                             Variant="Variant.Flat" 
                             Class="rz-px-4 rz-py-2" 
                             Style="font-size: 1.1em; font-weight: bold;">
                    @(diagnostic.PingSuccess ? $"{diagnostic.PingRoundtripTimeMs} ms" : "INACCESSIBLE")
                </RadzenBadge>
            </RadzenStack>
        </RadzenCard>

        @* B33 : sans profil d'OID sur le modèle, l'imprimante est quand même interrogée avec les OID standard *@
        @if (!diagnostic.HasSnmpProfile)
        {
            <div class="ap-name-note"><RadzenIcon Icon="info" />Détection automatique : le modèle n'a pas de profil SNMP, les consommables et les bacs sont lus directement dans l'imprimante.</div>
        }
        @if (diagnostic.PingSuccess)
        {
            <RadzenRow Gap="1rem">
                <!-- Statut physique & Uptime -->
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenCard Style="height: 100%;">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="color: var(--rz-text-tertiary-color); font-weight: bold; text-transform: uppercase;">
                            État Matériel
                        </RadzenText>
                        <RadzenStack Gap="0.75rem" Class="rz-mt-3">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenIcon Icon="info" IconColor="var(--rz-info)" />
                                <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: bold;">
                                    Statut : @diagnostic.Status
                                </RadzenText>
                            </RadzenStack>

                            @if (!string.IsNullOrWhiteSpace(diagnostic.SerialNumber))
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenIcon Icon="qr_code" IconColor="var(--rz-primary)" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: bold;">
                                        N° de Série : <span style="font-family: monospace; color: var(--rz-primary);">@diagnostic.SerialNumber</span>
                                    </RadzenText>
                                </RadzenStack>
                            }

                            @if (diagnostic.UptimeSeconds > 0)
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenIcon Icon="query_builder" IconColor="var(--rz-warning)" />
                                    <RadzenText TextStyle="TextStyle.Body2">
                                        Uptime : @FormatUptime(diagnostic.UptimeSeconds)
                                    </RadzenText>
                                </RadzenStack>
                            }

                            @if (diagnostic.PageCounter > 0)
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenIcon Icon="tag" IconColor="var(--rz-secondary)" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: bold;">
                                        Compteur Pages : @diagnostic.PageCounter.ToString("N0")
                                    </RadzenText>
                                </RadzenStack>
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>

                <!-- Alertes actives sur l'écran -->
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenCard Style="height: 100%;">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="color: var(--rz-text-tertiary-color); font-weight: bold; text-transform: uppercase;">
                            Messages &amp; Alertes Imprimante
                        </RadzenText>
                        <RadzenStack Gap="0.5rem" Class="rz-mt-3">
                            @if (diagnostic.Alerts == null || !diagnostic.Alerts.Any())
                            {
                                <RadzenText TextStyle="TextStyle.Body2" Style="font-style: italic; color: var(--rz-text-tertiary-color);">
                                    Aucune alerte ou message affiché.
                                </RadzenText>
                            }
                            else
                            {
                                @foreach (var alert in diagnostic.Alerts.OrderByDescending(a => a.Severity))
                                {
                                    <div class="alert-item alert-@(alert.Severity.ToString().ToLowerInvariant())">
                                        <RadzenIcon Icon="@AlertIcon(alert.Severity)" Style="font-size: 1.1rem; margin-right: 6px;" />
                                        <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: bold; display: inline;">
                                            @alert.Text
                                        </RadzenText>
                                    </div>
                                }
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>

            var consumables = diagnostic.Toners?.Where(t => t.Kind == SupplyKind.Toner).ToList() ?? new();
            var maintenance = diagnostic.Toners?.Where(t => t.Kind == SupplyKind.Maintenance).ToList() ?? new();

            <!-- Consommables -->
            @if (consumables.Any())
            {
                <RadzenCard>
                    <div class="diag-section-head">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="color: var(--rz-text-tertiary-color); font-weight: bold; text-transform: uppercase; margin: 0;">
                            Consommables
                        </RadzenText>
                        <span class="diag-section-note">Seuil bas : @diagnostic.LowThresholdPercent %</span>
                    </div>
                    <RadzenStack Gap="1rem">
                        @foreach (var supply in consumables)
                        {
                            @SupplyRow(supply)
                        }
                    </RadzenStack>
                </RadzenCard>
            }

            <!-- Maintenance (unité de fusion, photoconducteur, kits…) -->
            @if (maintenance.Any())
            {
                <RadzenCard>
                    <div class="diag-section-head">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="color: var(--rz-text-tertiary-color); font-weight: bold; text-transform: uppercase; margin: 0;">
                            Maintenance
                        </RadzenText>
                    </div>
                    <RadzenStack Gap="1rem">
                        @foreach (var supply in maintenance)
                        {
                            @SupplyRow(supply)
                        }
                    </RadzenStack>
                </RadzenCard>
            }

            <!-- Bacs Papier -->
            @if (diagnostic.Trays != null && diagnostic.Trays.Any())
            {
                <RadzenCard>
                    <div class="diag-section-head">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="color: var(--rz-text-tertiary-color); font-weight: bold; text-transform: uppercase; margin: 0;">
                            Bacs de papier
                        </RadzenText>
                    </div>
                    <RadzenStack Gap="1rem">
                        @foreach (var tray in diagnostic.Trays)
                        {
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: bold; margin: 0; overflow-wrap: anywhere;">
                                        @tray.Name
                                    </RadzenText>
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    @if (tray.HasLevel)
                                    {
                                        <div class="diag-gauge">
                                            <div class="diag-gauge-track">
                                                <div class="diag-gauge-fill" style="--fill: var(--ap-info); width: @(Math.Clamp(tray.CurrentLevel, 0, 100))%;"></div>
                                            </div>
                                            <span class="diag-gauge-value @(tray.State == SupplyState.Empty ? "is-tray-empty" : "")">
                                                @(tray.CurrentLevel <= 100 ? $"{tray.CurrentLevel} %" : $"{tray.CurrentLevel} f.")
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="diag-state-line">
                                            <span class="diag-pill diag-pill-@(tray.State.ToString().ToLowerInvariant())">@TrayStateLabel(tray.State)</span>
                                            <span class="diag-state-hint">Niveau non communiqué par l'imprimante</span>
                                        </div>
                                    }
                                </RadzenColumn>
                            </RadzenRow>
                        }
                    </RadzenStack>
                </RadzenCard>
            }
        }
        else
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" Variant="Variant.Flat" Class="rz-p-4">
                <RadzenText TextStyle="TextStyle.Subtitle1" Style="font-weight: bold; margin-bottom: 0.5rem;">Conseils de dépannage :</RadzenText>
                <ul>
                    <li>Vérifiez si l'imprimante est allumée physiquement.</li>
                    <li>Vérifiez que le câble réseau Ethernet ou la connexion Wi-Fi de la machine est fonctionnel.</li>
                    <li>Assurez-vous qu'aucun pare-feu réseau ne bloque les requêtes de diagnostic (Ping ICMP et port SNMP 161).</li>
                </ul>
            </RadzenAlert>
        }
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Class="rz-mt-2">
        <RadzenButton Text="Fermer" Click="@(() => DialogService.Close())" ButtonStyle="ButtonStyle.Light" Style="width: 120px;" />
    </RadzenStack>
</RadzenStack>

<style>
    /* Jetons --ap-* uniquement : ils suivent le thème clair / sombre (issue #46). L'échelle --rz-base-* n'est pas
       inversée en sombre (base-50 à base-200 restent des gris clairs) et ne doit pas servir de fond ici. */
    .ping-card-ok {
        border-color: var(--ap-success) !important;
        background-color: var(--ap-success-subtle) !important;
    }
    .ping-card-error {
        border-color: var(--ap-danger) !important;
        background-color: var(--ap-danger-subtle) !important;
    }
    .alert-item {
        background-color: var(--ap-warning-subtle);
        color: var(--ap-text);
        border-radius: 4px;
        padding: 0.5rem;
        border-left: 3px solid var(--ap-warning);
        display: flex;
        align-items: center;
    }
    .alert-item .rz-text-body2 { color: var(--ap-text); }
    .alert-item .rzi { color: var(--ap-warning); }
    .alert-item.alert-critical { background-color: var(--ap-danger-subtle); border-left-color: var(--ap-danger); }
    .alert-item.alert-critical .rzi { color: var(--ap-danger); }
    .alert-item.alert-info { background-color: var(--ap-info-subtle); border-left-color: var(--ap-info); }
    .alert-item.alert-info .rzi { color: var(--ap-info); }

    .diag-section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; margin-bottom: 1rem; }
    .diag-section-note { font-size: 12px; color: var(--ap-text-muted); }

    /* Consommable sans niveau communiqué : pastille d'état (#49) */
    .diag-state-line { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 0.75rem; }
    .diag-state-hint { font-size: 12px; color: var(--ap-text-muted); }
    .diag-pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
    .diag-pill-ok { background: var(--ap-success-subtle); color: var(--ap-success); }
    .diag-pill-low { background: var(--ap-warning-subtle); color: var(--ap-warning); }
    .diag-pill-empty { background: var(--ap-danger-subtle); color: var(--ap-danger); }
    .diag-pill-unknown { background: var(--ap-surface-raised); color: var(--ap-text-muted); }
    .diag-forecast { margin-top: 4px; font-size: 12px; color: var(--ap-text-muted); }

    /* Jauge : barre + valeur à côté (pas superposée), lisible quelle que soit la couleur du consommable */
    .diag-gauge { display: flex; align-items: center; gap: 0.75rem; }
    .diag-gauge-track {
        flex: 1;
        height: 12px;
        border-radius: 999px;
        overflow: hidden;
        background-color: var(--ap-surface-raised);
        box-shadow: inset 0 0 0 1px var(--ap-border);
    }
    .diag-gauge-fill {
        height: 100%;
        border-radius: 999px;
        background-color: var(--fill);
        transition: width 0.5s ease-in-out;
    }
    /* Toner noir sur fond sombre : la couleur réelle se confondrait avec la carte, on l'éclaircit */
    html:root[data-theme="dark"] .diag-gauge-fill.is-dark-ink { background-color: var(--ap-text-secondary); }
    .diag-gauge-value {
        min-width: 4.5rem;
        text-align: right;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        color: var(--ap-text);
    }
    .diag-gauge-value.is-low { color: var(--ap-warning); }
    .diag-gauge-value.is-empty { color: var(--ap-danger); }
    /* Bac vide : souvent le bac manuel, vide en temps normal ; pas de rouge */
    .diag-gauge-value.is-tray-empty { font-weight: 400; color: var(--ap-text-muted); }
</style>

@code {
    [Parameter] public Imprimante Imprimante { get; set; } = new();

    private bool loading = true;
    private PrinterDiagnosticResult? diagnostic;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            loading = true;
            diagnostic = await Http.GetFromJsonAsync<PrinterDiagnosticResult>($"api/Imprimantes/{Imprimante.Id}/diagnostic");
        }
        catch (Exception)
        {
            diagnostic = null;
        }
        finally
        {
            loading = false;
        }
    }

    private string FormatUptime(long totalSeconds)
    {
        if (totalSeconds <= 0) return "Indisponible";
        var t = TimeSpan.FromSeconds(totalSeconds);
        static string N(int n, string unit) => $"{n} {unit}{(n > 1 ? "s" : "")}";
        if (t.Days > 0) return $"{N(t.Days, "jour")}, {N(t.Hours, "heure")} et {N(t.Minutes, "minute")}";
        if (t.Hours > 0) return $"{N(t.Hours, "heure")} et {N(t.Minutes, "minute")}";
        return N(t.Minutes, "minute");
    }

    // Ligne d'un consommable : jauge si le niveau est connu, pastille d'état sinon ; prévision en dessous (#49)
    private RenderFragment SupplyRow(TonerLevelResult supply) => __builder =>
    {
        var hex = !string.IsNullOrEmpty(supply.ColorHex) ? supply.ColorHex : GetColorHex(supply.Color);
        var forecast = ForecastText(supply.EstimatedDaysRemaining);
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="4">
                <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: bold; margin: 0; overflow-wrap: anywhere;">
                    @supply.Color
                </RadzenText>
            </RadzenColumn>
            <RadzenColumn Size="8">
                @if (supply.HasLevel)
                {
                    <div class="diag-gauge">
                        <div class="diag-gauge-track">
                            <div class="diag-gauge-fill @(IsDarkInk(hex) ? "is-dark-ink" : "")"
                                 style="--fill: @hex; width: @(Math.Clamp(supply.CurrentLevel, 0, 100))%;"></div>
                        </div>
                        <span class="diag-gauge-value @(supply.State == SupplyState.Empty ? "is-empty" : supply.State == SupplyState.Low ? "is-low" : "")">
                            @(supply.IsReceptacle ? $"{supply.CurrentLevel} % libre" : $"{supply.CurrentLevel} %")
                        </span>
                    </div>
                }
                else
                {
                    <div class="diag-state-line">
                        <span class="diag-pill diag-pill-@(supply.State.ToString().ToLowerInvariant())">@SupplyStateLabel(supply)</span>
                        <span class="diag-state-hint">Niveau non communiqué par l'imprimante</span>
                    </div>
                }
                @if (forecast != null)
                {
                    <div class="diag-forecast">@forecast</div>
                }
            </RadzenColumn>
        </RadzenRow>
    };

    // Réceptacle (bac de récupération) : le niveau est l'espace restant, « bas » veut dire presque plein
    private static string SupplyStateLabel(TonerLevelResult supply) => supply.State switch
    {
        SupplyState.Ok => "OK",
        SupplyState.Low => supply.IsReceptacle ? "Presque plein" : "Bas",
        SupplyState.Empty => supply.IsReceptacle ? "Plein" : "Vide",
        _ => "Inconnu"
    };

    private static string TrayStateLabel(SupplyState state) => state switch
    {
        SupplyState.Ok => "Papier présent",
        SupplyState.Low => "Bas",
        SupplyState.Empty => "Vide",
        _ => "Inconnu"
    };

    private static string AlertIcon(AlertSeverity severity) => severity switch
    {
        AlertSeverity.Critical => "error",
        AlertSeverity.Warning => "warning",
        _ => "info"
    };

    /// <summary>Prévision de PredictiveService : null = pas assez de relevés, -99 = pas de baisse mesurable.</summary>
    private static string? ForecastText(int? days)
    {
        if (days == null || days == -99) return null;
        if (days <= 0) return "Épuisement imminent d'après les relevés";
        var date = DateTime.Today.AddDays(days.Value);
        return $"Environ {days} jour{(days > 1 ? "s" : "")} restant{(days > 1 ? "s" : "")}, vers le {date:dd/MM}";
    }

    private string GetColorHex(string colorName)
    {
        var name = colorName.ToLowerInvariant();
        if (name.Contains("noir") || name.Contains("black")) return "#212529";
        if (name.Contains("cyan")) return "#17a2b8";
        if (name.Contains("magenta")) return "#e83e8c";
        if (name.Contains("jaune") || name.Contains("yellow")) return "#ffc107";
        return "#6c757d";
    }

    /// <summary>Couleur très sombre (luminance relative &lt; 0,08) : invisible sur la carte en thème sombre.</summary>
    private static bool IsDarkInk(string? hex)
    {
        if (string.IsNullOrWhiteSpace(hex)) return false;
        var h = hex.Trim().TrimStart('#');
        if (h.Length == 3) h = string.Concat(h.Select(c => $"{c}{c}"));
        if (h.Length != 6 || !int.TryParse(h, System.Globalization.NumberStyles.HexNumber, null, out var rgb)) return false;

        static double Lin(int c) { var v = c / 255.0; return v <= 0.03928 ? v / 12.92 : Math.Pow((v + 0.055) / 1.055, 2.4); }
        var lum = 0.2126 * Lin((rgb >> 16) & 0xFF) + 0.7152 * Lin((rgb >> 8) & 0xFF) + 0.0722 * Lin(rgb & 0xFF);
        return lum < 0.08;
    }
}
