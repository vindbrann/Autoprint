@using Autoprint.Shared
@using Autoprint.Shared.DTOs
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

@* Maquette « modales » (retour de recette du 11/11) : modèles d'OID en étiquettes neutres, libellés français
   pour la catégorie et l'interprétation, test de l'OID en ligne, action principale nommée *@
<div class="ap-dlg">
    <div class="ap-field" style="margin-bottom: var(--ap-s2);">
        <span class="ap-help">Partir d'un OID standard (RFC 3805)</span>
        <div class="ap-chips">
            <button type="button" class="ap-chip" @onclick="@(() => AppliquerPreset("Toner noir", "1.3.6.1.2.1.43.11.1.1.9.1.1", "1.3.6.1.2.1.43.11.1.1.8.1.1", SnmpItemCategory.Toner, SnmpValueType.RawWithMax, "#212529"))">Toner noir</button>
            <button type="button" class="ap-chip" @onclick="@(() => AppliquerPreset("Bac 1", "1.3.6.1.2.1.43.8.2.1.10.1.1", "1.3.6.1.2.1.43.8.2.1.9.1.1", SnmpItemCategory.Tray, SnmpValueType.RawWithMax))">Bac papier 1</button>
            <button type="button" class="ap-chip" @onclick="@(() => AppliquerPreset("Compteur total", "1.3.6.1.2.1.43.10.2.1.4.1.1", null, SnmpItemCategory.PageCounter, SnmpValueType.Counter))">Compteur total</button>
            <button type="button" class="ap-chip" @onclick="@(() => AppliquerPreset("Écran de la console", "1.3.6.1.2.1.43.16.5.1.2.1.1", null, SnmpItemCategory.Console, SnmpValueType.String))">Écran</button>
            <button type="button" class="ap-chip" @onclick="@(() => AppliquerPreset("État de l'imprimante", "1.3.6.1.2.1.25.3.5.1.1.1", null, SnmpItemCategory.Status, SnmpValueType.String))">État</button>
            <button type="button" class="ap-chip" @onclick="@(() => AppliquerPreset("Numéro de série", "1.3.6.1.2.1.43.5.1.1.17.1", null, SnmpItemCategory.SerialNumber, SnmpValueType.String))">N° de série</button>
        </div>
    </div>

    <div class="ap-dlg-group">
        <h3>Champ</h3>
        <div class="ap-dlg-grid">
            <div class="ap-field">
                <RadzenLabel Text="Nom" Component="ItemName" />
                <RadzenTextBox Name="ItemName" @bind-Value="@ItemToEdit.Name" Style="width: 100%;" Placeholder="Toner cyan" />
            </div>
            <div class="ap-field">
                <RadzenLabel Text="Catégorie" Component="ItemCat" />
                <RadzenDropDown Name="ItemCat" TValue="SnmpItemCategory" Data="@categories" TextProperty="Text" ValueProperty="Value" @bind-Value="@ItemToEdit.Category" Style="width: 100%;" />
            </div>
        </div>
        <div class="ap-field">
            <RadzenLabel Text="OID lu" Component="ItemOid" />
            <RadzenTextBox Name="ItemOid" @bind-Value="@ItemToEdit.Oid" Style="width: 100%;" Class="ap-mono" Placeholder="1.3.6.1.2.1.43.11.1.1.9.1.2" />
        </div>
        <div class="ap-dlg-grid">
            <div class="ap-field">
                <RadzenLabel Text="Lecture de la valeur" Component="ItemType" />
                <RadzenDropDown Name="ItemType" TValue="SnmpValueType" Data="@valueTypes" TextProperty="Text" ValueProperty="Value" @bind-Value="@ItemToEdit.ValueType" Style="width: 100%;" />
            </div>
            @if (ItemToEdit.ValueType == SnmpValueType.RawWithMax)
            {
                <div class="ap-field">
                    <RadzenLabel Text="OID de la capacité maximale" Component="ItemMax" />
                    <RadzenTextBox Name="ItemMax" @bind-Value="@ItemToEdit.OidMaxCapacity" Style="width: 100%;" Class="ap-mono" Placeholder="1.3.6.1.2.1.43.11.1.1.8.1.2" />
                </div>
            }
        </div>
        @if (ItemToEdit.Category == SnmpItemCategory.Toner)
        {
            <div class="ap-field">
                <RadzenLabel Text="Couleur affichée" Component="ItemColor" />
                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--ap-s2);">
                    <span style="display: inline-block; width: 24px; height: 24px; border-radius: var(--ap-r-sm); background-color: @ItemToEdit.ColorHex; border: 1px solid var(--ap-border-strong);"></span>
                    <RadzenTextBox Name="ItemColor" @bind-Value="@ItemToEdit.ColorHex" Style="width: 130px;" Class="ap-mono" Placeholder="#212529" />
                    @foreach (var c in TonerColors)
                    {
                        <button type="button" class="ap-chip" @onclick="@(() => ItemToEdit.ColorHex = c.Hex)"><span style="width: 10px; height: 10px; border-radius: 50%; background: @c.Hex; display: inline-block;"></span>@c.Name</button>
                    }
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(TestIpAddress))
    {
        <div class="ap-dlg-group">
            <h3>Essai</h3>
            <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--ap-s3);">
                <RadzenButton Text="Lire cet OID" Icon="play_arrow" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@TesterOidEnDirect" IsBusy="@isTesting" BusyText="Lecture…" Disabled="@string.IsNullOrWhiteSpace(ItemToEdit.Oid)" />
                <span class="ap-help">sur <span class="ap-mono">@TestIpAddress</span></span>
                @if (!string.IsNullOrEmpty(testFeedback))
                {
                    <span class="ap-help ap-mono @(testFeedbackSuccess ? "is-ok" : "is-bad")">@testFeedback</span>
                }
            </div>
        </div>
    }

    <div class="ap-dlg-footer">
        <span class="ap-help">@(string.IsNullOrWhiteSpace(ItemToEdit.Name) || string.IsNullOrWhiteSpace(ItemToEdit.Oid) ? "Indiquez le nom et l'OID du champ" : "")</span>
        <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => DialogService.Close(null))" />
        <RadzenButton Text="Valider le champ" ButtonStyle="ButtonStyle.Primary" Click="@OnValider" Disabled="@(string.IsNullOrWhiteSpace(ItemToEdit.Name) || string.IsNullOrWhiteSpace(ItemToEdit.Oid))" />
    </div>
</div>

@code {
    [Parameter] public SnmpProfileItem ItemToEdit { get; set; } = new();
    [Parameter] public string? TestIpAddress { get; set; }
    [Parameter] public int TestPort { get; set; } = 161;
    [Parameter] public string TestCommunity { get; set; } = "public";
    [Parameter] public int TestVersion { get; set; } = 2;

    // Libellés français (avant : noms d'énumération anglais « RawWithMax », « PageCounter »…)
    private static readonly object[] categories =
    {
        new { Text = "Toner", Value = SnmpItemCategory.Toner }, new { Text = "Bac papier", Value = SnmpItemCategory.Tray },
        new { Text = "Compteur de pages", Value = SnmpItemCategory.PageCounter }, new { Text = "État", Value = SnmpItemCategory.Status },
        new { Text = "Écran de la console", Value = SnmpItemCategory.Console }, new { Text = "Maintenance", Value = SnmpItemCategory.Maintenance },
        new { Text = "Numéro de série", Value = SnmpItemCategory.SerialNumber }
    };
    private static readonly object[] valueTypes =
    {
        new { Text = "Pourcentage (0 à 100)", Value = SnmpValueType.Percentage },
        new { Text = "Niveau rapporté à une capacité maximale", Value = SnmpValueType.RawWithMax },
        new { Text = "Compteur (nombre)", Value = SnmpValueType.Counter },
        new { Text = "Texte", Value = SnmpValueType.String }
    };
    private sealed record TonerColor(string Name, string Hex);
    private static readonly TonerColor[] TonerColors = { new("Noir", "#212529"), new("Cyan", "#17a2b8"), new("Magenta", "#e83e8c"), new("Jaune", "#ffc107") };

    private bool isTesting = false;
    private string? testFeedback;
    private bool testFeedbackSuccess = false;

    private void AppliquerPreset(string name, string oid, string? maxOid, SnmpItemCategory cat, SnmpValueType valType, string colorHex = "#212529")
    {
        ItemToEdit.Name = name;
        ItemToEdit.Oid = oid;
        ItemToEdit.OidMaxCapacity = maxOid;
        ItemToEdit.Category = cat;
        ItemToEdit.ValueType = valType;
        ItemToEdit.ColorHex = colorHex;
        testFeedback = null;
    }

    private async Task TesterOidEnDirect()
    {
        if (string.IsNullOrWhiteSpace(TestIpAddress) || string.IsNullOrWhiteSpace(ItemToEdit.Oid)) return;

        isTesting = true;
        testFeedback = null;

        var req = new SnmpTestProfileRequestDto
        {
            IpAddress = TestIpAddress.Trim(),
            Port = TestPort > 0 ? TestPort : 161,
            Community = !string.IsNullOrWhiteSpace(TestCommunity) ? TestCommunity.Trim() : "public",
            Version = TestVersion > 0 ? TestVersion : 2,
            Items = new List<SnmpProfileItem> { ItemToEdit }
        };

        try
        {
            var res = await Http.PostAsJsonAsync("api/SnmpProfiles/test-profile", req);
            if (res.IsSuccessStatusCode)
            {
                var list = await res.Content.ReadFromJsonAsync<List<SnmpTestProfileResultDto>>() ?? new();
                if (list.Any())
                {
                    var r = list.First();
                    testFeedbackSuccess = r.Success;
                    testFeedback = r.Value;
                }
                else
                {
                    testFeedbackSuccess = false;
                    testFeedback = "Aucune réponse de l'OID.";
                }
            }
            else
            {
                testFeedbackSuccess = false;
                testFeedback = "Échec de communication SNMP.";
            }
        }
        catch (Exception ex)
        {
            testFeedbackSuccess = false;
            testFeedback = ex.Message;
        }
        finally
        {
            isTesting = false;
        }
    }

    private void OnValider()
    {
        if (string.IsNullOrWhiteSpace(ItemToEdit.Name))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Nom manquant", "Veuillez renseigner un nom de champ.");
            return;
        }
        if (string.IsNullOrWhiteSpace(ItemToEdit.Oid))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "OID manquant", "Veuillez renseigner l'OID SNMP.");
            return;
        }
        DialogService.Close(ItemToEdit);
    }
}
