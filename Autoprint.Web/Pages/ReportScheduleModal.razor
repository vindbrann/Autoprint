@using Autoprint.Web.Services
@using Autoprint.Shared
@using System.Text.Json
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

@* Maquette « modales » (retour de recette du 11/11) : étapes en en-tête compact et cliquable, sections sans cadre,
   options en lignes de réglage (plus de cartes ni d'émoji), choix du périmètre en deux options exclusives *@
<RadzenTemplateForm TItem="ReportSchedule" Data="@schedule" Submit="@OnSubmit">
    <div class="ap-dlg">
        <nav class="ap-steps" aria-label="Étapes">
            @foreach (var st in Etapes)
            {
                <button type="button" class="@(currentStep == st.N ? "ap-step is-current" : currentStep > st.N ? "ap-step is-done" : "ap-step")" aria-current="@(currentStep == st.N ? "step" : null)" @onclick="() => AllerStep(st.N)">
                    <span class="n">@(currentStep > st.N ? "✓" : st.N.ToString())</span>@st.Label
                </button>
            }
        </nav>

        @if (currentStep == 1)
        {
            <div class="ap-dlg-group" style="padding-top: var(--ap-s2);">
                <h3>Rapport</h3>
                <div class="ap-dlg-grid" style="grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);">
                    <div class="ap-field">
                        <RadzenLabel Text="Nom" Component="ReportName" />
                        <RadzenTextBox Name="ReportName" @bind-Value="@schedule.ReportName" Style="width: 100%;" Placeholder="État hebdomadaire du parc" />
                        <RadzenRequiredValidator Component="ReportName" Text="Saisissez le nom du rapport" Popup="false" />
                    </div>
                    <div class="ap-field">
                        <RadzenLabel Text="Format" Component="Format" />
                        <RadzenDropDown Name="Format" @bind-Value="@schedule.Format" Data="@formats" Style="width: 100%;" />
                    </div>
                </div>
                <div class="ap-field">
                    <RadzenLabel Text="Destinataires" Component="EmailRecipients" />
                    <RadzenTextBox Name="EmailRecipients" @bind-Value="@schedule.EmailRecipients" Style="width: 100%;" Placeholder="admin@mondomaine.fr; responsable@mondomaine.fr" />
                    <RadzenRequiredValidator Component="EmailRecipients" Text="Indiquez au moins un destinataire" Popup="false" />
                    <RadzenRegexValidator Component="EmailRecipients" Text="Une adresse est invalide (format attendu : nom@domaine.fr)"
                                          Pattern=@(@"^([a-zA-Z0-9_\-\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,5})(\s*;\s*([a-zA-Z0-9_\-\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,5}))*\s*;?\s*$") Popup="false" />
                    <span class="ap-help">Séparez les adresses par un point-virgule</span>
                </div>
            </div>
            <div class="ap-dlg-group">
                <h3>Envoi</h3>
                <div class="ap-dlg-grid" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));">
                    <div class="ap-field">
                        <RadzenLabel Text="Fréquence" Component="Frequency" />
                        <RadzenDropDown Name="Frequency" @bind-Value="@schedule.Frequency" Data="@frequencies" Style="width: 100%;" />
                    </div>
                    @if (schedule.Frequency == "Hebdomadaire")
                    {
                        <div class="ap-field">
                            <RadzenLabel Text="Jour" Component="RunDayOfWeek" />
                            <RadzenDropDown Name="RunDayOfWeek" @bind-Value="@schedule.RunDayOfWeek" Data="@joursSemaine" TextProperty="Label" ValueProperty="Value" Style="width: 100%;" />
                        </div>
                    }
                    else if (schedule.Frequency == "Mensuel")
                    {
                        <div class="ap-field">
                            <RadzenLabel Text="Jour du mois" Component="RunDayOfMonth" />
                            <RadzenDropDown Name="RunDayOfMonth" @bind-Value="@schedule.RunDayOfMonth" Data="@joursMois" Style="width: 100%;" />
                        </div>
                    }
                    <div class="ap-field">
                        <RadzenLabel Text="Heure" Component="RunHour" />
                        <RadzenDropDown Name="RunHour" @bind-Value="@schedule.RunHour" Data="@heures" Format="00" Style="width: 100%;" />
                    </div>
                    <div class="ap-field">
                        <RadzenLabel Text="Minute" Component="RunMinute" />
                        <RadzenDropDown Name="RunMinute" @bind-Value="@schedule.RunMinute" Data="@minutes" Format="00" Style="width: 100%;" />
                    </div>
                </div>
                <span class="ap-help">
                    @if (schedule.Frequency == "Quotidien") { <text>Envoyé chaque jour à @FormatHeure(schedule.RunHour, schedule.RunMinute)</text> }
                    else if (schedule.Frequency == "Hebdomadaire") { <text>Envoyé chaque @ObtenirNomJour(schedule.RunDayOfWeek) à @FormatHeure(schedule.RunHour, schedule.RunMinute)</text> }
                    else if (schedule.Frequency == "Mensuel") { <text>Envoyé le @(schedule.RunDayOfMonth ?? 1) de chaque mois à @FormatHeure(schedule.RunHour, schedule.RunMinute)</text> }
                </span>
            </div>
        }
        else if (currentStep == 2)
        {
            <div class="ap-dlg-group" style="gap: 0; padding-top: var(--ap-s2);">
                <h3 style="margin-bottom: var(--ap-s1);">Par imprimante</h3>
                <div class="ap-opt-row"><div class="txt"><div class="t">Compteur de pages</div><div class="d">Total des pages imprimées relevé sur la machine</div></div><RadzenSwitch @bind-Value="@includePages" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Compteur de pages" } })" /></div>
                <div class="ap-opt-row"><div class="txt"><div class="t">Toners</div><div class="d">Niveaux noir, cyan, magenta et jaune</div></div><RadzenSwitch @bind-Value="@includeToner" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Toners" } })" /></div>
                <div class="ap-opt-row"><div class="txt"><div class="t">Bacs papier</div><div class="d">Niveau de papier de chaque bac</div></div><RadzenSwitch @bind-Value="@includeTrays" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Bacs papier" } })" /></div>
                <div class="ap-opt-row"><div class="txt"><div class="t">Disponibilité</div><div class="d">En ligne ou hors ligne au moment du rapport</div></div><RadzenSwitch @bind-Value="@includeAvailability" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Disponibilité" } })" /></div>
                <div class="ap-opt-row"><div class="txt"><div class="t">Pannes et alertes</div><div class="d">Codes d'erreur, bourrages, capots ouverts</div></div><RadzenSwitch @bind-Value="@includeAlerts" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Pannes et alertes" } })" /></div>
                <div class="ap-opt-row">
                    <div class="txt"><div class="t">Prévision d'épuisement des toners</div><div class="d">Nombre de jours restants estimé d'après l'historique</div></div>
                    <RadzenSwitch @bind-Value="@includePredictions" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Prévision d'épuisement des toners" } })" />
                </div>
                @if (includePredictions)
                {
                    <div class="ap-field" style="padding: 0 0 var(--ap-s3);">
                        <RadzenLabel Text="Signaler les toners vides dans moins de" Component="Threshold" />
                        <RadzenDropDown Name="Threshold" TValue="int" @bind-Value="@schedule.PredictionThresholdDays" Data="@thresholdOptions" TextProperty="Label" ValueProperty="Value" Style="width: 180px;" />
                    </div>
                }
            </div>
            <div class="ap-dlg-group" style="gap: 0;">
                <h3 style="margin-bottom: var(--ap-s1);">Synthèse du parc</h3>
                <div class="ap-opt-row"><div class="txt"><div class="t">Total des pages imprimées</div><div class="d">Somme sur tout le parc (en-tête du PDF, dernière ligne du CSV)</div></div><RadzenSwitch @bind-Value="@includeTotalPages" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Total des pages imprimées" } })" /></div>
                <div class="ap-opt-row"><div class="txt"><div class="t">État du parc</div><div class="d">Imprimantes en ligne, hors ligne et alertes actives, en en-tête</div></div><RadzenSwitch @bind-Value="@includeFleetSummary" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "État du parc" } })" /></div>
            </div>
        }
        else if (currentStep == 3)
        {
            <div class="ap-dlg-group" style="padding-top: var(--ap-s2);">
                <h3>Imprimantes concernées</h3>
                <div class="ap-choice" role="radiogroup" aria-label="Imprimantes concernées">
                    <button type="button" role="radio" aria-checked="@(!useFilters ? "true" : "false")" class="@(!useFilters ? "ap-choice-item is-on" : "ap-choice-item")" @onclick="() => SetUseFilters(false)">
                        <span class="t">Tout le parc</span><span class="d">Un seul rapport pour toutes les imprimantes</span>
                    </button>
                    <button type="button" role="radio" aria-checked="@(useFilters ? "true" : "false")" class="@(useFilters ? "ap-choice-item is-on" : "ap-choice-item")" @onclick="() => SetUseFilters(true)">
                        <span class="t">Une sélection</span><span class="d">Selon le lieu, la marque, le modèle ou le profil SNMP</span>
                    </button>
                </div>
            </div>

            @if (useFilters)
            {
                <div class="ap-dlg-group">
                    <div style="display: flex; align-items: center; gap: var(--ap-s2);">
                        <h3 class="ap-grow" style="margin: 0;">Règles <span class="ap-opt" style="font-weight: 400;">(toutes doivent être vraies)</span></h3>
                        <RadzenButton Icon="add" Text="Ajouter une règle" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@AjouterRegle" />
                    </div>
                    @if (scopeFilter.Rules == null || scopeFilter.Rules.Count == 0)
                    {
                        <div class="ap-name-note"><RadzenIcon Icon="info" />Aucune règle : ajoutez-en une, sinon le rapport porte sur tout le parc.</div>
                    }
                    else
                    {
                        <div class="ap-pick-list">
                            @foreach (var rule in scopeFilter.Rules.ToList())
                            {
                                <div class="ap-rule-row">
                                    <RadzenDropDown TValue="string" Value="@rule.Field" ValueChanged="@((val) => OnFieldChanged(rule, val))" Data="@champsDisponibles" TextProperty="Label" ValueProperty="Value" Style="width: 100%;" aria-label="Propriété" />
                                    <RadzenDropDown TValue="string" @bind-Value="@rule.Operator" Data="@ObtenirOperateurs(rule.Field)" TextProperty="Label" ValueProperty="Value" Style="width: 100%;" aria-label="Condition" />
                                    @if (rule.Field == "LocationId")
                                    {
                                        <RadzenDropDown TValue="List<int>" @bind-Value="@rule.Values" Data="@locations" TextProperty="Nom" ValueProperty="Id" Placeholder="Choisir des lieux" Style="width: 100%;" Multiple="true" AllowFiltering="true" FilterCaseSensitive="false" SelectAllText="Tout sélectionner" MaxSelectedLabels="3" />
                                    }
                                    else if (rule.Field == "BrandId")
                                    {
                                        <RadzenDropDown TValue="List<int>" @bind-Value="@rule.Values" Data="@brands" TextProperty="Nom" ValueProperty="Id" Placeholder="Choisir des marques" Style="width: 100%;" Multiple="true" AllowFiltering="true" FilterCaseSensitive="false" SelectAllText="Tout sélectionner" MaxSelectedLabels="3" />
                                    }
                                    else if (rule.Field == "ModelId")
                                    {
                                        <RadzenDropDown TValue="List<int>" @bind-Value="@rule.Values" Data="@allModels" TextProperty="Nom" ValueProperty="Id" Placeholder="Choisir des modèles" Style="width: 100%;" Multiple="true" AllowFiltering="true" FilterCaseSensitive="false" SelectAllText="Tout sélectionner" MaxSelectedLabels="3" />
                                    }
                                    else if (rule.Field == "SnmpProfileId")
                                    {
                                        <RadzenDropDown TValue="List<int>" @bind-Value="@rule.Values" Data="@snmpProfiles" TextProperty="Name" ValueProperty="Id" Placeholder="Choisir des profils" Style="width: 100%;" Multiple="true" AllowFiltering="true" FilterCaseSensitive="false" SelectAllText="Tout sélectionner" MaxSelectedLabels="3" />
                                    }
                                    else
                                    {
                                        <RadzenTextBox @bind-Value="@rule.Value" Placeholder="Valeur" Style="width: 100%;" />
                                    }
                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => SupprimerRegle(rule))" title="Retirer cette règle" aria-label="Retirer cette règle" />
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }

        <div class="ap-dlg-footer">
            @if (currentStep > 1)
            {
                <RadzenButton Text="Précédent" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@(() => AllerStep(currentStep - 1))" />
            }
            <span class="ap-grow"></span>
            <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => DialogService.Close(null))" />
            @if (currentStep < 3)
            {
                <RadzenButton Text="Suivant" ButtonStyle="ButtonStyle.Primary" Click="@(() => AllerStep(currentStep + 1))" />
            }
            else
            {
                <RadzenButton ButtonType="ButtonType.Submit" Text="@(schedule.Id == 0 ? "Planifier le rapport" : "Enregistrer les modifications")" ButtonStyle="ButtonStyle.Primary" />
            }
        </div>
    </div>
</RadzenTemplateForm>

@code {
    private sealed record Etape(int N, string Label);
    private static readonly Etape[] Etapes = { new(1, "Envoi"), new(2, "Contenu"), new(3, "Imprimantes") };
    private int currentStep = 1;
    private bool useFilters = false;

    private static readonly System.Text.RegularExpressions.Regex EmailListRegex = new(
        @"^([a-zA-Z0-9_\-\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,5})(\s*;\s*([a-zA-Z0-9_\-\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,5}))*\s*;?\s*$",
        System.Text.RegularExpressions.RegexOptions.Compiled);

    [Parameter] public ReportSchedule ScheduleToEdit { get; set; } = null!;

    private ReportSchedule schedule = new();
    private List<string> formats = new() { "PDF", "CSV" };
    private List<string> frequencies = new() { "Quotidien", "Hebdomadaire", "Mensuel" };

    private List<int> heures = Enumerable.Range(0, 24).ToList();
    private List<int> minutes = Enumerable.Range(0, 60).ToList();
    
    private class JourSemaineOption { public int Value { get; set; } public string Label { get; set; } = ""; }
    private List<JourSemaineOption> joursSemaine = new()
    {
        new JourSemaineOption { Value = 1, Label = "Lundi" },
        new JourSemaineOption { Value = 2, Label = "Mardi" },
        new JourSemaineOption { Value = 3, Label = "Mercredi" },
        new JourSemaineOption { Value = 4, Label = "Jeudi" },
        new JourSemaineOption { Value = 5, Label = "Vendredi" },
        new JourSemaineOption { Value = 6, Label = "Samedi" },
        new JourSemaineOption { Value = 0, Label = "Dimanche" }
    };
    
    private List<int> joursMois = Enumerable.Range(1, 31).ToList();

    private string FormatHeure(int hour, int minute)
    {
        return $"{hour:D2}h{minute:D2}";
    }

    private string ObtenirNomJour(int? runDayOfWeek)
    {
        if (!runDayOfWeek.HasValue) return "lundi";
        var jour = joursSemaine.FirstOrDefault(j => j.Value == runDayOfWeek.Value);
        return jour != null ? jour.Label.ToLower() : "lundi";
    }

    private bool includePages = true;
    private bool includeToner = true;
    private bool includeTrays = true;
    private bool includeAvailability = true;
    private bool includeAlerts = true;
    private bool includePredictions = false;
    private bool includeTotalPages = true;
    private bool includeFleetSummary = true;

    private class ThresholdOption { public int Value { get; set; } public string Label { get; set; } = ""; }
    private List<ThresholdOption> thresholdOptions = new()
    {
        new ThresholdOption { Value = 3, Label = "3 jours" },
        new ThresholdOption { Value = 5, Label = "5 jours" },
        new ThresholdOption { Value = 7, Label = "7 jours" },
        new ThresholdOption { Value = 10, Label = "10 jours" },
        new ThresholdOption { Value = 14, Label = "14 jours" },
        new ThresholdOption { Value = 30, Label = "30 jours" }
    };

    private List<Emplacement> locations = new();
    private List<Marque> brands = new();
    private List<Modele> allModels = new();
    private List<SnmpProfile> snmpProfiles = new();

    private ScopeFilter scopeFilter = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            locations = await Http.GetFromJsonAsync<List<Emplacement>>("api/Emplacements") ?? new();
            brands = await Http.GetFromJsonAsync<List<Marque>>("api/Marques") ?? new();
            allModels = await Http.GetFromJsonAsync<List<Modele>>("api/Modeles") ?? new();
            snmpProfiles = await Http.GetFromJsonAsync<List<SnmpProfile>>("api/SnmpProfiles") ?? new();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", "Chargement des référentiels : " + ex.Message);
        }

        if (ScheduleToEdit != null && ScheduleToEdit.Id > 0)
        {
            schedule = new ReportSchedule
            {
                Id = ScheduleToEdit.Id,
                ReportName = ScheduleToEdit.ReportName,
                Format = ScheduleToEdit.Format,
                Frequency = ScheduleToEdit.Frequency,
                EmailRecipients = ScheduleToEdit.EmailRecipients,
                SelectedMetricsJson = ScheduleToEdit.SelectedMetricsJson,
                ScopeFilterJson = ScheduleToEdit.ScopeFilterJson,
                LastRunAt = ScheduleToEdit.LastRunAt,
                NextRunAt = ScheduleToEdit.NextRunAt,
                IsActive = ScheduleToEdit.IsActive,
                PredictionThresholdDays = ScheduleToEdit.PredictionThresholdDays,
                RunHour = ScheduleToEdit.RunHour,
                RunMinute = ScheduleToEdit.RunMinute,
                RunDayOfWeek = ScheduleToEdit.RunDayOfWeek,
                RunDayOfMonth = ScheduleToEdit.RunDayOfMonth
            };

            try
            {
                var list = JsonSerializer.Deserialize<List<string>>(schedule.SelectedMetricsJson) ?? new();
                includePages = list.Contains("Pages");
                includeToner = list.Contains("Toner");
                includeTrays = list.Contains("Trays");
                includeAvailability = list.Contains("Availability");
                includeAlerts = list.Contains("Alerts");
                includePredictions = list.Contains("Predictions");
                includeTotalPages = list.Contains("TotalPages");
                includeFleetSummary = list.Contains("FleetSummary");
            }
            catch { }

            try
            {
                var parsedScope = JsonSerializer.Deserialize<ScopeFilter>(schedule.ScopeFilterJson);
                if (parsedScope != null)
                {
                    scopeFilter = parsedScope;
                    if (scopeFilter.Rules == null)
                    {
                        scopeFilter.Rules = new List<ReportRule>();
                    }

                    // Migrate legacy format to rule format for editing on the fly
                    if (scopeFilter.Rules.Count == 0 && (scopeFilter.BrandId > 0 || scopeFilter.ModelId > 0 || scopeFilter.LocationId > 0))
                    {
                        if (scopeFilter.LocationId > 0)
                        {
                            scopeFilter.Rules.Add(new ReportRule
                            {
                                Field = "LocationId",
                                Operator = "In",
                                Values = new List<int> { scopeFilter.LocationId }
                            });
                        }
                        if (scopeFilter.BrandId > 0)
                        {
                            scopeFilter.Rules.Add(new ReportRule
                            {
                                Field = "BrandId",
                                Operator = "In",
                                Values = new List<int> { scopeFilter.BrandId }
                            });
                        }
                        if (scopeFilter.ModelId > 0)
                        {
                            scopeFilter.Rules.Add(new ReportRule
                            {
                                Field = "ModelId",
                                Operator = "In",
                                Values = new List<int> { scopeFilter.ModelId }
                            });
                        }
                    }
                }
            }
            catch { }
        }
        else
        {
            schedule = new ReportSchedule
            {
                Format = "PDF",
                Frequency = "Hebdomadaire",
                IsActive = true,
                PredictionThresholdDays = 14,
                RunHour = 8,
                RunMinute = 0,
                RunDayOfWeek = 1, // Lundi
                RunDayOfMonth = 1
            };
        }

        useFilters = scopeFilter.Rules != null && scopeFilter.Rules.Any();
    }

    private List<ChampInfo> champsDisponibles = new()
    {
        new ChampInfo { Value = "LocationId", Label = "Lieu / Emplacement" },
        new ChampInfo { Value = "BrandId", Label = "Marque" },
        new ChampInfo { Value = "ModelId", Label = "Modèle" },
        new ChampInfo { Value = "SnmpProfileId", Label = "Profil SNMP" },
        new ChampInfo { Value = "Nom", Label = "Nom de l'imprimante" },
        new ChampInfo { Value = "AdresseIp", Label = "Adresse IP" },
        new ChampInfo { Value = "Code", Label = "Code de l'imprimante" }
    };

    private List<OperateurInfo> ObtenirOperateurs(string field)
    {
        if (field == "LocationId" || field == "BrandId" || field == "ModelId" || field == "SnmpProfileId")
        {
            return new List<OperateurInfo>
            {
                new OperateurInfo { Value = "In", Label = "est l'un de" },
                new OperateurInfo { Value = "NotIn", Label = "n'est pas l'un de" }
            };
        }
        else
        {
            return new List<OperateurInfo>
            {
                new OperateurInfo { Value = "Contains", Label = "contient" },
                new OperateurInfo { Value = "Equals", Label = "est égal à" },
                new OperateurInfo { Value = "StartsWith", Label = "commence par" }
            };
        }
    }

    private void OnFieldChanged(ReportRule rule, string newField)
    {
        rule.Field = newField;
        if (newField == "LocationId" || newField == "BrandId" || newField == "ModelId" || newField == "SnmpProfileId")
        {
            rule.Operator = "In";
            rule.Values = new List<int>();
            rule.Value = null;
        }
        else
        {
            rule.Operator = "Contains";
            rule.Values = null;
            rule.Value = "";
        }
    }

    private void AjouterRegle()
    {
        if (scopeFilter.Rules == null) scopeFilter.Rules = new();
        scopeFilter.Rules.Add(new ReportRule());
    }

    private void SupprimerRegle(ReportRule rule)
    {
        if (scopeFilter.Rules != null)
        {
            scopeFilter.Rules.Remove(rule);
        }
    }

    private bool ValiderStep1()
    {
        if (string.IsNullOrWhiteSpace(schedule.ReportName) || string.IsNullOrWhiteSpace(schedule.EmailRecipients))
            return false;

        return EmailListRegex.IsMatch(schedule.EmailRecipients);
    }

    private void AllerStep(int targetStep)
    {
        if (targetStep > 1 && !ValiderStep1())
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Informations requises", "Veuillez renseigner un nom de rapport valide et au moins un destinataire correct (format e-mail).");
            return;
        }
        currentStep = targetStep;
    }

    private void SetUseFilters(bool value)
    {
        useFilters = value;
        if (!useFilters)
        {
            scopeFilter.Rules.Clear();
        }
        else if (scopeFilter.Rules.Count == 0)
        {
            AjouterRegle();
        }
    }

    private async Task OnSubmit()
    {
        var metrics = new List<string>();
        if (includePages) metrics.Add("Pages");
        if (includeToner) metrics.Add("Toner");
        if (includeTrays) metrics.Add("Trays");
        if (includeAvailability) metrics.Add("Availability");
        if (includeAlerts) metrics.Add("Alerts");
        if (includePredictions) metrics.Add("Predictions");
        if (includeTotalPages) metrics.Add("TotalPages");
        if (includeFleetSummary) metrics.Add("FleetSummary");

        schedule.SelectedMetricsJson = JsonSerializer.Serialize(metrics);

        if (!useFilters)
        {
            scopeFilter.Rules = new List<ReportRule>();
            scopeFilter.LocationId = 0;
            scopeFilter.BrandId = 0;
            scopeFilter.ModelId = 0;
        }
        else if (scopeFilter.Rules != null && scopeFilter.Rules.Any())
        {
            var locRule = scopeFilter.Rules.FirstOrDefault(r => r.Field == "LocationId" && r.Operator == "In");
            scopeFilter.LocationId = (locRule != null && locRule.Values != null && locRule.Values.Any()) ? locRule.Values.First() : 0;

            var brandRule = scopeFilter.Rules.FirstOrDefault(r => r.Field == "BrandId" && r.Operator == "In");
            scopeFilter.BrandId = (brandRule != null && brandRule.Values != null && brandRule.Values.Any()) ? brandRule.Values.First() : 0;

            var modelRule = scopeFilter.Rules.FirstOrDefault(r => r.Field == "ModelId" && r.Operator == "In");
            scopeFilter.ModelId = (modelRule != null && modelRule.Values != null && modelRule.Values.Any()) ? modelRule.Values.First() : 0;
        }

        schedule.ScopeFilterJson = JsonSerializer.Serialize(scopeFilter);

        try
        {
            HttpResponseMessage response;
            if (schedule.Id > 0)
            {
                response = await Http.PutAsJsonAsync($"api/ReportSchedules/{schedule.Id}", schedule);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/ReportSchedules", schedule);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Enregistré", "La planification du rapport a été enregistrée.");
                DialogService.Close(true);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
    }

    private class ScopeFilter
    {
        public int BrandId { get; set; }
        public int ModelId { get; set; }
        public int LocationId { get; set; }
        public List<ReportRule> Rules { get; set; } = new();
    }

