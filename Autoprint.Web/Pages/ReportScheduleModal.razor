@using Autoprint.Shared
@using System.Text.Json
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="ReportSchedule" Data="@schedule" Submit="@OnSubmit">
    <RadzenStack Gap="1.5rem" Class="rz-p-2">
        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="Nom du Rapport" Component="ReportName" Style="font-weight: bold;" />
                <RadzenTextBox Name="ReportName" @bind-Value="@schedule.ReportName" Style="width: 100%;" Placeholder="Ex: Rapport Hebdo HP" />
                <RadzenRequiredValidator Component="ReportName" Text="Le nom est obligatoire" Popup="true" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="Format de Fichier" Component="Format" Style="font-weight: bold;" />
                <RadzenDropDown Name="Format" @bind-Value="@schedule.Format" Data="@formats" Style="width: 100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="Fréquence" Component="Frequency" Style="font-weight: bold;" />
                <RadzenDropDown Name="Frequency" @bind-Value="@schedule.Frequency" Data="@frequencies" Style="width: 100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="Destinataires (Séparés par ;)" Component="EmailRecipients" Style="font-weight: bold;" />
                <RadzenTextBox Name="EmailRecipients" @bind-Value="@schedule.EmailRecipients" Style="width: 100%;" Placeholder="admin@corp.com; manager@corp.com" />
                <RadzenRequiredValidator Component="EmailRecipients" Text="Au moins un destinataire est requis" Popup="true" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenCard Variant="Variant.Flat" Class="rz-p-3" Style="background-color: var(--rz-background-color-panel);">
            <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;" Class="rz-mb-2">📊 Métriques à inclure</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Wrap="FlexWrap.Wrap">
                <div style="display: flex; align-items: center;">
                    <RadzenCheckBox TValue="bool" @bind-Value="@includePages" Name="Pages" />
                    <RadzenLabel Text="Compteur de pages" Component="Pages" Class="rz-ml-2" Style="cursor:pointer;" />
                </div>
                <div style="display: flex; align-items: center;">
                    <RadzenCheckBox TValue="bool" @bind-Value="@includeToner" Name="Toner" />
                    <RadzenLabel Text="Niveaux des consommables (Toner)" Component="Toner" Class="rz-ml-2" Style="cursor:pointer;" />
                </div>
                <div style="display: flex; align-items: center;">
                    <RadzenCheckBox TValue="bool" @bind-Value="@includeAvailability" Name="Availability" />
                    <RadzenLabel Text="Taux de disponibilité (Ping)" Component="Availability" Class="rz-ml-2" Style="cursor:pointer;" />
                </div>
                <div style="display: flex; align-items: center;">
                    <RadzenCheckBox TValue="bool" @bind-Value="@includeAlerts" Name="Alerts" />
                    <RadzenLabel Text="Pannes & Alertes" Component="Alerts" Class="rz-ml-2" Style="cursor:pointer;" />
                </div>
            </RadzenStack>
        </RadzenCard>

        <RadzenCard Variant="Variant.Flat" Class="rz-p-3" Style="background-color: var(--rz-background-color-panel);">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-3">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">🎯 Périmètre du Rapport (Filtres No-Code)</RadzenText>
                <RadzenButton Icon="add" Text="Ajouter un filtre" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Click="@AjouterRegle" />
            </RadzenStack>

            @if (scopeFilter.Rules == null || scopeFilter.Rules.Count == 0)
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
                    Aucun filtre défini. Le rapport s'appliquera sur l'ensemble du parc d'imprimantes.
                </RadzenAlert>
            }
            else
            {
                <RadzenStack Gap="0.75rem">
                    @foreach (var rule in scopeFilter.Rules)
                    {
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.5rem" Style="background: var(--rz-background-color-content); padding: 8px; border-radius: 4px; border: 1px solid var(--rz-border-color);">
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenDropDown TValue="string" Value="@rule.Field" ValueChanged="@((val) => OnFieldChanged(rule, val))"
                                                Data="@champsDisponibles" TextProperty="Label" ValueProperty="Value"
                                                Style="width: 100%;" />
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="2">
                                <RadzenDropDown TValue="string" @bind-Value="@rule.Operator"
                                                Data="@ObtenirOperateurs(rule.Field)" TextProperty="Label" ValueProperty="Value"
                                                Style="width: 100%;" />
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="6">
                                @if (rule.Field == "LocationId")
                                {
                                    <RadzenDropDown TValue="List<int>" @bind-Value="@rule.Values"
                                                    Data="@locations" TextProperty="Nom" ValueProperty="Id"
                                                    Placeholder="Sélectionner les lieux..." Style="width: 100%;"
                                                    Multiple="true" AllowFiltering="true" FilterCaseSensitive="false"
                                                    SelectAllText="Sélectionner tout" MaxSelectedLabels="3" />
                                }
                                else if (rule.Field == "BrandId")
                                {
                                    <RadzenDropDown TValue="List<int>" @bind-Value="@rule.Values"
                                                    Data="@brands" TextProperty="Nom" ValueProperty="Id"
                                                    Placeholder="Sélectionner les marques..." Style="width: 100%;"
                                                    Multiple="true" AllowFiltering="true" FilterCaseSensitive="false"
                                                    SelectAllText="Sélectionner tout" MaxSelectedLabels="3" />
                                }
                                else if (rule.Field == "ModelId")
                                {
                                    <RadzenDropDown TValue="List<int>" @bind-Value="@rule.Values"
                                                    Data="@allModels" TextProperty="Nom" ValueProperty="Id"
                                                    Placeholder="Sélectionner les modèles..." Style="width: 100%;"
                                                    Multiple="true" AllowFiltering="true" FilterCaseSensitive="false"
                                                    SelectAllText="Sélectionner tout" MaxSelectedLabels="3" />
                                }
                                else
                                {
                                    <RadzenTextBox @bind-Value="@rule.Value" Placeholder="Entrez une valeur..." Style="width: 100%;" />
                                }
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="1" Style="text-align: center;">
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Variant="Variant.Text" Click="@(() => SupprimerRegle(rule))" Tooltip="Supprimer ce filtre" title="Supprimer ce filtre" />
                            </RadzenColumn>
                        </RadzenRow>
                    }
                </RadzenStack>
            }
        </RadzenCard>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-4">
            <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(null))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Enregistrer" Icon="save" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public ReportSchedule ScheduleToEdit { get; set; } = null!;

    private ReportSchedule schedule = new();
    private List<string> formats = new() { "PDF", "CSV" };
    private List<string> frequencies = new() { "Quotidien", "Hebdomadaire", "Mensuel" };

    private bool includePages = true;
    private bool includeToner = true;
    private bool includeAvailability = true;
    private bool includeAlerts = true;

    private List<Emplacement> locations = new();
    private List<Marque> brands = new();
    private List<Modele> allModels = new();
    private List<Modele> filteredModels = new();

    private ScopeFilter scopeFilter = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            locations = await Http.GetFromJsonAsync<List<Emplacement>>("api/Emplacements") ?? new();
            brands = await Http.GetFromJsonAsync<List<Marque>>("api/Marques") ?? new();
            allModels = await Http.GetFromJsonAsync<List<Modele>>("api/Modeles") ?? new();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", "Chargement des référentiels : " + ex.Message);
        }

        if (ScheduleToEdit != null && ScheduleToEdit.Id > 0)
        {
            schedule = new ReportSchedule
            {
                Id = ScheduleToEdit.Id,
                ReportName = ScheduleToEdit.ReportName,
                Format = ScheduleToEdit.Format,
                Frequency = ScheduleToEdit.Frequency,
                EmailRecipients = ScheduleToEdit.EmailRecipients,
                SelectedMetricsJson = ScheduleToEdit.SelectedMetricsJson,
                ScopeFilterJson = ScheduleToEdit.ScopeFilterJson,
                LastRunAt = ScheduleToEdit.LastRunAt,
                NextRunAt = ScheduleToEdit.NextRunAt
            };

            try
            {
                var list = JsonSerializer.Deserialize<List<string>>(schedule.SelectedMetricsJson) ?? new();
                includePages = list.Contains("Pages");
                includeToner = list.Contains("Toner");
                includeAvailability = list.Contains("Availability");
                includeAlerts = list.Contains("Alerts");
            }
            catch { }

            try
            {
                var parsedScope = JsonSerializer.Deserialize<ScopeFilter>(schedule.ScopeFilterJson);
                if (parsedScope != null)
                {
                    scopeFilter = parsedScope;
                    if (scopeFilter.Rules == null)
                    {
                        scopeFilter.Rules = new List<ReportRule>();
                    }

                    // Migrate legacy format to rule format for editing on the fly
                    if (scopeFilter.Rules.Count == 0 && (scopeFilter.BrandId > 0 || scopeFilter.ModelId > 0 || scopeFilter.LocationId > 0))
                    {
                        if (scopeFilter.LocationId > 0)
                        {
                            scopeFilter.Rules.Add(new ReportRule
                            {
                                Field = "LocationId",
                                Operator = "In",
                                Values = new List<int> { scopeFilter.LocationId }
                            });
                        }
                        if (scopeFilter.BrandId > 0)
                        {
                            scopeFilter.Rules.Add(new ReportRule
                            {
                                Field = "BrandId",
                                Operator = "In",
                                Values = new List<int> { scopeFilter.BrandId }
                            });
                        }
                        if (scopeFilter.ModelId > 0)
                        {
                            scopeFilter.Rules.Add(new ReportRule
                            {
                                Field = "ModelId",
                                Operator = "In",
                                Values = new List<int> { scopeFilter.ModelId }
                            });
                        }
                    }
                }
            }
            catch { }
        }
        else
        {
            schedule = new ReportSchedule
            {
                Format = "PDF",
                Frequency = "Hebdomadaire"
            };
        }
    }

    private List<ChampInfo> champsDisponibles = new()
    {
        new ChampInfo { Value = "LocationId", Label = "Lieu / Emplacement" },
        new ChampInfo { Value = "BrandId", Label = "Marque" },
        new ChampInfo { Value = "ModelId", Label = "Modèle" },
        new ChampInfo { Value = "Nom", Label = "Nom de l'imprimante" },
        new ChampInfo { Value = "AdresseIp", Label = "Adresse IP" },
        new ChampInfo { Value = "Code", Label = "Code de l'imprimante" }
    };

    private List<OperateurInfo> ObtenirOperateurs(string field)
    {
        if (field == "LocationId" || field == "BrandId" || field == "ModelId")
        {
            return new List<OperateurInfo>
            {
                new OperateurInfo { Value = "In", Label = "est l'un de" },
                new OperateurInfo { Value = "NotIn", Label = "n'est pas l'un de" }
            };
        }
        else
        {
            return new List<OperateurInfo>
            {
                new OperateurInfo { Value = "Contains", Label = "contient" },
                new OperateurInfo { Value = "Equals", Label = "est égal à" },
                new OperateurInfo { Value = "StartsWith", Label = "commence par" }
            };
        }
    }

    private void OnFieldChanged(ReportRule rule, string newField)
    {
        rule.Field = newField;
        if (newField == "LocationId" || newField == "BrandId" || newField == "ModelId")
        {
            rule.Operator = "In";
            rule.Values = new List<int>();
            rule.Value = null;
        }
        else
        {
            rule.Operator = "Contains";
            rule.Values = null;
            rule.Value = "";
        }
    }

    private void AjouterRegle()
    {
        if (scopeFilter.Rules == null) scopeFilter.Rules = new();
        scopeFilter.Rules.Add(new ReportRule());
    }

    private void SupprimerRegle(ReportRule rule)
    {
        if (scopeFilter.Rules != null)
        {
            scopeFilter.Rules.Remove(rule);
        }
    }

    private async Task OnSubmit()
    {
        var metrics = new List<string>();
        if (includePages) metrics.Add("Pages");
        if (includeToner) metrics.Add("Toner");
        if (includeAvailability) metrics.Add("Availability");
        if (includeAlerts) metrics.Add("Alerts");

        schedule.SelectedMetricsJson = JsonSerializer.Serialize(metrics);

        // Keep legacy fields consistent with the first rule (if any) for safety
        if (scopeFilter.Rules != null && scopeFilter.Rules.Any())
        {
            var locRule = scopeFilter.Rules.FirstOrDefault(r => r.Field == "LocationId" && r.Operator == "In");
            scopeFilter.LocationId = (locRule != null && locRule.Values != null && locRule.Values.Any()) ? locRule.Values.First() : 0;

            var brandRule = scopeFilter.Rules.FirstOrDefault(r => r.Field == "BrandId" && r.Operator == "In");
            scopeFilter.BrandId = (brandRule != null && brandRule.Values != null && brandRule.Values.Any()) ? brandRule.Values.First() : 0;

            var modelRule = scopeFilter.Rules.FirstOrDefault(r => r.Field == "ModelId" && r.Operator == "In");
            scopeFilter.ModelId = (modelRule != null && modelRule.Values != null && modelRule.Values.Any()) ? modelRule.Values.First() : 0;
        }

        schedule.ScopeFilterJson = JsonSerializer.Serialize(scopeFilter);

        try
        {
            HttpResponseMessage response;
            if (schedule.Id > 0)
            {
                response = await Http.PutAsJsonAsync($"api/ReportSchedules/{schedule.Id}", schedule);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/ReportSchedules", schedule);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Enregistré", "La planification du rapport a été enregistrée.");
                DialogService.Close(true);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
    }

    private class ScopeFilter
    {
        public int BrandId { get; set; }
        public int ModelId { get; set; }
        public int LocationId { get; set; }
        public List<ReportRule> Rules { get; set; } = new();
    }

    private class ReportRule
    {
        public string Field { get; set; } = "LocationId";
        public string Operator { get; set; } = "In";
        public List<int>? Values { get; set; } = new();
        public string? Value { get; set; } = "";
    }

    private class ChampInfo
    {
        public string Value { get; set; } = "";
        public string Label { get; set; } = "";
    }

    private class OperateurInfo
    {
        public string Value { get; set; } = "";
        public string Label { get; set; } = "";
    }
}
