@page "/"
@using Autoprint.Shared.DTOs
@using Autoprint.Shared
@using Autoprint.Web.Services
@using Radzen
@using Radzen.Blazor
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@inject NavigationManager NavManager
@inject CustomAuthStateProvider AuthProvider

<PageTitle>Tableau de bord</PageTitle>

@* Charte B77, maquette « Tableau de bord » : bandeau d'état du service, 5 indicateurs, barre empilée par modèle, activités *@
<div class="ap-page-header">
    <div class="ap-titles">
        <h1>Tableau de bord</h1>
        @if (lastRefresh != null)
        {
            <span class="ap-sub">Mis à jour à @lastRefresh.Value.ToString("HH:mm")</span>
        }
    </div>
    <span class="ap-grow"></span>
    <RadzenButton Icon="refresh" Text="Actualiser" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@ChargerDonnees" IsBusy="@isLoading" />
</div>

@if (isLoading && stats == null)
{
    <RadzenSkeleton Width="100%" Height="56px" Style="border-radius: var(--ap-r-xl); margin-bottom: var(--ap-s4);" />
    <div class="ap-kpis">
        @for (int i = 0; i < 5; i++)
        {
            <RadzenSkeleton Width="100%" Height="104px" Style="border-radius: var(--ap-r-xl);" />
        }
    </div>
    <div class="ap-dash-grid">
        <RadzenSkeleton Width="100%" Height="360px" Style="border-radius: var(--ap-r-xl);" />
        <RadzenSkeleton Width="100%" Height="360px" Style="border-radius: var(--ap-r-xl);" />
    </div>
}
else if (stats != null)
{
    <section class="ap-service" aria-label="État du service">
        <span class="ap-svc">
            @StatusBadge(stats.IsSpoolerRunning)
            <b>Spouleur Windows</b>
        </span>
        @if (stats.IsSpoolerServiceRunning.HasValue)
        {
            <span class="ap-sep"></span>
            <span class="ap-svc" title="@(stats.IsSpoolerServiceRunning.Value ? null : "Les modifications des files d'impression ne sont plus appliquées : démarrez le service sur le serveur (services.msc).")">
                @StatusBadge(stats.IsSpoolerServiceRunning.Value)
                <b>Service AutoprintSpooler</b>
            </span>
        }
        <span class="ap-sep"></span>
        @if (stats.SyncErrorCount > 0)
        {
            <a class="ap-svc ap-link" @onclick="@(() => NavManager.NavigateTo("imprimantes"))">
                Erreurs de synchronisation <span class="ap-status-badge ap-status-badge--offline"><RadzenIcon Icon="error" />@stats.SyncErrorCount</span>
            </a>
        }
        else
        {
            <span class="ap-svc">Erreurs de synchronisation <b class="ap-mono">0</b></span>
        }
        <span class="ap-grow"></span>
        <span class="ap-svc">Version du serveur <span class="ap-label-tag">@stats.ServerVersion</span></span>
    </section>

    <div class="ap-kpis">
        <div class="ap-kpi-card">
            <span class="ap-kpi-label"><RadzenIcon Icon="print" />Parc actif</span>
            <span class="ap-kpi-value">@stats.TotalImprimantes</span>
        </div>
        <div class="ap-kpi-card">
            <span class="ap-kpi-label"><RadzenIcon Icon="developer_board" />Pilotes</span>
            <span class="ap-kpi-value">@stats.TotalPilotes</span>
        </div>
        <div class="ap-kpi-card">
            <span class="ap-kpi-label"><RadzenIcon Icon="location_on" />Lieux</span>
            <span class="ap-kpi-value">@stats.TotalLieux</span>
        </div>
        @* Couleur seulement si une action est requise *@
        <div class="@($"ap-kpi-card is-link{(stats.OfflinePrintersCount > 0 ? " ap-kpi-card--danger" : "")}")" @onclick="@(() => NavManager.NavigateTo("imprimantes"))" role="link">
            <span class="ap-kpi-label"><RadzenIcon Icon="cloud_off" />Imprimantes hors ligne</span>
            <span class="ap-kpi-value">@stats.OfflinePrintersCount</span>
        </div>
        <div class="@($"ap-kpi-card is-link{(stats.AlertPrintersCount > 0 ? " ap-kpi-card--warning" : "")}")" @onclick="@(() => NavManager.NavigateTo("imprimantes"))" role="link">
            <span class="ap-kpi-label"><RadzenIcon Icon="warning" />Alertes actives</span>
            <span class="ap-kpi-value">@stats.AlertPrintersCount</span>
            <span class="ap-kpi-sub">toner bas, erreurs</span>
        </div>
    </div>

    <div class="ap-dash-grid" style="@(canReadAudit ? null : "grid-template-columns: minmax(0, 1fr);")">
        <section class="ap-card">
            <div class="ap-card-head">
                <h2>Répartition par modèle</h2>
                <span class="ap-grow"></span>
                <a class="ap-link" @onclick="@(() => NavManager.NavigateTo("imprimantes"))">Voir le parc<RadzenIcon Icon="chevron_right" /></a>
            </div>
            <div class="ap-card-body">
                @if (shares.Any())
                {
                    <div class="ap-total"><b>@stats.TotalImprimantes</b><span>imprimante@(Plural(stats.TotalImprimantes)), @stats.RepartitionModeles.Count modèle@(Plural(stats.RepartitionModeles.Count))</span></div>
                    <div class="ap-share-bar" role="img" aria-label="@($"Répartition des {stats.TotalImprimantes} imprimantes par modèle")">
                        @foreach (var s in shares)
                        {
                            <i class="@s.Css" style="width: @(s.Percent.ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></i>
                        }
                    </div>
                    <ul class="ap-models">
                        @foreach (var s in shares)
                        {
                            <li><i class="ap-dot @s.Css"></i><span>@s.Label</span><span class="ap-n">@s.Count</span><span class="ap-p">@Math.Round(s.Percent) %</span></li>
                        }
                    </ul>
                }
                else
                {
                    <div class="ap-empty"><RadzenIcon Icon="bar_chart" /><strong>Aucune imprimante</strong>La répartition s'affichera dès qu'une imprimante sera créée.</div>
                }
            </div>
        </section>

        @if (canReadAudit)
        {
            <section class="ap-card">
                <div class="ap-card-head">
                    <h2>Dernières activités</h2>
                    <span class="ap-grow"></span>
                    <a class="ap-link" @onclick="@(() => NavManager.NavigateTo("audit"))">Journal d'audit<RadzenIcon Icon="chevron_right" /></a>
                </div>
                <div class="ap-card-body">
                    @if (recentLogs == null || !recentLogs.Any())
                    {
                        <div class="ap-empty"><RadzenIcon Icon="history" /><strong>Aucune activité récente</strong></div>
                    }
                    else
                    {
                        <ul class="ap-activity">
                            @foreach (var log in recentLogs)
                            {
                                <li>
                                    <RadzenIcon Icon="@ActivityIcon(log.Action)" />
                                    <div title="@log.ActionLisible">@log.ActionLisible<small>@log.Utilisateur</small></div>
                                    <time>@GetTimeAgo(log.DateAction)</time>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }
    </div>
}
@code {
    private DashboardStatsDto? stats;
    private List<AuditLogDto>? recentLogs;
    private bool isLoading = true;
    private bool canReadAudit = false;

    private DateTime? lastRefresh;
    private List<ModelShare> shares = new();

    private sealed record ModelShare(string Label, int Count, double Percent, string Css);

    protected override async Task OnInitializedAsync()
    {
        await ChargerDonnees();
    }

    private async Task ChargerDonnees()
    {
        isLoading = true;
        try
        {
            canReadAudit = await AuthProvider.HasPermission("Permission", "AUDIT_READ");

            var t1 = Http.GetFromJsonAsync<DashboardStatsDto>("api/Dashboard");

            Task<PaginatedList<AuditLogDto>>? t2 = null;
            if (canReadAudit) t2 = Http.GetFromJsonAsync<PaginatedList<AuditLogDto>>("api/Audit?page=1&pageSize=5")!;

            await Task.WhenAll(t1);
            if (t2 != null) await t2;

            stats = t1.Result;
            recentLogs = (t2 != null && t2.Result != null) ? t2.Result.Items : new List<AuditLogDto>();
            shares = BuildShares();
            lastRefresh = DateTime.Now;
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur Dashboard : " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    // Barre empilée : les 5 modèles les plus présents, puis « N autres modèles » (couleur neutre de la palette)
    private List<ModelShare> BuildShares()
    {
        if (stats == null || stats.RepartitionModeles == null) return new();
        var items = stats.RepartitionModeles.Where(r => r.Value > 0).OrderByDescending(r => r.Value).ToList();
        double total = items.Sum(r => (double)r.Value);
        if (total <= 0) return new();
        var result = items.Take(5).Select((r, i) => new ModelShare(r.Label, (int)r.Value, r.Value * 100.0 / total, $"ap-series-{i + 1}")).ToList();
        var others = items.Skip(5).ToList();
        if (others.Count > 0)
        {
            int n = (int)others.Sum(r => r.Value);
            result.Add(new ModelShare($"{others.Count} autre{Plural(others.Count)} modèle{Plural(others.Count)}", n, n * 100.0 / total, "ap-series-8"));
        }
        return result;
    }

    private static string Plural(int n) => n > 1 ? "s" : "";

    private static string ActivityIcon(string action) =>
        action.Contains("SYNC") ? "sync"
        : action.Contains("CREATE") || action.Contains("ADD") ? "add"
        : action.Contains("DELETE") || action.Contains("DEL") ? "delete"
        : action.Contains("UPDATE") ? "edit"
        : action.Contains("KEY") ? "key"
        : "info";

    private RenderFragment StatusBadge(bool online) => online
        ? @<span class="ap-status-badge ap-status-badge--online"><RadzenIcon Icon="check_circle" />En ligne</span>
        : @<span class="ap-status-badge ap-status-badge--offline"><RadzenIcon Icon="cancel" />Arrêté</span>;

    private string GetTimeAgo(DateTime date)
    {
        // Dates enregistrées en UTC et renvoyées sans fuseau (Kind non spécifié) : ToUniversalTime() les prenait pour
        // de l'heure locale (« 1 h » pour une action d'il y a quelques minutes en hiver) (B58)
        var utc = date.Kind switch
        {
            DateTimeKind.Utc => date,
            DateTimeKind.Local => date.ToUniversalTime(),
            _ => DateTime.SpecifyKind(date, DateTimeKind.Utc)
        };
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "À l'instant";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} h";
        return date.ToLocalTime().ToString("dd/MM");
    }
}