@using Autoprint.Shared
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="SnmpProfile" Data="@profileEdit" Submit="@OnSubmit">
    <RadzenStack Gap="1rem">
        <div>
            <RadzenLabel Text="Nom du Profil" Component="Name" />
            <RadzenTextBox Name="Name" @bind-Value="@profileEdit.Name" Style="width: 100%;" Placeholder="Ex: Standard HP LaserJet" />
            <RadzenRequiredValidator Component="Name" Text="Le nom est obligatoire" Popup="true" />
        </div>

        <div>
            <RadzenLabel Text="OID Compteur de Pages" Component="OidPageCounter" />
            <RadzenTextBox Name="OidPageCounter" @bind-Value="@profileEdit.OidPageCounter" Style="width: 100%;" Placeholder="Ex: 1.3.6.1.2.1.43.10.2.1.4.1.1" />
        </div>

        <RadzenFieldset Text="OIDs Consommables / Toners (Optionnel)">
            <RadzenStack Gap="0.5rem">
                <div>
                    <RadzenLabel Text="Toner Noir (K)" Component="OidTonerBlack" />
                    <RadzenTextBox Name="OidTonerBlack" @bind-Value="@profileEdit.OidTonerBlack" Style="width: 100%;" Placeholder="Ex: 1.3.6.1.2.1.43.11.1.1.9.1.1" />
                </div>
                <div>
                    <RadzenLabel Text="Toner Cyan (C)" Component="OidTonerCyan" />
                    <RadzenTextBox Name="OidTonerCyan" @bind-Value="@profileEdit.OidTonerCyan" Style="width: 100%;" Placeholder="Ex: 1.3.6.1.2.1.43.11.1.1.9.1.2" />
                </div>
                <div>
                    <RadzenLabel Text="Toner Magenta (M)" Component="OidTonerMagenta" />
                    <RadzenTextBox Name="OidTonerMagenta" @bind-Value="@profileEdit.OidTonerMagenta" Style="width: 100%;" Placeholder="Ex: 1.3.6.1.2.1.43.11.1.1.9.1.3" />
                </div>
                <div>
                    <RadzenLabel Text="Toner Jaune (Y)" Component="OidTonerYellow" />
                    <RadzenTextBox Name="OidTonerYellow" @bind-Value="@profileEdit.OidTonerYellow" Style="width: 100%;" Placeholder="Ex: 1.3.6.1.2.1.43.11.1.1.9.1.4" />
                </div>
            </RadzenStack>
        </RadzenFieldset>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Class="rz-mt-4">
            @if (profileEdit.Id != 0)
            {
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Text="Supprimer" Click="@OnDelete" />
            }
            else
            {
                <div></div>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
                <RadzenButton ButtonType="ButtonType.Submit" Text="Enregistrer" Icon="save" ButtonStyle="ButtonStyle.Primary" />
            </RadzenStack>
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public SnmpProfile ProfileToEdit { get; set; } = new();

    private SnmpProfile profileEdit = new();

    protected override void OnInitialized()
    {
        profileEdit = new SnmpProfile
        {
            Id = ProfileToEdit.Id,
            Name = ProfileToEdit.Name,
            OidTonerBlack = ProfileToEdit.OidTonerBlack,
            OidTonerCyan = ProfileToEdit.OidTonerCyan,
            OidTonerMagenta = ProfileToEdit.OidTonerMagenta,
            OidTonerYellow = ProfileToEdit.OidTonerYellow,
            OidPageCounter = ProfileToEdit.OidPageCounter
        };
    }

    private async Task OnSubmit()
    {
        try
        {
            if (profileEdit.Id == 0)
            {
                await Http.PostAsJsonAsync("api/SnmpProfiles", profileEdit);
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Profil SNMP créé.");
            }
            else
            {
                await Http.PutAsJsonAsync($"api/SnmpProfiles/{profileEdit.Id}", profileEdit);
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Profil SNMP mis à jour.");
            }
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
    }

    private async Task OnDelete()
    {
        var confirm = await DialogService.Confirm("Supprimer ce profil SNMP ?", "Suppression",
            new ConfirmOptions() { OkButtonText = "Oui", CancelButtonText = "Non" });

        if (confirm == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/SnmpProfiles/{profileEdit.Id}");
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Supprimé", "Le profil a été supprimé.");
                    DialogService.Close(true);
                }
                else
                {
                    var msg = await response.Content.ReadAsStringAsync();
                    NotificationService.Notify(NotificationSeverity.Error, "Erreur", msg);
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
            }
        }
    }
}
