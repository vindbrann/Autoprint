@page "/reset-password"
@layout Autoprint.Web.Layout.EmptyLayout
@using Autoprint.Shared
@using Autoprint.Shared.DTOs
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

@* Page ouverte depuis le lien reçu par e-mail (« Mot de passe oublié », backlog B5) *@
<div style="display: flex; justify-content: center; align-items: center; min-height: 100vh;">
    <RadzenCard Style="width: 420px; max-width: 95vw;">
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H5" Class="rz-mb-0">Nouveau mot de passe</RadzenText>

            @if (string.IsNullOrEmpty(token))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
                    Lien incomplet. Utilisez le lien reçu par e-mail ou faites une nouvelle demande depuis la page de connexion.
                </RadzenAlert>
            }
            else if (done)
            {
                <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" AllowClose="false">
                    Mot de passe modifié. Vous pouvez vous connecter.
                </RadzenAlert>
            }
            else
            {
                <RadzenTemplateForm TItem="ResetPasswordDto" Data="@model" Submit="@Submit">
                    <RadzenStack Gap="0.75rem">
                        <div>
                            <RadzenLabel Text="Nouveau mot de passe" Component="NewPwd" />
                            <RadzenPassword Name="NewPwd" @bind-Value="@model.NewPassword" Style="width: 100%;" AutoComplete="false" />
                            <RadzenLengthValidator Component="NewPwd" Min="@PasswordPolicy.MinLength" Text="@PasswordPolicy.MinLengthMessage" Popup="false" />
                        </div>
                        <div>
                            <RadzenLabel Text="Confirmation" Component="ConfirmPwd" />
                            <RadzenPassword Name="ConfirmPwd" @bind-Value="@model.ConfirmPassword" Style="width: 100%;" AutoComplete="false" />
                            <RadzenCompareValidator Component="ConfirmPwd" Value="@model.NewPassword" Text="La confirmation ne correspond pas" Popup="false" />
                        </div>
                        @if (!string.IsNullOrEmpty(error))
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Size="AlertSize.Small" AllowClose="false">@error</RadzenAlert>
                        }
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Enregistrer" Icon="lock_reset" IsBusy="@busy" />
                    </RadzenStack>
                </RadzenTemplateForm>
            }

            <RadzenButton Text="Retour à la connexion" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Click="@(() => NavigationManager.NavigateTo("/login"))" />
        </RadzenStack>
    </RadzenCard>
</div>

@code {
    private readonly ResetPasswordDto model = new();
    private string? token;
    private bool busy;
    private bool done;
    private string? error;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        token = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var t) ? t.ToString() : null;
        model.Token = token ?? "";
    }

    private async Task Submit()
    {
        busy = true;
        error = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/reset-password", model);
            if (response.IsSuccessStatusCode)
            {
                // Le jeton est à usage unique : il est invalidé par le serveur dès maintenant
                done = true;
            }
            else
            {
                error = await response.Content.ReadAsStringAsync();
            }
        }
        catch
        {
            error = "Impossible de contacter le serveur.";
        }
        finally
        {
            busy = false;
        }
    }
}
