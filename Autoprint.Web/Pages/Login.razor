@page "/login"
@layout Autoprint.Web.Layout.EmptyLayout
@using Autoprint.Shared
@using Autoprint.Shared.DTOs
@using Autoprint.Web.Services
@using Autoprint.Web.Services
@using Radzen
@using Radzen.Blazor
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IJSRuntime JS
@inject ILocalStorageService LocalStorage
@inject DialogService DialogService
@inject NotificationService NotificationService

@* Charte B77, maquette « Connexion » : carte centrée sur le fond de page *@
<main class="ap-login">

    <div class="ap-login-card">

        <div class="ap-login-head">
            <div class="ap-login-brand"><img src="images/autoprint-symbole.svg" alt="" />Autoprint</div>
            <h1 class="ap-login-title">@(forgotPasswordMode ? "Mot de passe oublié" : "Connexion")</h1>
            <p class="ap-login-lead">Console d'administration du serveur d'impression</p>
        </div>

        @if (!string.IsNullOrEmpty(InfoMessage) && string.IsNullOrEmpty(ErrorMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" Class="rz-mb-4">@InfoMessage</RadzenAlert>
        }

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <RadzenAlert AlertStyle="@(ErrorMessage.Contains("droit") ? AlertStyle.Warning : AlertStyle.Danger)"
                         Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" Class="rz-mb-4">
                @ErrorMessage
            </RadzenAlert>
        }

        @if (!forgotPasswordMode)
        {
            <RadzenTemplateForm Data="@loginRequest" Submit="@HandleLogin" TItem="LoginRequest">
                <RadzenStack Gap="1rem">

                    <div>
                        <RadzenLabel Text="Identifiant" Component="Username" Style="margin-bottom: 0.25rem; color: var(--rz-text-color);" />
                        <RadzenTextBox Name="Username" @bind-Value="@loginRequest.Username" Style="width: 100%;" Placeholder="Entrez votre identifiant" />
                        <RadzenRequiredValidator Component="Username" Text="Identifiant requis" Popup="true" />
                    </div>

                    <div>
                        <RadzenLabel Text="Mot de passe" Component="Password" Style="margin-bottom: 0.25rem; color: var(--rz-text-color);" />
                        <RadzenPassword Name="Password" @bind-Value="@loginRequest.Password" Style="width: 100%;" Placeholder="Entrez votre mot de passe" />
                        <RadzenRequiredValidator Component="Password" Text="Mot de passe requis" Popup="true" />
                    </div>

                    <a class="ap-link" style="align-self: flex-end;" href="javascript:void(0)" @onclick="@(() => forgotPasswordMode = true)" @onclick:preventDefault>Mot de passe oublié</a>

                    <RadzenButton ButtonType="ButtonType.Submit" Text="Se connecter" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" IsBusy="@isBusy" Style="width: 100%;" />

                </RadzenStack>
            </RadzenTemplateForm>
        }
        else
        {
            <p class="ap-help" style="margin: 0;">Entrez votre identifiant ou votre adresse e-mail. Si le compte existe, vous recevrez un lien temporaire.</p>

            <RadzenTextBox @bind-Value="forgotEmailOrUser" Placeholder="Identifiant ou adresse e-mail" Style="width: 100%; margin-bottom: 1rem;" />

            <RadzenStack Gap="0.5rem">
                <RadzenButton Text="Envoyer la demande" ButtonStyle="ButtonStyle.Primary" Click="@HandleForgotPassword" IsBusy="@isBusy" />
                <RadzenButton Text="Retour à la connexion" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => forgotPasswordMode = false)" />
            </RadzenStack>
        }

    </div>

    <div class="ap-login-foot"><RadzenIcon Icon="lock" Style="font-size: 16px;" />Compte local ou Active Directory</div>
</main>

@code {
    private LoginRequest loginRequest = new LoginRequest();
    private string ErrorMessage = string.Empty;
    private string InfoMessage = string.Empty;
    private bool isBusy = false;
    private bool forgotPasswordMode = false;
    private string forgotEmailOrUser = "";

    protected override async Task OnInitializedAsync()
    {
        // « Retenir l'identifiant » a été retiré (audit #10) : on efface l'identifiant mémorisé par les versions précédentes
        await LocalStorage.RemoveItemAsync("saved_username");

        // Déconnexion automatique après inactivité (B35) : on en donne la raison
        var reason = await LocalStorage.GetItemAsync<string>(CustomAuthStateProvider.LogoutReasonKey);
        if (reason?.StartsWith("idle:") == true)
        {
            var minutes = reason[5..];
            InfoMessage = $"Session fermée après {minutes} minute{(minutes == "1" ? "" : "s")} sans activité. Reconnectez-vous pour continuer.";
            await LocalStorage.RemoveItemAsync(CustomAuthStateProvider.LogoutReasonKey);
        }
    }

    private async Task HandleLogin()
    {
        isBusy = true;
        ErrorMessage = "";

        try
        {
            var result = await AuthService.Login(loginRequest);

            if (result.PasswordExpired)
            {
                await OpenExpiredPasswordDialog();
            }
            else
            {
                NavigationManager.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally { isBusy = false; }
    }

    private async Task HandleForgotPassword()
    {
        if (string.IsNullOrWhiteSpace(forgotEmailOrUser)) return;
        isBusy = true;
        try
        {
            var request = new ForgotPasswordRequest { EmailOrUsername = forgotEmailOrUser };
            await Http.PostAsJsonAsync("api/auth/forgot-password", request);
            // Message identique dans tous les cas : on ne révèle pas si le compte existe
            NotificationService.Notify(NotificationSeverity.Info, "Demande enregistrée",
                "Si un compte local avec une adresse e-mail correspond, un lien valable 30 minutes vient d'être envoyé. Les comptes Active Directory se réinitialisent avec la procédure Windows habituelle.");
            forgotPasswordMode = false;
        }
        catch { ErrorMessage = "Impossible de contacter le serveur."; }
        finally { isBusy = false; }
    }

    private async Task OpenExpiredPasswordDialog()
    {
        var result = await DialogService.OpenAsync<PasswordModal>("Changement de mot de passe requis",
            new Dictionary<string, object?> { { "IsForced", true } },
            new DialogOptions() { Width = "500px", CloseDialogOnOverlayClick = false, ShowClose = false }
        );

        if (result is ChangePasswordDto dto)
        {
            await ChangeExpiredPassword(dto);
        }
        else
        {
            await ((Autoprint.Web.Services.AuthService)AuthService).Logout();
        }
    }

    private async Task ChangeExpiredPassword(ChangePasswordDto dto)
    {
        try
        {
            var res = await Http.PutAsJsonAsync("api/users/change-password", dto);
            if (res.IsSuccessStatusCode)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Succès",
                    Detail = "Mot de passe modifié. Veuillez vous reconnecter.",
                    Duration = 5000
                });

                await ((Autoprint.Web.Services.AuthService)AuthService).Logout();

                loginRequest.Password = "";

                StateHasChanged();
            }
            else
            {
                ErrorMessage = "Erreur : " + await res.Content.ReadAsStringAsync();
                await ((Autoprint.Web.Services.AuthService)AuthService).Logout();
            }
        }
        catch (Exception ex) { ErrorMessage = "Erreur technique : " + ex.Message; }
    }
}