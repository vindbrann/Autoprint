@using Autoprint.Web.Services
@using Autoprint.Shared
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

@* Maquette « modales » (retour de recette du 11/11) : sections sans cadre, réseaux en liste simple avec ajout en ligne,
   statut en ligne de réglage, action principale nommée *@
<RadzenTemplateForm TItem="Emplacement" Data="@lieuEdit" Submit="@OnSubmit">
    <div class="ap-dlg">
        <div class="ap-dlg-group" style="padding-top: 0;">
            <h3>Identification</h3>
            <div class="ap-dlg-grid" style="grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);">
                <div class="ap-field">
                    <RadzenLabel Text="Nom du lieu" Component="Nom" />
                    <RadzenTextBox Name="Nom" @bind-Value="@lieuEdit.Nom" Style="width: 100%;" Placeholder="Siège" />
                    <RadzenRequiredValidator Component="Nom" Text="Saisissez le nom du lieu" Popup="true" />
                </div>
                <div class="ap-field">
                    <RadzenLabel Component="Code"><ChildContent>Code <span class="ap-opt">(facultatif)</span></ChildContent></RadzenLabel>
                    <RadzenTextBox Name="Code" @bind-Value="@lieuEdit.Code" Style="width: 100%;" Class="ap-mono" Placeholder="SIEGE" />
                </div>
            </div>
            <span class="ap-help">Le code sert au nommage automatique des imprimantes ({LIEU_CODE})</span>
        </div>

        <div class="ap-dlg-group">
            <h3>Réseaux</h3>
            <div class="ap-field">
                <RadzenLabel Text="Réseau principal" Component="PrimCidr" />
                <RadzenTextBox Name="PrimCidr" @bind-Value="@primaryCidr" Placeholder="10.12.0.0/16" Style="width: 100%;" Class="ap-mono" />
                <RadzenRegexValidator Component="PrimCidr" Text="Format attendu : adresse/masque, par exemple 10.12.0.0/16" Pattern="^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/(3[0-2]|[12]?[0-9]|[0-9])$" Popup="true" />
                <span class="ap-help">Impose le début de l'adresse IP des imprimantes de ce lieu et sert à reconnaître le lieu des postes</span>
            </div>
            <div class="ap-field">
                <span class="rz-label">Réseaux secondaires <span class="ap-opt">(facultatif)</span></span>
                @if (secondaryNetworks.Any())
                {
                    <div class="ap-pick-list">
                        @foreach (var n in secondaryNetworks)
                        {
                            <div class="ap-pick-row">
                                <div class="txt"><div class="t ap-mono">@n.CidrIpv4</div><div class="d">@n.Description</div></div>
                                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => SupprimerSecondaire(n))" title="@($"Retirer {n.CidrIpv4}")" aria-label="@($"Retirer {n.CidrIpv4}")" />
                            </div>
                        }
                    </div>
                }
                <div class="ap-net-add">
                    <RadzenTextBox @bind-Value="@tempSecCidr" Placeholder="192.168.10.0/24" Class="ap-mono" aria-label="Réseau secondaire à ajouter" />
                    <RadzenTextBox @bind-Value="@tempSecDesc" Placeholder="Description (ex. Wi-Fi)" aria-label="Description du réseau secondaire" />
                    <RadzenButton Icon="add" Text="Ajouter" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@AjouterSecondaire" Disabled="@string.IsNullOrWhiteSpace(tempSecCidr)" />
                </div>
            </div>
        </div>

        <div class="ap-dlg-group" style="gap: 0;">
            <div class="ap-opt-row" style="padding-top: 0;">
                <div class="txt">
                    <div class="t">Lieu actif</div>
                    <div class="d">Un lieu inactif n'est plus proposé à la création d'imprimantes</div>
                </div>
                <RadzenSwitch @bind-Value="IsActive" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Lieu actif" } })" />
            </div>
        </div>

        <div class="ap-dlg-footer">
            @if (lieuEdit.Id != 0)
            {
                <AuthorizeView Policy="LOCATION_DELETE">
                    <Authorized Context="authContext">
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Text" Text="Supprimer" Click="@OnDelete" />
                    </Authorized>
                </AuthorizeView>
            }
            <span class="ap-grow"></span>
            <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => DialogService.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(lieuEdit.Id == 0 ? "Créer le lieu" : "Enregistrer les modifications")" ButtonStyle="ButtonStyle.Primary" />
        </div>
    </div>
</RadzenTemplateForm>

@code {
    [Parameter] public Emplacement LieuToEdit { get; set; } = new();

    private Emplacement lieuEdit = new();

    private string primaryCidr = "";
    private int primaryId = 0;

    private List<EmplacementNetwork> secondaryNetworks = new();
    private string tempSecCidr = "";
    private string tempSecDesc = "";

    bool IsActive
    {
        get => lieuEdit.Status == LieuStatus.Active;
        set => lieuEdit.Status = value ? LieuStatus.Active : LieuStatus.Inactive;
    }

    protected override void OnInitialized()
    {
        lieuEdit = new Emplacement
        {
            Id = LieuToEdit.Id,
            Nom = LieuToEdit.Nom,
            Code = LieuToEdit.Code,
            Status = LieuToEdit.Status,
            Networks = new List<EmplacementNetwork>()
        };

        if (LieuToEdit.Networks != null && LieuToEdit.Networks.Any())
        {
            var mainNet = LieuToEdit.Networks.FirstOrDefault(n => n.IsPrimary);

            if (mainNet != null)
            {
                primaryCidr = mainNet.CidrIpv4;
                primaryId = mainNet.Id;
            }

            secondaryNetworks = LieuToEdit.Networks
                .Where(n => !n.IsPrimary)
                .Select(n => new EmplacementNetwork
                {
                    Id = n.Id,
                    CidrIpv4 = n.CidrIpv4,
                    Description = n.Description,
                    IsPrimary = false,
                    EmplacementId = n.EmplacementId
                })
                .ToList();
        }
    }

    private async Task AjouterSecondaire()
    {
        if (string.IsNullOrWhiteSpace(tempSecCidr)) return;

        var regex = new System.Text.RegularExpressions.Regex(@"^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/(3[0-2]|[12]?[0-9]|[0-9])$");
        if (!regex.IsMatch(tempSecCidr))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Format Invalide", "IP/Masque (ex: 192.168.1.0/24)");
            return;
        }

        if (secondaryNetworks.Any(n => n.CidrIpv4 == tempSecCidr) || tempSecCidr == primaryCidr)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Doublon", "Réseau déjà présent.");
            return;
        }

        var nouveauReseau = new EmplacementNetwork
        {
            CidrIpv4 = tempSecCidr,
            Description = string.IsNullOrWhiteSpace(tempSecDesc) ? "Réseau Secondaire" : tempSecDesc,
            IsPrimary = false
        };

        secondaryNetworks = new List<EmplacementNetwork>(secondaryNetworks) { nouveauReseau };

        tempSecCidr = "";
        tempSecDesc = "";

    }

    private async Task SupprimerSecondaire(EmplacementNetwork net)
    {
        secondaryNetworks = secondaryNetworks.Where(n => n != net).ToList();

    }

    private async Task OnSubmit(Emplacement args)
    {
        try
        {
            lieuEdit.Networks.Clear();

            if (!string.IsNullOrWhiteSpace(primaryCidr))
            {
                var reseauPrincipal = new EmplacementNetwork
                {
                    Id = primaryId,
                    CidrIpv4 = primaryCidr,
                    Description = "Réseau Principal",
                    EmplacementId = lieuEdit.Id,
                    IsPrimary = true
                };
                lieuEdit.Networks.Add(reseauPrincipal);
            }

            foreach (var item in secondaryNetworks)
            {
                var reseauSecondaire = new EmplacementNetwork
                {
                    Id = item.Id,
                    CidrIpv4 = item.CidrIpv4,
                    Description = item.Description,
                    EmplacementId = lieuEdit.Id,
                    IsPrimary = false
                };
                lieuEdit.Networks.Add(reseauSecondaire);
            }

            lieuEdit.Nom = lieuEdit.Nom?.Trim() ?? "";
            lieuEdit.Code = lieuEdit.Code?.Trim().ToUpper();

            if (lieuEdit.Id == 0)
            {
                if (!await (await Http.PostAsJsonAsync("api/Emplacements", lieuEdit)).CheckAsync(NotificationService)) return;
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Lieu créé.");
            }
            else
            {
                if (!await (await Http.PutAsJsonAsync($"api/Emplacements/{lieuEdit.Id}", lieuEdit)).CheckAsync(NotificationService)) return;
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Lieu mis à jour.");
            }
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
    }

    private async Task OnDelete()
    {
        var confirm = await DialogService.Confirm("Supprimer ce lieu ?", "Confirmer", new ConfirmOptions() { OkButtonText = "Oui", CancelButtonText = "Non" });
        if (confirm == true)
        {
            try
            {
                if (!await (await Http.DeleteAsync($"api/Emplacements/{lieuEdit.Id}")).CheckAsync(NotificationService)) return;
                DialogService.Close(true);
            }
            catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message); }
        }
    }
}