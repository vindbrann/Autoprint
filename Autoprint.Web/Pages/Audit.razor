@page "/audit"
@using Autoprint.Shared
@using Autoprint.Shared.DTOs
@using System.Text.Json
@using System.Text
@using Radzen
@using Radzen.Blazor
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@inject IJSRuntime JS
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Journal d'audit</PageTitle>

<div class="ap-page-header">
    <div class="ap-titles"><h1>Journal d'audit</h1></div>
    <span class="ap-grow"></span>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
        <RadzenButton Icon="download" Text="Exporter en CSV" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Click="@ExporterEnCsv" Disabled="@(totalCount == 0)" />

        <AuthorizeView Policy="SETTINGS_MANAGE">
            <Authorized>
                <RadzenButton Icon="delete_sweep" Text="Nettoyer (plus de 30 jours)" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@PurgerLogs" />
            </Authorized>
        </AuthorizeView>
    </RadzenStack>
</div>

<RadzenCard Variant="Variant.Outlined" Class="rz-mb-4 rz-p-2">
    <RadzenTextBox Placeholder="Rechercher (Utilisateur, Action, Détails)..."
                   @oninput="@(args => OnSearchChange(args.Value?.ToString()))"
                   Style="width: 100%;" />
</RadzenCard>

<div class="ap-grid-wrap"><RadzenDataGrid @ref="grid" Data="@logs" Count="@totalCount" LoadData="@LoadData" IsLoading="@isLoading"
                TItem="AuditLogDto"
                AllowPaging="true" PageSize="20"
                AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                LoadColumnFilterData="@LoadNiveaux"
                Density="Density.Compact"
                Style="height: 600px;">
    <Columns>

        <RadzenDataGridColumn TItem="AuditLogDto" Property="DateAction" Title="Date" Sortable="true" Width="160px">
            <Template Context="log">
                <span class="text-muted small">@log.DateAction.ToLocalTime().ToString("dd/MM/yy HH:mm")</span>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="AuditLogDto" Property="Niveau" Title="Niveau" Width="110px" TextAlign="TextAlign.Center" FilterMode="FilterMode.CheckBoxList">
            <Template Context="log">
                @switch (log.Niveau)
                {
                    case "ERROR":
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="ERR" />
                        break;
                    case "WARNING":
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="WARN" />
                        break;
                    case "INFO":
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="INFO" />
                        break;
                    default:
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@log.Niveau" />
                        break;
                }
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="AuditLogDto" Property="Utilisateur" Title="Utilisateur" Width="140px" FilterMode="FilterMode.Simple">
            <Template Context="log">
                <span style="font-weight: 500; font-size: 0.9em;">@log.Utilisateur</span>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="AuditLogDto" Property="Action" Title="Détails de l'opération" MinWidth="300px" FilterMode="FilterMode.Simple">
            <Template Context="log">
                <div style="display: flex; align-items: center; gap: 0.5rem; overflow: hidden; white-space: nowrap;">

                    <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                                  Click="@(() => ShowDetails(log.Id))" Tooltip="Voir les détails" Style="flex-shrink: 0;" />

                    <div style="overflow: hidden; text-overflow: ellipsis;">
                        <span style="font-weight: bold; color: var(--rz-text-title-color);">@log.ActionLisible</span>
                        <span style="color: var(--rz-text-tertiary-color); margin-left: 8px;">@log.Details</span>
                    </div>
                </div>
            </Template>
        </RadzenDataGridColumn>

    </Columns>
</RadzenDataGrid></div>

@code {
    private RadzenDataGrid<AuditLogDto>? grid;
    private IEnumerable<AuditLogDto>? logs;
    private int totalCount;
    private bool isLoading;

    private string currentSearch = "";
    private string columnQuery = ""; // filtres et tri des colonnes, traduits en paramètres de l'API (pagination côté serveur)
    private static readonly string[] Niveaux = { "INFO", "WARNING", "ERROR", "Critical" };
    private System.Timers.Timer? debounceTimer;

    protected override void OnInitialized()
    {
        debounceTimer = new System.Timers.Timer(500);
        debounceTimer.AutoReset = false;
        debounceTimer.Elapsed += async (sender, e) =>
        {
            await InvokeAsync(() => grid?.Reload() ?? Task.CompletedTask);
        };
    }

    private void OnSearchChange(string? value)
    {
        currentSearch = value ?? "";
        debounceTimer?.Stop();
        debounceTimer?.Start();
    }

    private async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;
        try
        {
            var page = (args.Skip / args.Top) + 1;
            var pageSize = args.Top ?? 20;
            columnQuery = BuildColumnQuery(args);
            var result = await Http.GetFromJsonAsync<PaginatedList<AuditLogDto>>($"/api/Audit?page={page}&pageSize={pageSize}&search={Uri.EscapeDataString(currentSearch)}{columnQuery}");
            if (result != null)
            {
                logs = result.Items;
                totalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur Audit Load: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    // Valeurs proposées dans le filtre à cases du niveau (la grille ne charge qu'une page)
    private void LoadNiveaux(DataGridLoadColumnFilterDataEventArgs<AuditLogDto> args)
    {
        // Radzen attend des lignes du type de la grille, dont il lit la propriété de la colonne
        if (args.Column?.Property == nameof(AuditLogDto.Niveau)) { args.Data = Niveaux.Select(n => new AuditLogDto { Niveau = n }).ToList(); args.Count = Niveaux.Length; }
    }

    private static string BuildColumnQuery(LoadDataArgs args)
    {
        var q = new StringBuilder();
        void Add(string k, object? v) { if (v != null && $"{v}" != "") q.Append('&').Append(k).Append('=').Append(Uri.EscapeDataString(v is DateTime d ? d.ToUniversalTime().ToString("o") : $"{v}")); }
        void Date(FilterOperator op, object? v)
        {
            if (v is not DateTime d) return;
            switch (op)
            {
                case FilterOperator.GreaterThan: Add("du", d.AddMinutes(1)); break;
                case FilterOperator.GreaterThanOrEquals: Add("du", d); break;
                case FilterOperator.LessThan: Add("au", d); break;
                case FilterOperator.LessThanOrEquals: Add("au", d.AddMinutes(1)); break;
                case FilterOperator.Equals: Add("du", d.Date); Add("au", d.Date.AddDays(1)); break;
            }
        }
        foreach (var f in args.Filters ?? Enumerable.Empty<FilterDescriptor>())
        {
            switch (f.Property)
            {
                case nameof(AuditLogDto.Utilisateur): Add("utilisateur", f.FilterValue); break;
                case nameof(AuditLogDto.Action): Add("action", f.FilterValue); break;
                case nameof(AuditLogDto.Niveau):
                    if (f.FilterValue is System.Collections.IEnumerable list and not string) foreach (var n in list) Add("niveau", n);
                    else Add("niveau", f.FilterValue);
                    break;
                case nameof(AuditLogDto.DateAction): Date(f.FilterOperator, f.FilterValue); Date(f.SecondFilterOperator, f.SecondFilterValue); break;
            }
        }
        var s = args.Sorts?.FirstOrDefault(x => x.SortOrder != null);
        if (s != null)
        {
            Add("tri", s.Property);
            Add("desc", s.SortOrder == SortOrder.Descending ? "true" : "false");
        }
        return q.ToString();
    }

    private async Task ShowDetails(int logId)
    {
        var fullLog = await Http.GetFromJsonAsync<AuditLog>($"/api/Audit/{logId}");
        if (fullLog != null)
        {
            await DialogService.OpenAsync<AuditDetailModal>($"Détails Log #{logId}",
                new Dictionary<string, object?> { { "Log", fullLog } },
                new DialogOptions() { Width = "800px" }
            );
        }
    }

    private async Task PurgerLogs()
    {
        var confirm = await DialogService.Confirm("Supprimer définitivement les logs vieux de plus de 30 jours ?", "Nettoyage",
            new ConfirmOptions { OkButtonText = "Oui, nettoyer", CancelButtonText = "Non" });

        if (confirm == true)
        {
            var res = await Http.DeleteAsync("api/Audit/cleanup");
            if (res.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Nettoyage", "Logs anciens supprimés.");
                grid?.Reload();
            }
        }
    }

    private async Task ExporterEnCsv()
    {
        if (totalCount == 0) return;

        try
        {
            NotificationService.Notify(NotificationSeverity.Info, "Export", "Génération du fichier en cours...");

            var result = await Http.GetFromJsonAsync<PaginatedList<AuditLogDto>>($"/api/Audit?page=1&pageSize=100000&search={Uri.EscapeDataString(currentSearch)}{columnQuery}");

            if (result?.Items == null || !result.Items.Any()) return;

            var csvBuilder = new StringBuilder();
            csvBuilder.AppendLine("Date;Niveau;Utilisateur;Action;Details");

            foreach (var l in result.Items)
            {
                var detailsClean = l.Details?.Replace(";", ",").Replace("\n", " ") ?? "";
                var actionClean = l.ActionLisible?.Replace(";", ",") ?? "";

                csvBuilder.AppendLine($"{l.DateAction};{l.Niveau};{l.Utilisateur};{actionClean};{detailsClean}");
            }

            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csvBuilder.ToString())).ToArray();
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);

            var nomFichier = $"Audit_Export_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await JS.InvokeVoidAsync("downloadFileFromStream", nomFichier, streamRef);

            NotificationService.Notify(NotificationSeverity.Success, "Export", "Téléchargement terminé.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur Export", ex.Message);
        }
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}