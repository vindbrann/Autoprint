            @* --- SECURITE --- *@
            @if (section == "Sécurité")
            {
                <div class="ap-settings">
                    <section class="ap-card">
                        <div class="ap-set-row">
                            <div><h3>Clé d'API des postes clients</h3><p>Les postes s'identifient avec cette clé, demandée à l'installation du client (<span class="ap-mono">APIKEY=…</span>).</p></div>
                            <div class="ap-ctrl">
                                <div style="display: flex; gap: var(--ap-s2);">
                                    <RadzenTextBox Value="@model.AgentApiKey" Disabled="true" Style="flex: 1;" Class="ap-mono" aria-label="Clé d'API masquée" />
