    private string? backupSecretsPassword;
    private string? restoreSecretsPassword;

    private async Task DownloadBackup()
    {
        bool withSecrets = !string.IsNullOrEmpty(backupSecretsPassword);
        if (withSecrets && backupSecretsPassword!.Length < PasswordPolicy.MinLength)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Mot de passe trop court", $"Le mot de passe de protection doit faire au moins {PasswordPolicy.MinLength} caractères.");
            return;
        }

        // Avertissement avant export (audit #9)
        var confirmed = await DialogService.Confirm(
            (withSecrets
                ? "Les mots de passe AD / SMTP et la clé d'API agent seront inclus, CHIFFRÉS avec votre mot de passe de protection : sans lui, ils ne pourront pas être restaurés. "
                : "Les mots de passe AD / SMTP et la clé d'API agent ne seront PAS inclus : après une restauration sur un autre serveur, il faudra les ressaisir. ") +
            "Le fichier contient aussi les empreintes des mots de passe des comptes locaux et toute la configuration : " +
            "conservez-le dans un emplacement protégé (accès réservé aux administrateurs) et ne l'envoyez pas par e-mail. Continuer ?",
            "Sauvegarde : données sensibles",
            new ConfirmOptions { OkButtonText = "J'ai compris, télécharger", CancelButtonText = "Annuler" });
        if (confirmed != true) return;

        try
        {
            NotificationService.Notify(NotificationSeverity.Info, "Export", "Préparation du téléchargement...");

            var response = await Http.PostAsJsonAsync("api/Backup/export", new Autoprint.Shared.DTOs.BackupExportRequestDto { SecretsPassword = withSecrets ? backupSecretsPassword : null });

            if (response.IsSuccessStatusCode)
            {
                using var fileStream = await response.Content.ReadAsStreamAsync();
                var fileName = $"Autoprint_Backup_{DateTime.Now:yyyyMMdd_HHmm}.json";

                using var streamRef = new DotNetStreamReference(fileStream);
                await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Téléchargement démarré.");
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", "Accès refusé par le serveur.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
    }
    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            uploadedBackup = await (JsonSerializer.DeserializeAsync<Autoprint.Shared.DTOs.BackupRootDto>(stream, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }));
            if (uploadedBackup == null || string.IsNullOrWhiteSpace(uploadedBackup.Version)) throw new JsonException();
        }
        catch (JsonException)
        {
            // Pas le détail technique de la désérialisation (types .NET, numéros de ligne) (B57)
            uploadedBackup = null;
            NotificationService.Notify(NotificationSeverity.Error, "Fichier invalide", "Ce fichier n'est pas une sauvegarde Autoprint lisible (fichier modifié ou endommagé ?).");
        }
        catch (IOException)
        {
            uploadedBackup = null;
            NotificationService.Notify(NotificationSeverity.Error, "Fichier invalide", "Fichier illisible ou trop volumineux (5 Mo au maximum).");
        }
    }

    private async Task ExecuteRestore()
    {
        if (uploadedBackup == null) return;
        var confirm = await DialogService.Confirm("⛔ ATTENTION : Toutes les données seront remplacées.\nContinuer ?", "Danger", new ConfirmOptions() { OkButtonText = "Oui, écraser", CancelButtonText = "Non" });
        if (confirm == true)
        {
            isRestoring = true;
            try
            {
                uploadedBackup.SecretsPassword = uploadedBackup.SecretsProtected ? restoreSecretsPassword : null;
                var res = await Http.PostAsJsonAsync("api/Backup/restore", uploadedBackup);
                if (res.IsSuccessStatusCode)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Terminé", "Restauration effectuée.");
                    uploadedBackup = null;
                }
                else NotificationService.Notify(NotificationSeverity.Error, "Erreur", await res.Content.ReadAsStringAsync());
            }
            catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message); }
            finally { isRestoring = false; }
        }
    }

