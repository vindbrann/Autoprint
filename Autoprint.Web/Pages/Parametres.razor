@page "/parametres"
@using Autoprint.Shared
@using Autoprint.Shared.DTOs
@using Autoprint.Web.Services
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NetworkScannerService ScannerService

<PageTitle>Paramètres</PageTitle>

<div class="ap-page-header">
    <div class="ap-titles">
        <h1>Paramètres</h1>
        <span class="ap-sub">Réglages globaux du serveur Autoprint</span>
    </div>
</div>

@if (isLoading)
{
    <div class="rz-p-12 rz-text-align-center">
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="width: 50%; margin: auto;" />
        <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-mt-4">Chargement des paramètres...</RadzenText>
    </div>
}
else
{
    @* Charte B77, maquette « Paramètres » : menu des sections à gauche (réductible), titre et description de la section,
       barre d'enregistrement dès qu'une modification est en attente *@
    @* Menu groupé (Imprimantes, Connexions, Serveur) ; plus d'entrée « Réduire » dans la liste (retour de recette du 11/11) *@
    <div class="ap-subnav-layout">
        <nav class="ap-subnav" aria-label="Sections des paramètres">
            @foreach (var g in Sections.GroupBy(x => x.Group))
            {
                <div class="ap-subnav-group">@g.Key</div>
                @foreach (var s in g)
                {
                    <a href="javascript:void(0)" class="@(section == s.Key ? "active" : null)" aria-current="@(section == s.Key ? "page" : null)" @onclick="@(() => OuvrirSection(s.Key))" @onclick:preventDefault>
                        <RadzenIcon Icon="@s.Icon" />
                        <span>@s.Title</span>
                    </a>
                }
            }
        </nav>
        <div class="ap-subnav-content">
            @{ var cur = Sections.First(x => x.Key == section); }
            <div class="ap-section-head">
                <h2>@cur.Title</h2>
                <p>@cur.Description</p>
            </div>

            @* --- MAINTENANCE --- *@
            @if (section == "Maintenance")
            {
                <div class="ap-settings">
                    <section class="ap-card">
                        <div class="ap-set-row">
                            <div><h3>Rétention du journal d'audit</h3><p>Les entrées plus anciennes que cette durée sont supprimées automatiquement.</p></div>
                            <div class="ap-ctrl">
                                <RadzenLabel Text="Purge automatique" Component="LogRetention" />
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenNumeric Name="LogRetention" @bind-Value="@model.LogRetentionDays" Min="0" Max="3650" Style="width: 140px;" />
                                    <span class="ap-muted">jours</span>
                                </RadzenStack>
                                <span class="ap-help">0 pour conserver sans limite.</span>
                            </div>
                        </div>
                    </section>

                    <section class="ap-card">
                        <div class="ap-set-row">
                            <div><h3>Sauvegarde</h3><p>Exporte toute la configuration dans un fichier JSON.</p></div>
                            <div class="ap-ctrl">
                                <RadzenLabel Text="Mot de passe de protection des secrets (facultatif)" Component="BackupPwd" />
                                <RadzenPassword Name="BackupPwd" @bind-Value="@backupSecretsPassword" Placeholder="12 caractères minimum" Style="width: 100%;" AutoComplete="false" />
                                <span class="ap-help">Avec un mot de passe, les mots de passe Active Directory et SMTP et la clé agent sont inclus, chiffrés. Sans mot de passe, ils sont exclus du fichier.</span>
                                <div><RadzenButton Text="Télécharger la sauvegarde" Icon="download" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@DownloadBackup" /></div>
                            </div>
                        </div>
                    </section>

                    <section class="ap-card ap-zone-sensible">
                        <div class="ap-set-row">
                            <div><span class="ap-zone-label"><RadzenIcon Icon="warning" Style="font-size: 14px;" />Zone sensible</span><h3 style="margin-top: 6px;">Restauration</h3><p>Remplace la configuration actuelle par celle d'un fichier de sauvegarde.</p></div>
                            <div class="ap-ctrl">
                                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" Size="AlertSize.Small">
                                    <strong>Les données actuelles seront écrasées.</strong> Faites une sauvegarde avant de restaurer.
                                </RadzenAlert>
                                @if (uploadedBackup == null)
                                {
                                    <InputFile OnChange="LoadFile" accept=".json" />
                                }
                                else
                                {
                                    <div><strong>Fichier prêt :</strong> @uploadedBackup.CreatedBy, le @uploadedBackup.CreatedAt.ToShortDateString()</div>
                                    @if (uploadedBackup.SecretsProtected)
                                    {
                                        <RadzenPassword @bind-Value="@restoreSecretsPassword" Placeholder="Mot de passe de protection de la sauvegarde" Style="width: 100%;" AutoComplete="false" />
                                    }
                                    else
                                    {
                                        <span class="ap-help">
                                            Cette sauvegarde ne contient pas les secrets : les mots de passe AD / SMTP, les identifiants SNMP et la clé agent <strong>de ce serveur</strong> seront conservés.
                                            Sur un nouveau serveur, il faudra les ressaisir, et les postes configurés avec la clé agent de l'ancien serveur seront refusés jusqu'à leur mise à jour.
                                        </span>
                                    }
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                        <RadzenButton Text="Restaurer" Icon="restore" ButtonStyle="ButtonStyle.Danger" Click="@ExecuteRestore" IsBusy="@isRestoring" />
                                        <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => uploadedBackup = null)" />
                                    </RadzenStack>
                                }
                            </div>
                        </div>
                    </section>
                </div>
            }
            @* --- SMTP --- (format de la maquette : réglage à gauche, champs à droite) *@
            @if (section == "SMTP")
            {
                <div class="ap-settings">
                    <section class="ap-card">
                        <div class="ap-set-row">
                            <div><h3>Serveur d'envoi</h3><p>Relais SMTP utilisé pour les alertes et les rapports planifiés.</p></div>
                            <div class="ap-ctrl">
                                <div class="ap-dlg-grid" style="grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);">
                                    <div class="ap-field"><RadzenLabel Text="Adresse du serveur" Component="SmtpHost" /><RadzenTextBox Name="SmtpHost" @bind-Value="@model.SmtpHost" Placeholder="smtp.mondomaine.fr" Style="width: 100%;" /></div>
                                    <div class="ap-field"><RadzenLabel Text="Port" Component="SmtpPort" /><RadzenNumeric Name="SmtpPort" @bind-Value="@model.SmtpPort" Min="1" Max="65535" Style="width: 100%;" /></div>
                                </div>
                                <div class="ap-opt-row" style="padding: 0;">
                                    <div class="txt"><div class="t">Chiffrement TLS</div><div class="d">Recommandé : sans TLS, le mot de passe et le contenu des rapports circulent en clair</div></div>
                                    <RadzenSwitch @bind-Value="@model.SmtpEnableSsl" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Chiffrement TLS" } })" />
                                </div>
                                @if (!model.SmtpEnableSsl)
                                {
                                    <span class="ap-help is-warn">Sans TLS : à réserver à un relais interne de confiance</span>
                                }
                            </div>
                        </div>
                        <div class="ap-set-row">
                            <div><h3>Authentification</h3><p>Laissez vide si le relais accepte les envois sans compte.</p></div>
                            <div class="ap-ctrl">
                                <div class="ap-dlg-grid">
                                    <div class="ap-field"><RadzenLabel Text="Utilisateur" Component="SmtpUser" /><RadzenTextBox Name="SmtpUser" @bind-Value="@model.SmtpUser" Style="width: 100%;" AutoComplete="false" /></div>
                                    <div class="ap-field"><RadzenLabel Text="Mot de passe" Component="SmtpPass" /><RadzenPassword Name="SmtpPass" @bind-Value="@model.SmtpPass" Style="width: 100%;" AutoComplete="false" /></div>
                                </div>
                            </div>
                        </div>
                        <div class="ap-set-row">
                            <div><h3>Expéditeur</h3><p>Adresse affichée comme expéditeur des e-mails.</p></div>
                            <div class="ap-ctrl"><RadzenTextBox @bind-Value="@model.SmtpFromAddress" Placeholder="autoprint@mondomaine.fr" Style="width: 100%;" aria-label="Adresse de l'expéditeur" /></div>
                        </div>
                    </section>
                    <section class="ap-card">
                        <div class="ap-set-row">
                            <div><h3>Test d'envoi</h3><p>Envoie un e-mail avec les réglages affichés, même non enregistrés.</p></div>
                            <div class="ap-ctrl">
                                <div class="ap-field"><RadzenLabel Text="Destinataire" Component="TestEmail" /><RadzenTextBox Name="TestEmail" @bind-Value="testEmailTo" Placeholder="vous@mondomaine.fr" Style="width: 100%;" /></div>
                                <div><RadzenButton Text="Envoyer un e-mail de test" Icon="send" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@TesterEmail" IsBusy="@testEnCours" Disabled="@string.IsNullOrWhiteSpace(testEmailTo)" /></div>
                            </div>
                        </div>
                    </section>
                </div>
            }

            @* --- NOMMAGE --- (maquette « modales et nommage » : variables cliquables, aperçu en direct, renommage du parc en étape à part) *@
            @if (section == "Nommage")
            {
                <div class="ap-settings">
                    <section class="ap-card ap-name-card">
                        <h3 class="ap-card-title">Nom des imprimantes</h3>
                        <div class="ap-opt-row">
                            <div class="txt">
                                <div class="t">Nommage automatique</div>
                                <div class="d">Le nom est construit avec la règle ci-dessous à la création et à chaque modification d'une imprimante</div>
                            </div>
                            <RadzenSwitch @bind-Value="@model.NamingEnabled" Change="@(_ => OnPatternChanged())" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Nommage automatique" } })" />
                        </div>
                        <div class="@(model.NamingEnabled ? "ap-name-builder" : "ap-name-builder is-off")">
                            @if (!model.NamingEnabled)
                            {
                                <div class="ap-name-note"><RadzenIcon Icon="info" />Activez le nommage automatique pour modifier la règle</div>
                            }
                            <div class="ap-field">
                                <label class="rz-label" for="naming-pattern">Règle</label>
                                <input id="naming-pattern" class="rz-textbox ap-mono" style="width: 100%;" spellcheck="false" autocomplete="off"
                                       disabled="@(!model.NamingEnabled)" placeholder="IMP_{LIEU_CODE}_{MODELE}"
                                       @bind="model.NamingTemplate" @bind:event="oninput" @bind:after="OnPatternChanged" />
                            </div>
                            <div>
                                <div class="ap-help" style="margin-bottom: 6px;">Cliquez pour insérer à l'emplacement du curseur</div>
                                <div class="ap-chips">
                                    @foreach (var tok in NamingTokens)
                                    {
                                        <button type="button" class="ap-chip" disabled="@(!model.NamingEnabled)" title="{@tok.Key}" @onclick="@(() => InsererToken(tok.Key))"><RadzenIcon Icon="add" />@tok.Label</button>
                                    }
                                </div>
                            </div>
                            <div class="ap-name-result">
                                <div class="ap-field" style="min-width: 0;">
                                    <span class="ap-help">Exemple avec</span>
                                    @if (namingSamples.Any())
                                    {
                                        <RadzenDropDown TValue="int" @bind-Value="@namingSampleId" Data="@namingSamples" TextProperty="NomAffiche" ValueProperty="Id"
                                                        Change="@(_ => OnPatternChanged())" AllowFiltering="true" Style="width: 100%; max-width: 360px;" aria-label="Imprimante d'exemple" />
                                    }
                                    else
                                    {
                                        <span class="ap-help">Aucune imprimante dans le parc : l'aperçu utilise des valeurs d'exemple</span>
                                    }
                                </div>
                                <div class="ap-name-out" aria-live="polite">@(string.IsNullOrEmpty(namingPreview) ? "—" : namingPreview)</div>
                                <div class="ap-help @(namingCheckOk ? "is-ok" : "is-bad")">@namingCheck</div>
                            </div>
                        </div>
                    </section>

                    <section class="ap-card ap-name-card">
                        <h3 class="ap-card-title">Partage Windows</h3>
                        <div class="ap-opt-row">
                            <div class="txt">
                                <div class="t">Même nom pour le partage</div>
                                <div class="d">Le nom de partage des imprimantes partagées reprend le nom de l'imprimante</div>
                            </div>
                            <RadzenSwitch @bind-Value="@model.NamingSameShare" Disabled="@(!model.NamingEnabled)" Change="@(_ => OnPatternChanged())" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Même nom pour le partage" } })" />
                        </div>
                    </section>

                    <section class="ap-card ap-name-card">
                        <h3 class="ap-card-title">Appliquer au parc existant</h3>
                        <p class="ap-card-lead">La règle s'applique aux nouvelles imprimantes. Pour renommer celles qui existent, vérifiez d'abord la liste des changements.</p>
                        <div class="ap-name-apply">
                            <span class="ap-name-count">@(namingChanges?.Count ?? 0)</span>
                            <span class="ap-grow" style="min-width: 180px;">
                                @(namingChanges == null ? "calcul en cours" : namingChanges.Count == 0 ? "aucune imprimante ne change de nom" : namingChanges.Count == 1 ? "imprimante changerait de nom" : "imprimantes changeraient de nom")<br />
                                <span class="ap-help">Les postes connectés à l'ancien nom devront être reconnectés</span>
                            </span>
                            <RadzenButton Text="@(showNamingDiff ? "Masquer les changements" : "Voir les changements")" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined"
                                          Disabled="@(!model.NamingEnabled || !namingCheckOk || namingChanges is not { Count: > 0 })" Click="@(() => showNamingDiff = !showNamingDiff)" />
                        </div>
                        @if (showNamingDiff && namingChanges is { Count: > 0 })
                        {
                            <div class="ap-name-diff">
                                <div class="ap-name-diff-scroll">
                                    <table>
                                        <thead><tr><th>Nom actuel</th><th></th><th>Nouveau nom</th>@if (model.NamingSameShare) { <th>Partage</th> }</tr></thead>
                                        <tbody>
                                            @foreach (var c in namingChanges)
                                            {
                                                <tr>
                                                    <td class="old">@c.CurrentName</td><td class="arrow">→</td><td>@c.NewName@(c.IsArchived ? " (archivée)" : "")</td>
                                                    @if (model.NamingSameShare) { <td>@(c.NewShare ?? (c.CurrentShare == null ? "non partagée" : "inchangé"))</td> }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="ap-name-diff-foot">
                                    <span class="ap-help">Les réglages de nommage sont enregistrés, puis la synchronisation renomme les files sur le serveur.</span>
                                    <RadzenButton Text="Fermer" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => showNamingDiff = false)" />
                                    <RadzenButton Text="@($"Renommer {namingChanges.Count} imprimante{(namingChanges.Count > 1 ? "s" : "")}")" ButtonStyle="ButtonStyle.Primary" Click="@AppliquerNommageAuParc" IsBusy="@namingApplying" />
                                </div>
                            </div>
                        }
                    </section>
                </div>
            }

            @* --- VALEURS PAR DÉFAUT DES IMPRIMANTES --- (réglages sortis de « Nommage ») *@
            @if (section == "Defauts")
            {
                <div class="ap-settings">
                    <section class="ap-card">
                        <div class="ap-set-row">
                            <div><h3>Impression directe</h3><p>Valeur proposée à la création d'une imprimante : les travaux vont directement à l'imprimante, sans file d'attente sur le serveur.</p></div>
                            <div class="ap-ctrl">
                                <div class="ap-opt-row" style="padding: 0;">
                                    <div class="txt"><div class="t">Activée par défaut pour les nouvelles imprimantes</div></div>
                                    <RadzenSwitch @bind-Value="@model.Printer_DefaultDirectModeEnabled" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Impression directe par défaut" } })" />
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="ap-card ap-zone-sensible">
                        <div class="ap-set-row">
                            <div><span class="ap-zone-label"><RadzenIcon Icon="warning" Style="font-size: 14px;" />Zone sensible</span><h3 style="margin-top: 6px;">Tout le parc en impression directe</h3><p>Active l'impression directe sur toutes les imprimantes existantes.</p></div>
                            <div class="ap-ctrl">
                                <span class="ap-help">Toutes les files seront resynchronisées sur le serveur. Les travaux en attente dans le spouleur peuvent être perdus.</span>
                                <div><RadzenButton Text="Passer tout le parc en impression directe" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@ForcerModeDirect" /></div>
                            </div>
                        </div>
                    </section>
                </div>
            }
            @* --- ACTIVE DIRECTORY --- (assistant de filtre remplacé par une recherche de groupe dans l'annuaire : DN exact) *@
            @if (section == "Active Directory")
            {
                <div class="ap-settings">
                    <section class="ap-card">
                        <div class="ap-set-row">
                            <div><h3>Domaine</h3><p>Nom DNS du domaine Active Directory.</p></div>
                            <div class="ap-ctrl"><RadzenTextBox @bind-Value="@model.AdDomain" Placeholder="mondomaine.lan" Style="width: 100%;" Class="ap-mono" aria-label="Nom de domaine" /></div>
                        </div>
                        <div class="ap-set-row">
                            <div><h3>Compte de service</h3><p>Compte qui lit l'annuaire pour vérifier les connexions. Un compte sans droit particulier suffit.</p></div>
                            <div class="ap-ctrl">
                                <div class="ap-dlg-grid">
                                    <div class="ap-field"><RadzenLabel Text="Identifiant" Component="AdUser" /><RadzenTextBox Name="AdUser" @bind-Value="@model.AdServiceUser" Placeholder="svc-autoprint" Style="width: 100%;" AutoComplete="false" /></div>
                                    <div class="ap-field"><RadzenLabel Text="Mot de passe" Component="AdPwd" /><RadzenPassword Name="AdPwd" @bind-Value="@model.AdServicePassword" Style="width: 100%;" AutoComplete="false" /></div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="ap-card">
                        <div class="ap-set-row">
                            <div><h3>Comptes autorisés</h3><p>Seuls les comptes trouvés sous ce DN de base et qui respectent le filtre peuvent se connecter.</p></div>
                            <div class="ap-ctrl">
                                <div class="ap-field">
                                    <RadzenLabel Component="AdBaseDn"><ChildContent>DN de base <span class="ap-opt">(facultatif)</span></ChildContent></RadzenLabel>
                                    <RadzenTextBox Name="AdBaseDn" @bind-Value="@model.AdBaseDn" Placeholder="OU=Utilisateurs,DC=mondomaine,DC=lan" Style="width: 100%;" Class="ap-mono" />
                                    <span class="ap-help">Écrire \, pour une virgule dans un nom</span>
                                </div>
                                <div class="ap-field">
                                    <RadzenLabel Component="AdFilter"><ChildContent>Filtre LDAP <span class="ap-opt">(facultatif)</span></ChildContent></RadzenLabel>
                                    <RadzenTextBox Name="AdFilter" @bind-Value="@model.AdLdapFilter" Placeholder="(memberOf=CN=GG_Autoprint,OU=Groupes,DC=mondomaine,DC=lan)" Style="width: 100%;" Class="ap-mono" />
                                    <div style="display: flex; flex-wrap: wrap; gap: var(--ap-s2); align-items: center;">
                                        <span class="ap-help ap-grow">Plusieurs conditions à la suite : toutes doivent être vraies</span>
                                        @if (!string.IsNullOrWhiteSpace(model.AdLdapFilter))
                                        {
                                            <RadzenButton Text="Effacer le filtre" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => model.AdLdapFilter = "")" />
                                        }
                                    </div>
                                </div>
                                <div class="ap-field">
                                    <RadzenLabel Text="Limiter à un groupe" Component="AdGroupSearch" />
                                    <div style="display: flex; gap: var(--ap-s2);">
                                        <RadzenTextBox Name="AdGroupSearch" @bind-Value="builderGroupName" Placeholder="Nom du groupe" Style="flex: 1;" @onkeydown="@(async e => { if (e.Key == "Enter") await ChercherGroupesAd(); })" />
                                        <RadzenButton Text="Rechercher" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@ChercherGroupesAd" IsBusy="@adGroupSearching" />
                                    </div>
                                    <span class="ap-help">Recherche dans l'annuaire avec les réglages enregistrés ; le groupe choisi est ajouté au filtre avec son DN exact</span>
                                    @if (adGroupResults != null)
                                    {
                                        @if (!adGroupResults.Any())
                                        {
                                            <span class="ap-help is-warn">Aucun groupe trouvé (vérifiez le domaine et le compte de service, puis enregistrez)</span>
                                        }
                                        else
                                        {
                                            <div class="ap-pick-list">
                                                @foreach (var g in adGroupResults)
                                                {
                                                    <div class="ap-pick-row">
                                                        <div class="txt"><div class="t">@g.Name</div><div class="d ap-mono">@g.DistinguishedName</div></div>
                                                        <RadzenButton Text="Ajouter au filtre" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small" Disabled="@(g.MemberOfFilter == null)" Click="@(() => AjouterGroupeAuFiltre(g))" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="ap-set-row">
                            <div><h3>Vérifier un compte</h3><p>Indique si un compte est couvert par le DN de base et le filtre affichés.</p></div>
                            <div class="ap-ctrl">
                                <div style="display: flex; gap: var(--ap-s2);">
                                    <RadzenTextBox @bind-Value="testAdQuery" Placeholder="Identifiant (ex. jdupont)" Style="flex: 1;" aria-label="Identifiant à vérifier" />
                                    <RadzenButton Text="Vérifier" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@TesterFiltreAd" IsBusy="@testAdFilterEnCours" />
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            }

            @* --- SUPERVISION --- *@
            @if (section == "Supervision")
            {
                <div class="ap-settings">
                    <section class="ap-card">
                        <div class="ap-set-row">
                            <div><h3>Supervision automatique</h3><p>Interroge régulièrement les imprimantes actives (ping et SNMP) pour leur état et leurs niveaux de toner.</p></div>
                            <div class="ap-ctrl">
                                <div class="ap-opt-row" style="padding: 0;">
                                    <div class="txt"><div class="t">Activée</div></div>
                                    <RadzenSwitch @bind-Value="@model.Monitoring_Enabled" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Supervision automatique" } })" />
                                </div>
                            </div>
                        </div>
                        <div class="ap-set-row">
                            <div><h3>Fréquence</h3><p>Délai entre deux passages sur tout le parc.</p></div>
                            <div class="ap-ctrl">
                                <div style="display: flex; align-items: center; gap: var(--ap-s2);">
                                    <RadzenNumeric TValue="int" @bind-Value="@model.Monitoring_IntervalMinutes" Min="1" Max="1440" Style="width: 140px;" Disabled="@(!model.Monitoring_Enabled)" aria-label="Intervalle en minutes" />
                                    <span class="ap-muted">minutes</span>
                                </div>
                            </div>
                        </div>
                        <div class="ap-set-row">
                            <div><h3>Plage horaire</h3><p>En dehors de cette plage, les imprimantes ne sont pas interrogées.</p></div>
                            <div class="ap-ctrl">
                                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--ap-s2);">
                                    <span>De</span>
                                    <RadzenNumeric TValue="int" @bind-Value="@model.Monitoring_StartHour" Min="0" Max="23" Style="width: 90px;" Disabled="@(!model.Monitoring_Enabled)" aria-label="Heure de début" />
                                    <span>h à</span>
