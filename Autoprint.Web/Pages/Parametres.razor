                                </RadzenText>
                                <RadzenRow Gap="1.5rem">
                                    <RadzenColumn Size="12" SizeMD="6" Style="display: flex; align-items: center; gap: 0.5rem;">
                                        <RadzenSwitch @bind-Value="@model.Monitoring_IncludeOffline" Name="IncOffline" />
                                        <RadzenLabel Text="Inclure les imprimantes Hors Ligne (Offline)" Component="IncOffline" Style="cursor:pointer;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6" Style="display: flex; align-items: center; gap: 0.5rem;">
                                        <RadzenSwitch @bind-Value="@model.Monitoring_IncludeWarning" Name="IncWarning" />
                                        <RadzenLabel Text="Inclure les alertes & avertissements (Warning)" Component="IncWarning" Style="cursor:pointer;" />
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenRow Gap="1.5rem">
                                    <RadzenColumn Size="12" SizeMD="6" Style="display: flex; align-items: center; gap: 0.5rem;">
                                        <RadzenSwitch @bind-Value="@model.Monitoring_IncludeCritical" Name="IncCritical" />
                                        <RadzenLabel Text="Inclure les pannes critiques (Critical)" Component="IncCritical" Style="cursor:pointer;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6" Style="display: flex; align-items: center; gap: 0.5rem;">
                                        <RadzenSwitch @bind-Value="@model.Monitoring_IncludeArchived" Name="IncArchived" />
                                        <RadzenLabel Text="Inclure les imprimantes archivées" Component="IncArchived" Style="cursor:pointer;" />
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenFieldset>

                        <RadzenFieldset Text="Jetons d'Intégration (Zabbix, PRTG, Centreon...)" Icon="vpn_key">
                            <RadzenStack Gap="1.5rem">
                                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-tertiary-color);">
                                    Générez des jetons d'authentification pour permettre à des systèmes tiers d'extraire l'état de supervision des imprimantes via l'API <code>GET api/v1/monitoring/export</code>.
                                </RadzenText>

                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; font-weight: bold;">Liste des Jetons Actifs</RadzenText>
                                    <RadzenButton Icon="add_circle" Text="Générer un Jeton" ButtonStyle="ButtonStyle.Success" Click="@OuvrirGenerationToken" />
                                </RadzenStack>

                                @if (tokensList == null)
                                {
                                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                                }
                                else if (!tokensList.Any())
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" Size="AlertSize.Small" AllowClose="false">
                                        Aucun jeton d'intégration actif. Cliquez sur "Générer un Jeton" ci-dessus pour en créer un.
                                    </RadzenAlert>
                                }
                                else
                                {
                                    <RadzenDataGrid Data="@tokensList" TItem="IntegrationToken" AllowPaging="true" PageSize="5" Style="width: 100%;">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="IntegrationToken" Property="Description" Title="Usage / Description" />
                                            <RadzenDataGridColumn TItem="IntegrationToken" Property="CreatedAt" Title="Créé le" Width="150px">
                                                <Template Context="t">
                                                    @t.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="IntegrationToken" Property="ExpiresAt" Title="Expire le" Width="150px">
                                                <Template Context="t">
                                                    @if (t.ExpiresAt.HasValue)
                                                    {
                                                        <span style="@(t.ExpiresAt < DateTime.UtcNow ? "color: var(--rz-danger); font-weight: bold;" : "")">
                                                            @t.ExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: var(--rz-text-disabled-color);">Jamais</span>
                                                    }
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="IntegrationToken" Title="Actions" Width="100px" TextAlign="TextAlign.Center">
                                                <Template Context="t">
                                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => SupprimerToken(t))" Tooltip="Révoquer" title="Révoquer ce jeton" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                }
                            </RadzenStack>
                        </RadzenFieldset>
                    </RadzenStack>
                }

            @* --- SCANNER RÉSEAU --- *@
            @if (section == "Scanner Réseau")
            {
                    <RadzenRow Class="rz-p-2" Gap="2rem">

                        <RadzenColumn Size="12" SizeLG="8">
                            <RadzenFieldset Text="Configuration Auto-Discovery" Icon="settings_remote">
                                <RadzenStack Gap="1rem">

                                    <RadzenRow>
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <RadzenLabel Text="Plages IP Cibles (CIDR)" Style="font-weight: bold;" />
                                            <RadzenTextArea @bind-Value="@scanConfig.TargetRanges" Placeholder="192.168.1.0/24&#10;10.0.0.0/16" Style="width: 100%; height: 120px; font-family: monospace;" />
                                            <small class="text-muted">Une plage par ligne (ou séparées par ;). Max /16.</small>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <RadzenLabel Text="Exclusions" />
                                            <RadzenTextArea @bind-Value="@scanConfig.ExcludedRanges" Placeholder="192.168.1.50/32" Style="width: 100%; height: 120px; font-family: monospace;" />
                                            <small class="text-muted">Réseaux ou IPs à ignorer.</small>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow>
                                        <RadzenColumn Size="12">
                                            <RadzenLabel Text="Sondes (Suffixes)" />
