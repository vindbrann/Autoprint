            if (r.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Imprimantes renommées", $"{namingChanges?.Count ?? 0} imprimante(s) renommée(s), à synchroniser.");
                showNamingDiff = false;
                namingSamples.Clear();
                await ChargerNommage();
            }
            else NotificationService.Notify(NotificationSeverity.Error, "Erreur", await r.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message); }
        finally { namingApplying = false; }
    }

