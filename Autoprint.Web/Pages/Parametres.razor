    private async Task SupprimerToken(IntegrationToken t)
    {
        var confirm = await DialogService.Confirm($"Révoquer le jeton '{t.Description}' ? Cette action est irréversible et bloquera toute supervision externe utilisant ce jeton.", "Confirmation de Révocation",
            new ConfirmOptions { OkButtonText = "Oui, révoquer", CancelButtonText = "Annuler" });

        if (confirm == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/IntegrationTokens/{t.Id}");
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Jeton révoqué", "Le jeton d'intégration a été révoqué.");
                    await LoadTokens();
                }
                else
                {
                    var msg = await response.Content.ReadAsStringAsync();
                    NotificationService.Notify(NotificationSeverity.Error, "Erreur", msg);
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
            }
        }
    }
