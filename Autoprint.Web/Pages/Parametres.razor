    private string? backupSecretsPassword;
    private string? restoreSecretsPassword;

    private async Task DownloadBackup()
    {
        bool withSecrets = !string.IsNullOrEmpty(backupSecretsPassword);
        if (withSecrets && backupSecretsPassword!.Length < PasswordPolicy.MinLength)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Mot de passe trop court", $"Le mot de passe de protection doit faire au moins {PasswordPolicy.MinLength} caractères.");
            return;
        }

        // Avertissement avant export (audit #9)
        var confirmed = await DialogService.Confirm(
            (withSecrets
                ? "Les mots de passe AD / SMTP et la clé d'API agent seront inclus, CHIFFRÉS avec votre mot de passe de protection : sans lui, ils ne pourront pas être restaurés. "
                : "Les mots de passe AD / SMTP et la clé d'API agent ne seront PAS inclus : après une restauration sur un autre serveur, il faudra les ressaisir. ") +
            "Le fichier contient aussi les empreintes des mots de passe des comptes locaux et toute la configuration : " +
            "conservez-le dans un emplacement protégé (accès réservé aux administrateurs) et ne l'envoyez pas par e-mail. Continuer ?",
            "Sauvegarde : données sensibles",
            new ConfirmOptions { OkButtonText = "J'ai compris, télécharger", CancelButtonText = "Annuler" });
        if (confirmed != true) return;

        try
        {
            NotificationService.Notify(NotificationSeverity.Info, "Export", "Préparation du téléchargement...");

            var response = await Http.PostAsJsonAsync("api/Backup/export", new Autoprint.Shared.DTOs.BackupExportRequestDto { SecretsPassword = withSecrets ? backupSecretsPassword : null });

            if (response.IsSuccessStatusCode)
            {
                using var fileStream = await response.Content.ReadAsStreamAsync();
                var fileName = $"Autoprint_Backup_{DateTime.Now:yyyyMMdd_HHmm}.json";

                using var streamRef = new DotNetStreamReference(fileStream);
                await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Téléchargement démarré.");
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", "Accès refusé par le serveur.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
    }
    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            uploadedBackup = await (JsonSerializer.DeserializeAsync<Autoprint.Shared.DTOs.BackupRootDto>(stream, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }));
            if (uploadedBackup == null || string.IsNullOrWhiteSpace(uploadedBackup.Version)) throw new JsonException();
        }
        catch (JsonException)
        {
            // Pas le détail technique de la désérialisation (types .NET, numéros de ligne) (B57)
            uploadedBackup = null;
            NotificationService.Notify(NotificationSeverity.Error, "Fichier invalide", "Ce fichier n'est pas une sauvegarde Autoprint lisible (fichier modifié ou endommagé ?).");
        }
        catch (IOException)
        {
            uploadedBackup = null;
            NotificationService.Notify(NotificationSeverity.Error, "Fichier invalide", "Fichier illisible ou trop volumineux (5 Mo au maximum).");
        }
    }

    private async Task ExecuteRestore()
    {
        if (uploadedBackup == null) return;
        var confirm = await DialogService.Confirm("Toutes les données du serveur seront remplacées par celles de la sauvegarde. Continuer ?", "Restaurer la configuration", new ConfirmOptions() { OkButtonText = "Oui, écraser", CancelButtonText = "Non" });
        if (confirm == true)
        {
            isRestoring = true;
            try
            {
                uploadedBackup.SecretsPassword = uploadedBackup.SecretsProtected ? restoreSecretsPassword : null;
                var res = await Http.PostAsJsonAsync("api/Backup/restore", uploadedBackup);
                if (res.IsSuccessStatusCode)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Terminé", "Restauration effectuée.");
                    uploadedBackup = null;
                }
                else NotificationService.Notify(NotificationSeverity.Error, "Erreur", await res.Content.ReadAsStringAsync());
            }
            catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message); }
            finally { isRestoring = false; }
        }
    }

    private async Task ChargerNommage()
    {
        if (!namingSamples.Any())
        {
            try { namingSamples = (await Http.GetFromJsonAsync<List<Imprimante>>("api/Imprimantes") ?? new()).OrderBy(i => i.NomAffiche).ToList(); }
            catch { namingSamples = new(); }
            namingSampleId = namingSamples.FirstOrDefault()?.Id ?? 0;
        }
        await RecalculerNommage(CancellationToken.None);
    }

    private async Task InsererToken(string key)
    {
        // Insertion à l'emplacement du curseur (app.js), puis recalcul de l'aperçu
        var value = await JS.InvokeAsync<string>("apInsertAtCursor", "naming-pattern", "{" + key + "}");
        model.NamingTemplate = value;
        await OnPatternChanged();
    }

    // Aperçu et liste des changements recalculés 300 ms après la dernière frappe
    private async Task OnPatternChanged()
    {
        namingCts?.Cancel();
        var cts = namingCts = new CancellationTokenSource();
        try { await Task.Delay(300, cts.Token); } catch (TaskCanceledException) { return; }
        await RecalculerNommage(cts.Token);
    }

    private async Task RecalculerNommage(CancellationToken ct)
    {
        var template = model.NamingTemplate ?? "";
        var sample = namingSamples.FirstOrDefault(i => i.Id == namingSampleId);
        var dto = new
        {
            Template = template,
            Ip = sample?.AdresseIp ?? "10.12.4.30",
            LieuNom = sample?.Emplacement?.Nom ?? "Siège",
            LieuCode = sample?.Emplacement?.Code ?? "SIEGE",
            ImpCode = sample?.Code ?? "P0042",
            ModeleNom = sample?.Modele?.Nom ?? "IM C3000",
            MarqueNom = sample?.Modele?.Marque?.Nom ?? "Ricoh"
        };
        try
        {
            var r = await Http.PostAsJsonAsync("api/Naming/Preview", dto, ct);
            if (r.IsSuccessStatusCode)
            {
                var json = await r.Content.ReadFromJsonAsync<JsonElement>(cancellationToken: ct);
                namingPreview = json.TryGetProperty("generatedName", out var p) ? p.GetString() ?? "" : "";
            }
        }
        catch (OperationCanceledException) { return; }
        catch { namingPreview = ""; }

        var unknown = System.Text.RegularExpressions.Regex.Matches(template, @"\{[^}]*\}").Select(m => m.Value)
            .Where(v => !NamingTokens.Any(k => string.Equals("{" + k.Key + "}", v, StringComparison.OrdinalIgnoreCase))).Distinct().ToList();
        if (string.IsNullOrWhiteSpace(template)) { namingCheckOk = false; namingCheck = "Saisissez une règle"; }
        else if (unknown.Any()) { namingCheckOk = false; namingCheck = $"Variable inconnue : {string.Join(", ", unknown)}"; }
        else if (string.IsNullOrEmpty(namingPreview)) { namingCheckOk = false; namingCheck = "La règle donne un nom vide"; }
        else if (namingPreview.IndexOfAny(new[] { '\\', '/', ':', '*', '?', '"', '<', '>', '|', ',' }) >= 0) { namingCheckOk = false; namingCheck = "Caractère interdit dans un nom Windows (\\ / : * ? \" < > | ,)"; }
        else if (model.NamingSameShare && namingPreview.Length > 80) { namingCheckOk = false; namingCheck = $"{namingPreview.Length} caractères : 80 au maximum pour un nom de partage"; }
        else { namingCheckOk = true; namingCheck = $"{namingPreview.Length} caractères, valide pour une file et un partage Windows"; }

        if (model.NamingEnabled && namingCheckOk)
        {
            try
            {
                var r = await Http.PostAsJsonAsync("api/Naming/PreviewChanges", new { Template = template, SameShare = model.NamingSameShare }, ct);
                namingChanges = r.IsSuccessStatusCode ? await r.Content.ReadFromJsonAsync<List<NamingChangeView>>(cancellationToken: ct) ?? new() : new();
            }
            catch (OperationCanceledException) { return; }
            catch { namingChanges = new(); }
        }
        else namingChanges = new();
        if (namingChanges.Count == 0) showNamingDiff = false;
        StateHasChanged();
    }

    private async Task AppliquerNommageAuParc()
    {
        namingApplying = true;
        try
        {
            var save = await Http.PostAsJsonAsync("api/Settings/Save", model);
            if (!save.IsSuccessStatusCode) { NotificationService.Notify(NotificationSeverity.Error, "Erreur", await save.Content.ReadAsStringAsync()); return; }
            savedSnapshot = Snapshot();
            var r = await Http.PostAsync("api/Naming/ApplyToNames", null);
            if (r.IsSuccessStatusCode && model.NamingSameShare) r = await Http.PostAsync("api/Naming/ApplyToShares", null);
            if (r.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Imprimantes renommées", $"{namingChanges?.Count ?? 0} imprimante(s) renommée(s), à synchroniser.");
                showNamingDiff = false;
                namingSamples.Clear();
                await ChargerNommage();
            }
            else NotificationService.Notify(NotificationSeverity.Error, "Erreur", await r.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message); }
        finally { namingApplying = false; }
    }

