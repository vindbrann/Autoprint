                                    <RadzenColumn Size="12" SizeMD="6" Style="display: flex; align-items: center; gap: 0.5rem;">
                                        <RadzenSwitch @bind-Value="@model.Monitoring_IncludeOffline" Name="IncOffline" />
                                        <RadzenLabel Text="Inclure les imprimantes Hors Ligne (Offline)" Component="IncOffline" Style="cursor:pointer;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6" Style="display: flex; align-items: center; gap: 0.5rem;">
                                        <RadzenSwitch @bind-Value="@model.Monitoring_IncludeWarning" Name="IncWarning" />
                                        <RadzenLabel Text="Inclure les alertes & avertissements (Warning)" Component="IncWarning" Style="cursor:pointer;" />
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenRow Gap="1.5rem">
                                    <RadzenColumn Size="12" SizeMD="6" Style="display: flex; align-items: center; gap: 0.5rem;">
                                        <RadzenSwitch @bind-Value="@model.Monitoring_IncludeCritical" Name="IncCritical" />
                                        <RadzenLabel Text="Inclure les pannes critiques (Critical)" Component="IncCritical" Style="cursor:pointer;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6" Style="display: flex; align-items: center; gap: 0.5rem;">
                                        <RadzenSwitch @bind-Value="@model.Monitoring_IncludeArchived" Name="IncArchived" />
                                        <RadzenLabel Text="Inclure les imprimantes archivées" Component="IncArchived" Style="cursor:pointer;" />
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenFieldset>

                        <RadzenFieldset Text="Jetons d'Intégration (Zabbix, PRTG, Centreon...)" Icon="vpn_key">
                            <RadzenStack Gap="1.5rem">
                                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-tertiary-color);">
                                    Générez des jetons d'authentification pour permettre à des systèmes tiers d'extraire l'état de supervision des imprimantes via l'API <code>GET api/v1/monitoring/export</code>.
                                </RadzenText>

                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; font-weight: bold;">Liste des Jetons Actifs</RadzenText>
                                    <RadzenButton Icon="add_circle" Text="Générer un Jeton" ButtonStyle="ButtonStyle.Success" Click="@OuvrirGenerationToken" />
                                </RadzenStack>

                                @if (tokensList == null)
                                {
                                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                                }
                                else if (!tokensList.Any())
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" Size="AlertSize.Small" AllowClose="false">
                                        Aucun jeton d'intégration actif. Cliquez sur "Générer un Jeton" ci-dessus pour en créer un.
