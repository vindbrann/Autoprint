                                        </RadzenColumn>
                                    </RadzenRow>

                                    <hr class="rz-my-4" />

                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" Class="rz-mb-0">Planification</RadzenText>

                                    <RadzenRow>
                                        <RadzenColumn Size="12" SizeMD="3">
                                            <RadzenLabel Text="Heure (0-23h)" />
                                            <RadzenNumeric @bind-Value="@scanConfig.ScheduleHour" Min="0" Max="23" Style="width: 100%;" />
                                        </RadzenColumn>

                                        <RadzenColumn Size="12" SizeMD="9">
                                            <RadzenLabel Text="Jours d'exécution" Class="rz-mb-2" />
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                                                @{
                                                    var joursFr = new Dictionary<ScanDays, string> {
                                                                                        { ScanDays.Monday, "LUN" }, { ScanDays.Tuesday, "MAR" }, { ScanDays.Wednesday, "MER" },
                                                                                        { ScanDays.Thursday, "JEU" }, { ScanDays.Friday, "VEN" }, { ScanDays.Saturday, "SAM" },
                                                                                        { ScanDays.Sunday, "DIM" }
                                                                                        };
                                                }
                                                @foreach (var kvp in joursFr)
                                                {
                                                    <div style="display: flex; align-items: center;">
                                                        <RadzenCheckBox TValue="bool" Value="@HasDay(kvp.Key)" Change="@(args => ToggleDay(args, kvp.Key))" Name="@kvp.Key.ToString()" />
                                                        <RadzenLabel Text="@kvp.Value" Component="@kvp.Key.ToString()" Class="rz-ml-1" Style="cursor:pointer" />
                                                    </div>
                                                }
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Class="rz-mt-4">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                            <RadzenSwitch @bind-Value="@scanConfig.IsEnabled" />
                                            <RadzenLabel Text="Activer la planification" Style="@(scanConfig.IsEnabled ? "color: var(--rz-success); font-weight:bold" : null)" />
                                        </RadzenStack>

                                        <RadzenButton Text="Enregistrer la Configuration" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@SaveScanConfig" />
                                    </RadzenStack>

                                </RadzenStack>
                            </RadzenFieldset>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeLG="4">
                            <RadzenCard Variant="Variant.Outlined" Style="border-top: 4px solid var(--rz-primary);">
                                <RadzenStack Gap="1rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenIcon Icon="play_circle" Style="color: var(--rz-primary);" />
                                        <RadzenText TextStyle="TextStyle.H6" Class="rz-mb-0 rz-color-primary">Scan Manuel</RadzenText>
                                    </RadzenStack>

                                    <RadzenText TextStyle="TextStyle.Body2">
                                        Lancez une analyse immédiate avec ces paramètres.
                                    </RadzenText>

                                    <RadzenButton Text="Lancer maintenant" Icon="radar" ButtonStyle="ButtonStyle.Success" Click="@RunManualScan" IsBusy="@isScanning" BusyText="Analyse en cours..." Style="width: 100%;" />

                                    @if (!string.IsNullOrEmpty(scanConfig.LastRunResult))
                                    {
                                        <RadzenAlert AlertStyle="@(scanConfig.LastRunResult.Contains("R.A.S") ? AlertStyle.Info : AlertStyle.Success)" Variant="Variant.Flat" Size="AlertSize.Small" AllowClose="false" Class="rz-mt-2">
                                            <div><strong>Résultat :</strong></div>
                                            <div>@scanConfig.LastRunResult</div>
                                            @if (scanConfig.LastRunDate.HasValue)
                                            {
                                                <small class="text-muted">@scanConfig.LastRunDate.Value.ToLocalTime().ToString("g")</small>
                                            }
                                        </RadzenAlert>
                                    }
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>
                    </RadzenRow>
                }

            @* --- SECURITE --- *@
            @if (section == "Sécurité")
            {
                    <RadzenStack Gap="2rem" Class="rz-p-2">
                        <RadzenCard Variant="Variant.Outlined" Style="border-color: var(--rz-warning);">
                            <RadzenStack Gap="1rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenIcon Icon="vpn_key" Style="color: var(--rz-warning); font-size: 2rem;" />
                                    <RadzenStack Gap="0">
                                        <RadzenText TextStyle="TextStyle.H6" Class="rz-mb-0" Style="color: var(--rz-warning);">Clé d'API Agent (Machine-to-Machine)</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-tertiary-color);">Cette clé permet aux postes clients de s'identifier. Elle est demandée à l'installation du MSI client (APIKEY=...).</RadzenText>
                                    </RadzenStack>
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                    <RadzenTextBox Value="@model.AgentApiKey" Disabled="true" Style="width: 100%; font-family: monospace; font-size: 1.1rem; letter-spacing: 1px;" />
                                    <RadzenButton Icon="content_copy" Text="Copier la clé" ButtonStyle="ButtonStyle.Secondary" Click="@CopyAgentKey" Tooltip="Copie la clé en clair dans le presse-papiers (action tracée dans l'audit)" />
                                </RadzenStack>
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-tertiary-color);">
                                    La clé n'est jamais affichée en clair. Chaque copie est enregistrée dans le journal d'audit.
                                </RadzenText>

                                @* Changement de clé (backlog B18) *@
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Class="rz-mt-2">
                                    <RadzenLabel Text="Ancienne clé encore acceptée pendant" Component="Transition" />
                                    <RadzenDropDown Name="Transition" TValue="int" @bind-Value="@agentKeyTransitionDays" Data="@agentKeyTransitions" TextProperty="Text" ValueProperty="Value" Style="width: 170px;" />
                                    <RadzenButton Icon="autorenew" Text="Générer une nouvelle clé" ButtonStyle="ButtonStyle.Warning" Click="@RotateAgentKey" IsBusy="@rotatingAgentKey" />
                                </RadzenStack>
                                @if (agentKeyPreviousUntil != null && agentKeyPreviousUntil > DateTime.UtcNow)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Size="AlertSize.Small" AllowClose="false">
                                        Période de transition : l'ancienne clé est encore acceptée jusqu'au @agentKeyPreviousUntil.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm").
                                        Redéployez la nouvelle clé sur les postes (MSI <code>APIKEY=…</code> ou GPO sur <code>HKLM\SOFTWARE\Autoprint\APIKEY</code>) avant cette date.
                                    </RadzenAlert>
                                }
                            </RadzenStack>
                        </RadzenCard>

                        <RadzenFieldset Text="Politique de Mots de Passe" Icon="password">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenStack Gap="0">
                                        <RadzenLabel Text="Expiration des mots de passe locaux" Style="font-weight: 600;" />
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="4px">
                                            <RadzenIcon Icon="info" Style="font-size: 1rem; color: var(--rz-secondary);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary); margin: 0;">
                                                Mettre <strong>0</strong> pour désactiver (Toujours valide).
                                            </RadzenText>
                                        </RadzenStack>
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" JustifyContent="JustifyContent.End">
                                        <RadzenNumeric @bind-Value="@model.PasswordExpirationDays" Min="0" Max="999" Style="width: 100px;" />
                                        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">jours</RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenFieldset>


                    </RadzenStack>
                }

            @if (IsDirty)
            {
                <div class="ap-savebar" role="region" aria-label="Modifications en attente">
                    <RadzenIcon Icon="edit_note" />
                    <span>Modifications non enregistrées</span>
                    <span class="ap-grow"></span>
                    <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@AnnulerModifications" />
                    <RadzenButton Text="Enregistrer" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@Sauvegarder" IsBusy="@sauvegardeEnCours" />
                </div>
            }
        </div>
    </div>
}

@code {
    private SettingsModel model = new();
    private bool isLoading = true;
    private bool sauvegardeEnCours = false;
    private bool testEnCours = false;
    private bool testAdFilterEnCours = false;
    private int agentKeyTransitionDays = 30;
    private bool rotatingAgentKey;
    private DateTime? agentKeyPreviousUntil;
    private readonly object[] agentKeyTransitions =
    {
        new { Text = "7 jours", Value = 7 },
        new { Text = "30 jours", Value = 30 },
        new { Text = "90 jours", Value = 90 },
        new { Text = "Aucune (révocation immédiate)", Value = 0 }
    };

    private async Task RotateAgentKey()
    {
        var message = agentKeyTransitionDays > 0
            ? $"Une nouvelle clé va être générée. L'ancienne restera acceptée {agentKeyTransitionDays} jour(s) : redéployez la nouvelle clé sur tous les postes pendant ce délai. Continuer ?"
            : "Une nouvelle clé va être générée et l'ancienne sera REFUSÉE IMMÉDIATEMENT : tous les postes non mis à jour perdront l'accès au serveur. Continuer ?";
        if (await DialogService.Confirm(message, "Nouvelle clé d'API agent", new ConfirmOptions { OkButtonText = "Générer", CancelButtonText = "Annuler" }) != true) return;

        rotatingAgentKey = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/Settings/agent-key/rotate", new { TransitionDays = agentKeyTransitionDays });
            if (!response.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", await response.Content.ReadAsStringAsync());
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<AgentKeyRotationResult>();
            agentKeyPreviousUntil = result?.PreviousValidUntil;
            await DialogService.Alert(
                $"Nouvelle clé : {result?.Key}\n\nCopiez-la maintenant pour la déployer sur les postes. Elle reste récupérable plus tard avec « Copier la clé ».",
                "Nouvelle clé d'API agent", new AlertOptions { OkButtonText = "J'ai copié la clé" });
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message); }
        finally { rotatingAgentKey = false; }
    }

    private class AgentKeyRotationResult { public string Key { get; set; } = ""; public DateTime? PreviousValidUntil { get; set; } }

    private async Task CopyAgentKey()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<AgentKeyResponse>("api/Settings/agent-key");
            if (string.IsNullOrEmpty(response?.Key)) throw new InvalidOperationException("Clé introuvable.");
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", response.Key);
                NotificationService.Notify(NotificationSeverity.Success, "Copiée", "La clé d'API agent est dans le presse-papiers.");
            }
            catch (JSException)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Copie impossible", "Le navigateur a refusé l'accès au presse-papiers (la console doit être ouverte en HTTPS).");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", "Impossible de récupérer la clé : " + ex.Message);
        }
    }

    private class AgentKeyResponse { public string Key { get; set; } = ""; }
    private string testEmailTo = "";
    private string testAdQuery = "";
    private string builderGroupName = "";
    private BackupRootDto? uploadedBackup;
    private bool isRestoring = false;
    private string testLieu = "Bur", testLieuCode = "B", testImpCode = "P1", testIp = "1.1.1.1", previewResult = "";
    private string testMarque = "HP";
    private string testModele = "LaserJet";

    private DiscoveryProfile scanConfig = new DiscoveryProfile();
    private bool isScanning = false;
    private List<IntegrationToken>? tokensList;

    private class SettingsModel
    {
        public string AgentApiKey { get; set; } = "";
        public int LogRetentionDays { get; set; } = 180;
        public string SmtpHost { get; set; } = "";
        public int SmtpPort { get; set; } = 25;
        public string SmtpUser { get; set; } = "";
        public string SmtpPass { get; set; } = "";
        public bool SmtpEnableSsl { get; set; } = false;
        public string SmtpFromAddress { get; set; } = "";
        public string NamingTemplate { get; set; } = "";
        public bool NamingEnabled { get; set; } = false;
        public bool NamingSameShare { get; set; } = false;
        public bool Printer_DefaultDirectModeEnabled { get; set; } = false;
        public int PasswordExpirationDays { get; set; } = 90;
        public string AdDomain { get; set; } = "";
        public string AdBaseDn { get; set; } = "";
        public string AdLdapFilter { get; set; } = "";
        public bool AdUseServiceAccount { get; set; } = false;
        public string AdServiceUser { get; set; } = "";
        public string AdServicePassword { get; set; } = "";
        public string AdAdminEmails { get; set; } = "";
        public bool Monitoring_Enabled { get; set; } = true;
        public int Monitoring_IntervalMinutes { get; set; } = 60;
        public int Monitoring_StartHour { get; set; } = 8;
        public int Monitoring_EndHour { get; set; } = 18;
        public bool Monitoring_ScanOnWeekends { get; set; } = true;
        public bool Monitoring_IncludeOffline { get; set; } = true;
        public bool Monitoring_IncludeWarning { get; set; } = true;
        public bool Monitoring_IncludeCritical { get; set; } = true;
        public bool Monitoring_IncludeArchived { get; set; } = false;
    }

    protected override Task OnInitializedAsync() => ChargerParametres();

    private async Task ChargerParametres()
    {
        isLoading = true;
        try
        {
            var s = await Http.GetFromJsonAsync<List<Autoprint.Shared.ServerSetting>>("api/Settings");
            model.AgentApiKey = GV(s, "AgentApiKey");
            agentKeyPreviousUntil = DateTime.TryParse(GV(s, "AgentApiKeyPreviousExpiresAt"), null, System.Globalization.DateTimeStyles.RoundtripKind, out var until) ? until : null;
            model.LogRetentionDays = int.Parse(GV(s, "LogRetentionDays", "180"));
            model.SmtpHost = GV(s, "SmtpHost");
            model.SmtpPort = int.Parse(GV(s, "SmtpPort", "25"));
            model.SmtpUser = GV(s, "SmtpUser");
            model.SmtpPass = GV(s, "SmtpPass");
            model.SmtpEnableSsl = bool.Parse(GV(s, "SmtpEnableSsl", "false"));
            model.SmtpFromAddress = GV(s, "SmtpFromAddress");
            model.NamingTemplate = GV(s, "NamingTemplate");
            model.NamingEnabled = bool.Parse(GV(s, "NamingEnabled", "false"));
            model.NamingSameShare = bool.Parse(GV(s, "NamingSameShare", "false"));
            model.Printer_DefaultDirectModeEnabled = bool.Parse(GV(s, "Printer_DefaultDirectModeEnabled", "false"));
            model.PasswordExpirationDays = int.Parse(GV(s, "PasswordExpirationDays", "90"));
            model.AdDomain = GV(s, "AdDomain");
            model.AdBaseDn = GV(s, "AdBaseDn");
            model.AdLdapFilter = GV(s, "AdLdapFilter");
            model.AdUseServiceAccount = bool.Parse(GV(s, "AdUseServiceAccount", "false"));
            model.AdServiceUser = GV(s, "AdServiceUser");
            model.AdAdminEmails = GV(s, "AdAdminEmails");
            model.Monitoring_Enabled = bool.Parse(GV(s, "Monitoring_Enabled", "true"));
            model.Monitoring_IntervalMinutes = int.Parse(GV(s, "Monitoring_IntervalMinutes", "60"));
            model.Monitoring_StartHour = int.Parse(GV(s, "Monitoring_StartHour", "8"));
            model.Monitoring_EndHour = int.Parse(GV(s, "Monitoring_EndHour", "18"));
            model.Monitoring_ScanOnWeekends = bool.Parse(GV(s, "Monitoring_ScanOnWeekends", "true"));
            model.Monitoring_IncludeOffline = bool.Parse(GV(s, "Monitoring_IncludeOffline", "true"));
            model.Monitoring_IncludeWarning = bool.Parse(GV(s, "Monitoring_IncludeWarning", "true"));
            model.Monitoring_IncludeCritical = bool.Parse(GV(s, "Monitoring_IncludeCritical", "true"));
            model.Monitoring_IncludeArchived = bool.Parse(GV(s, "Monitoring_IncludeArchived", "false"));

            await LoadScanProfile();
            await LoadTokens();
            savedSnapshot = Snapshot();
        }
        catch { }
        finally { isLoading = false; }
    }

    // --- Menu des sections et barre d'enregistrement (charte B77) ---
    private string section = "Maintenance";
