                            </div>
                        </div>
                        <div class="ap-set-row">
                            <div><h3>Mots de passe locaux</h3><p>Durée de validité des mots de passe des comptes locaux Autoprint.</p></div>
                            <div class="ap-ctrl">
                                <div style="display: flex; align-items: center; gap: var(--ap-s2);">
                                    <RadzenNumeric @bind-Value="@model.PasswordExpirationDays" Min="0" Max="999" Style="width: 120px;" aria-label="Validité en jours" />
                                    <span class="ap-muted">jours</span>
                                </div>
                                <span class="ap-help">0 : jamais d'expiration</span>
                            </div>
                        </div>
                        <div class="ap-set-row">
                            <div><h3>Déconnexion après inactivité</h3><p>La console se ferme quand personne ne l'a utilisée pendant ce délai, dans aucun onglet.</p></div>
                            <div class="ap-ctrl">
                                <div style="display: flex; align-items: center; gap: var(--ap-s2);">
                                    <RadzenNumeric @bind-Value="@model.IdleTimeoutMinutes" Min="0" Max="1440" Style="width: 120px;" aria-label="Délai d'inactivité en minutes" />
                                    <span class="ap-muted">minutes</span>
                                </div>
                                <span class="ap-help">0 : jamais ; s'applique à la prochaine connexion des utilisateurs</span>
                            </div>
                        </div>
                    </section>
                    <section class="ap-card">
                        <div class="ap-set-row is-stack">
                            <div>
                                <h3>Noms acceptés par le serveur</h3>
                                <p>Le serveur ne répond qu'aux adresses de cette liste (console et postes clients), plus localhost. Pendant un changement de nom, gardez l'ancien et le nouveau, puis retirez l'ancien quand tous les postes utilisent le nouveau.</p>
                            </div>
                            <div class="ap-ctrl">
                                <div class="ap-chips" role="list" aria-label="Noms acceptés">
                                    @foreach (var h in allowedHosts)
                                    {
                                        bool isCurrent = string.Equals(h, allowedHostsCurrent, StringComparison.OrdinalIgnoreCase);
                                        <span class="ap-chip is-host" role="listitem" style="cursor: default;" title="@h">
                                            @h
                                            @if (isCurrent)
                                            {
                                                <RadzenIcon Icon="lock" title="Nom de la console ouverte : ne peut pas être retiré" Style="color: var(--ap-text-muted);" />
                                            }
                                            else
                                            {
                                                <button type="button" class="ap-chip-x" title="Retirer @h" aria-label="Retirer @h" disabled="@allowedHostsBusy" @onclick="@(() => RetirerNomAccepte(h))"><RadzenIcon Icon="close" /></button>
                                            }
                                        </span>
                                    }
                                    @if (allowedHosts.Count == 0)
                                    {
                                        <span class="ap-help is-warn">Tous les noms sont acceptés (serveur mis à jour sans nom public) : ajoutez le nom de la console.</span>
                                    }
                                </div>
                                <div style="display: flex; gap: var(--ap-s2); margin-top: var(--ap-s2); max-width: 520px;">
                                    <RadzenTextBox @bind-Value="@nouveauNomAccepte" Placeholder="autoprint.mondomaine.fr" Style="flex: 1; min-width: 0;" Class="ap-mono" aria-label="Nom à ajouter" />
                                    <RadzenButton Icon="add" Text="Ajouter" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@AjouterNomAccepte" IsBusy="@allowedHostsBusy" Disabled="@string.IsNullOrWhiteSpace(nouveauNomAccepte)" />
                                </div>
                                <span class="ap-help">Pris en compte immédiatement, sans redémarrage ; chaque modification est inscrite au journal d'audit. Le nom doit aussi avoir sa liaison HTTPS (certificat) dans IIS.</span>
                            </div>
                        </div>
                    </section>
                    <section class="ap-card ap-zone-sensible">
                        <div class="ap-set-row">
                            <div><span class="ap-zone-label"><RadzenIcon Icon="warning" Style="font-size: 14px;" />Zone sensible</span><h3 style="margin-top: 6px;">Nouvelle clé d'API</h3><p>Remplace la clé des postes clients. Ils devront recevoir la nouvelle clé avant la fin de la transition.</p></div>
                            <div class="ap-ctrl">
                                <div class="ap-field">
                                    <RadzenLabel Text="Ancienne clé encore acceptée pendant" Component="Transition" />
                                    <RadzenDropDown Name="Transition" TValue="int" @bind-Value="@agentKeyTransitionDays" Data="@agentKeyTransitions" TextProperty="Text" ValueProperty="Value" Style="width: 200px;" />
                                </div>
                                <div><RadzenButton Icon="autorenew" Text="Générer une nouvelle clé" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@RotateAgentKey" IsBusy="@rotatingAgentKey" /></div>
                                @if (agentKeyPreviousUntil != null && agentKeyPreviousUntil > DateTime.UtcNow)
                                {
                                    <div class="ap-name-note"><RadzenIcon Icon="info" />Transition en cours : l'ancienne clé reste acceptée jusqu'au @agentKeyPreviousUntil.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"). Redéployez la nouvelle clé (MSI APIKEY=… ou GPO HKLM\SOFTWARE\Autoprint\APIKEY) avant.</div>
                                }
                            </div>
                        </div>
                    </section>
                </div>
            }

            @if (IsDirty)
            {
                <div class="ap-savebar" role="region" aria-label="Modifications en attente">
                    <RadzenIcon Icon="edit_note" />
                    <span>Modifications non enregistrées</span>
                    <span class="ap-grow"></span>
                    <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@AnnulerModifications" />
                    <RadzenButton Text="Enregistrer" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@Sauvegarder" IsBusy="@sauvegardeEnCours" />
                </div>
            }
        </div>
    </div>
}

@code {
    private SettingsModel model = new();
    private bool isLoading = true;
    private bool sauvegardeEnCours = false;
    private bool testEnCours = false;
    private bool testAdFilterEnCours = false;
    private int agentKeyTransitionDays = 30;
    private bool rotatingAgentKey;
    private DateTime? agentKeyPreviousUntil;
    private readonly object[] agentKeyTransitions =
    {
        new { Text = "7 jours", Value = 7 },
        new { Text = "30 jours", Value = 30 },
        new { Text = "90 jours", Value = 90 },
        new { Text = "Aucune (révocation immédiate)", Value = 0 }
    };

    private async Task RotateAgentKey()
    {
        if (rotatingAgentKey) return; // double clic : une seule rotation à la fois
        rotatingAgentKey = true;
        try
        {
            // Transition déjà en cours (recette du 12/11, double clic) : une seule « ancienne » clé est gardée, la clé d'origine
            // serait refusée tout de suite. Le serveur refuse alors la rotation (409) sauf confirmation explicite (Force).
            bool transitionEnCours = agentKeyPreviousUntil != null && agentKeyPreviousUntil > DateTime.UtcNow;
            if (transitionEnCours)
            {
                if (!await ConfirmerRotationForcee(agentKeyPreviousUntil!.Value)) return;
            }
            else
            {
                var message = agentKeyTransitionDays > 0
                    ? $"Une nouvelle clé va être générée. L'ancienne restera acceptée {agentKeyTransitionDays} jour(s) : redéployez la nouvelle clé sur tous les postes pendant ce délai. Continuer ?"
                    : "Une nouvelle clé va être générée et l'ancienne sera REFUSÉE IMMÉDIATEMENT : tous les postes non mis à jour perdront l'accès au serveur. Continuer ?";
                if (await DialogService.Confirm(message, "Nouvelle clé d'API agent", new ConfirmOptions { OkButtonText = "Générer", CancelButtonText = "Annuler" }) != true) return;
            }

            var response = await Http.PostAsJsonAsync("api/Settings/agent-key/rotate", new { TransitionDays = agentKeyTransitionDays, Force = transitionEnCours });
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                // Transition lancée entre-temps (autre onglet, autre administrateur) : on demande la confirmation explicite
                var conflict = await response.Content.ReadFromJsonAsync<RotationConflict>();
                if (!await ConfirmerRotationForcee(conflict?.TransitionUntil ?? DateTime.UtcNow)) return;
                response = await Http.PostAsJsonAsync("api/Settings/agent-key/rotate", new { TransitionDays = agentKeyTransitionDays, Force = true });
            }
            if (!await response.CheckAsync(NotificationService, "Nouvelle clé refusée")) return;

            var result = await response.Content.ReadFromJsonAsync<AgentKeyRotationResult>();
            agentKeyPreviousUntil = result?.PreviousValidUntil;
            var key = result?.Key ?? "";
            await DialogService.OpenAsync("Nouvelle clé d'API agent", ds =>
                @<div style="display: flex; flex-direction: column; gap: var(--ap-s3);">
                    <div>Nouvelle clé :</div>
                    <div class="ap-mono" style="font-size: 15px; user-select: all; word-break: break-all;">@key</div>
                    <div class="ap-muted">Copiez-la maintenant pour la déployer sur les postes. Elle reste récupérable plus tard avec « Copier ».</div>
                    <div style="display: flex; justify-content: flex-end;"><RadzenButton Text="J'ai copié la clé" ButtonStyle="ButtonStyle.Primary" Click="@(() => ds.Close(true))" /></div>
                </div>, new DialogOptions { Width = "460px" });
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message); }
        finally { rotatingAgentKey = false; }
    }

    private async Task<bool> ConfirmerRotationForcee(DateTime until)
        => await DialogService.Confirm(
            $"Une transition de clé est déjà en cours (jusqu'au {until.ToLocalTime():dd/MM/yyyy HH:mm}). Générer encore une clé REFUSERA IMMÉDIATEMENT la clé d'origine : les postes qui ne l'ont pas encore remplacée perdront l'accès au serveur. Forcer quand même ?",
            "Transition déjà en cours", new ConfirmOptions { OkButtonText = "Forcer une nouvelle clé", CancelButtonText = "Annuler" }) == true;

    private class RotationConflict { public string? Message { get; set; } public DateTime? TransitionUntil { get; set; } }

    private class AgentKeyRotationResult { public string Key { get; set; } = ""; public DateTime? PreviousValidUntil { get; set; } }

    // ---------- Noms acceptés par le serveur (B82) ----------
    private List<string> allowedHosts = new();
    private string? allowedHostsCurrent;
    private string? nouveauNomAccepte;
    private bool allowedHostsBusy;

    private class AllowedHostsDto { public List<string> Hosts { get; set; } = new(); public string? CurrentHost { get; set; } }

    private async Task ChargerNomsAcceptes()
    {
        try
        {
            var dto = await Http.GetFromJsonAsync<AllowedHostsDto>("api/Settings/allowed-hosts");
            allowedHosts = dto?.Hosts ?? new();
            allowedHostsCurrent = dto?.CurrentHost;
        }
        catch { }
    }

    private async Task AjouterNomAccepte()
    {
        var nom = (nouveauNomAccepte ?? "").Trim().Replace("https://", "", StringComparison.OrdinalIgnoreCase).Replace("http://", "", StringComparison.OrdinalIgnoreCase).TrimEnd('/');
        if (nom.Length == 0) return;
        if (allowedHosts.Any(h => string.Equals(h, nom, StringComparison.OrdinalIgnoreCase))) { nouveauNomAccepte = ""; return; }
        // Liste vide (tout accepté) : on y met aussi le nom de la console ouverte, pour ne pas s'en couper
        var liste = new List<string>(allowedHosts);
        if (liste.Count == 0 && !string.IsNullOrEmpty(allowedHostsCurrent) && !IsLocalHost(allowedHostsCurrent)) liste.Add(allowedHostsCurrent);
        liste.Add(nom);
        if (await EnregistrerNomsAcceptes(liste)) nouveauNomAccepte = "";
    }

    private async Task RetirerNomAccepte(string nom)
    {
        var ok = await DialogService.Confirm(
            $"Retirer « {nom} » ? Les postes clients et les navigateurs qui utilisent encore ce nom ne pourront plus joindre le serveur.",
            "Noms acceptés par le serveur", new ConfirmOptions { OkButtonText = "Retirer", CancelButtonText = "Annuler" });
        if (ok != true) return;
        await EnregistrerNomsAcceptes(allowedHosts.Where(h => !string.Equals(h, nom, StringComparison.OrdinalIgnoreCase)).ToList());
    }

    private async Task<bool> EnregistrerNomsAcceptes(List<string> liste)
    {
        allowedHostsBusy = true;
        try
        {
            var response = await Http.PutAsJsonAsync("api/Settings/allowed-hosts", new AllowedHostsDto { Hosts = liste });
            if (!response.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Noms acceptés", await response.Content.ReadAsStringAsync());
                return false;
            }
            var dto = await response.Content.ReadFromJsonAsync<AllowedHostsDto>();
            allowedHosts = dto?.Hosts ?? liste;
            NotificationService.Notify(NotificationSeverity.Success, "Noms acceptés", "Liste enregistrée.");
            return true;
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Noms acceptés", ex.Message); return false; }
        finally { allowedHostsBusy = false; }
    }

    private static bool IsLocalHost(string h) => h.Equals("localhost", StringComparison.OrdinalIgnoreCase) || h == "127.0.0.1" || h == "::1" || h == "[::1]";

    private async Task CopyAgentKey()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<AgentKeyResponse>("api/Settings/agent-key");
            if (string.IsNullOrEmpty(response?.Key)) throw new InvalidOperationException("Clé introuvable.");
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", response.Key);
                NotificationService.Notify(NotificationSeverity.Success, "Copiée", "La clé d'API agent est dans le presse-papiers.");
            }
            catch (JSException)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Copie impossible", "Le navigateur a refusé l'accès au presse-papiers (la console doit être ouverte en HTTPS).");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", "Impossible de récupérer la clé : " + ex.Message);
        }
    }

    private class AgentKeyResponse { public string Key { get; set; } = ""; }
    private string testEmailTo = "";
    private string testAdQuery = "";
    private string builderGroupName = "";
