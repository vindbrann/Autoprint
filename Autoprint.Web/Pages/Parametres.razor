    // Aperçu et liste des changements recalculés 300 ms après la dernière frappe
    private async Task OnPatternChanged()
    {
        namingCts?.Cancel();
        var cts = namingCts = new CancellationTokenSource();
        try { await Task.Delay(300, cts.Token); } catch (TaskCanceledException) { return; }
        await RecalculerNommage(cts.Token);
    }

    private async Task RecalculerNommage(CancellationToken ct)
    {
        var template = model.NamingTemplate ?? "";
        var sample = namingSamples.FirstOrDefault(i => i.Id == namingSampleId);
        var dto = new
        {
            Template = template,
            Ip = sample?.AdresseIp ?? "10.12.4.30",
            LieuNom = sample?.Emplacement?.Nom ?? "Siège",
            LieuCode = sample?.Emplacement?.Code ?? "SIEGE",
            ImpCode = sample?.Code ?? "P0042",
            ModeleNom = sample?.Modele?.Nom ?? "IM C3000",
            MarqueNom = sample?.Modele?.Marque?.Nom ?? "Ricoh"
        };
        try
        {
            var r = await Http.PostAsJsonAsync("api/Naming/Preview", dto, ct);
            if (r.IsSuccessStatusCode)
            {
                var json = await r.Content.ReadFromJsonAsync<JsonElement>(cancellationToken: ct);
                namingPreview = json.TryGetProperty("generatedName", out var p) ? p.GetString() ?? "" : "";
            }
        }
        catch (OperationCanceledException) { return; }
        catch { namingPreview = ""; }

        var unknown = System.Text.RegularExpressions.Regex.Matches(template, @"\{[^}]*\}").Select(m => m.Value)
            .Where(v => !NamingTokens.Any(k => string.Equals("{" + k.Key + "}", v, StringComparison.OrdinalIgnoreCase))).Distinct().ToList();
        if (string.IsNullOrWhiteSpace(template)) { namingCheckOk = false; namingCheck = "Saisissez une règle"; }
        else if (unknown.Any()) { namingCheckOk = false; namingCheck = $"Variable inconnue : {string.Join(", ", unknown)}"; }
        else if (string.IsNullOrEmpty(namingPreview)) { namingCheckOk = false; namingCheck = "La règle donne un nom vide"; }
        else if (namingPreview.IndexOfAny(new[] { '\\', '/', ':', '*', '?', '"', '<', '>', '|', ',' }) >= 0) { namingCheckOk = false; namingCheck = "Caractère interdit dans un nom Windows (\\ / : * ? \" < > | ,)"; }
        else if (model.NamingSameShare && namingPreview.Length > 80) { namingCheckOk = false; namingCheck = $"{namingPreview.Length} caractères : 80 au maximum pour un nom de partage"; }
        else { namingCheckOk = true; namingCheck = $"{namingPreview.Length} caractères, valide pour une file et un partage Windows"; }

        if (model.NamingEnabled && namingCheckOk)
        {
            try
            {
                var r = await Http.PostAsJsonAsync("api/Naming/PreviewChanges", new { Template = template, SameShare = model.NamingSameShare }, ct);
                namingChanges = r.IsSuccessStatusCode ? await r.Content.ReadFromJsonAsync<List<NamingChangeView>>(cancellationToken: ct) ?? new() : new();
            }
            catch (OperationCanceledException) { return; }
            catch { namingChanges = new(); }
        }
        else namingChanges = new();
        if (namingChanges.Count == 0) showNamingDiff = false;
        StateHasChanged();
    }

    private async Task AppliquerNommageAuParc()
    {
