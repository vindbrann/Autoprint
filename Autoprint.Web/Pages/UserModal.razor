@using Autoprint.Shared.DTOs
@using Autoprint.Web.Services
@using Radzen
@using Radzen.Blazor
@inject IUserService UserService
@inject IRoleService RoleService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject CustomAuthStateProvider AuthProvider

@if (isLoading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
        @* Maquette « modales » (retour de recette du 11/11) : sections sans cadre, options en lignes de réglage, action principale nommée *@
    <RadzenTemplateForm Data="@formData" Submit="@OnSubmit" TItem="object">
        <div class="ap-dlg">
            @if (isAdUser)
            {
                <div class="ap-name-note" style="margin-bottom: var(--ap-s2);"><RadzenIcon Icon="info" />Compte Active Directory : nom, e-mail et mot de passe sont gérés dans l'annuaire</div>
            }

            <div class="ap-dlg-group" style="padding-top: 0;">
                <h3>Compte</h3>
                <div class="ap-dlg-grid">
                    <div class="ap-field">
                        <RadzenLabel Text="Identifiant" Component="Username" />
                        <RadzenTextBox Name="Username" @bind-Value="@formData.Username" Style="width: 100%;" Class="ap-mono" Disabled="@editMode" Placeholder="jdupont" />
                        @if (!editMode)
                        {
                            <RadzenRequiredValidator Component="Username" Text="Saisissez un identifiant" Popup="false" />
                        }
                        else
                        {
                            <span class="ap-help">L'identifiant ne peut pas être modifié</span>
                        }
                    </div>
                    <div class="ap-field">
                        <RadzenLabel Text="Rôle" Component="Role" />
                        <RadzenDropDown Name="Role" @bind-Value="@formData.RoleId" Data="@availableRoles" TextProperty="Name" ValueProperty="Id" Style="width: 100%;" Placeholder="Choisir un rôle" />
                        <RadzenRequiredValidator Component="Role" Text="Choisissez un rôle" Popup="false" DefaultValue="0" />
                    </div>
                </div>
            </div>

            <div class="ap-dlg-group">
                <h3>Identité</h3>
                <div class="ap-dlg-grid">
                    <div class="ap-field">
                        <RadzenLabel Text="Nom affiché" Component="DisplayName" />
                        <RadzenTextBox Name="DisplayName" @bind-Value="@formData.DisplayName" Style="width: 100%;" Disabled="@isAdUser" Placeholder="Jean Dupont" />
                        @if (!isAdUser)
                        {
                            <RadzenRequiredValidator Component="DisplayName" Text="Saisissez le nom affiché" Popup="false" />
                        }
                    </div>
                    <div class="ap-field">
                        <RadzenLabel Component="Email"><ChildContent>E-mail <span class="ap-opt">(facultatif)</span></ChildContent></RadzenLabel>
                        <RadzenTextBox Name="Email" @bind-Value="@formData.Email" Style="width: 100%;" Disabled="@isAdUser" Placeholder="jean.dupont@mondomaine.fr" />
                        @if (!isAdUser)
                        {
                            @* Facultatif : le compte admin d'origine n'en a pas et devait pouvoir être modifié (B58) ; sans e-mail, pas de « Mot de passe oublié » *@
                            @if (!string.IsNullOrWhiteSpace(formData.Email))
                            {
                                <RadzenEmailValidator Component="Email" Text="Adresse e-mail invalide" Popup="false" />
                            }
                            <span class="ap-help">Sans e-mail, « Mot de passe oublié » n'est pas disponible</span>
                        }
                    </div>
                </div>
            </div>

            @if (!isAdUser)
            {
                <div class="ap-dlg-group">
                    <h3>Mot de passe</h3>
                    <div class="ap-field">
                        <RadzenLabel Text="@(editMode ? "Nouveau mot de passe" : "Mot de passe")" Component="Password" />
                        <RadzenPassword Name="Password" @bind-Value="@formData.Password" Style="width: 100%;" AutoComplete="false" Placeholder="@(editMode ? "Inchangé si vide" : "")" />
                        @if (!editMode)
                        {
                            <RadzenRequiredValidator Component="Password" Text="Saisissez un mot de passe" Popup="false" />
                            <RadzenLengthValidator Component="Password" Min="@PasswordPolicy.MinLength" Text="@PasswordPolicy.MinLengthMessage" Popup="false" />
                        }
                        @if (!string.IsNullOrEmpty(passwordError))
                        {
                            <span class="ap-help is-bad">@passwordError</span>
                        }
                        else
                        {
                            <span class="ap-help">@PasswordPolicy.MinLength caractères au minimum</span>
                        }
                    </div>
                    <div class="ap-opt-row" style="padding-bottom: 0;">
                        <div class="txt">
                            <div class="t">Changement obligatoire à la prochaine connexion</div>
                            <div class="d">L'utilisateur choisit son propre mot de passe avant d'accéder à la console</div>
                        </div>
                        <RadzenSwitch @bind-Value="@formData.ForceChangePassword" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Changement obligatoire à la prochaine connexion" } })" />
                    </div>
                </div>
            }

            @if (editMode)
            {
                <div class="ap-dlg-group" style="gap: 0;">
                    <div class="ap-opt-row" style="padding-top: 0;">
                        <div class="txt">
                            <div class="t">Compte actif</div>
                            <div class="d">Un compte désactivé ne peut plus se connecter ; ses sessions ouvertes sont fermées</div>
                        </div>
                        <RadzenSwitch @bind-Value="@formData.IsActive" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Compte actif" } })" />
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(apiError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="true" Close="@(() => apiError = null)">
                    <div style="white-space: pre-line;">@apiError</div>
                </RadzenAlert>
            }

            <div class="ap-dlg-footer">
                <span class="ap-grow"></span>
                <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => DialogService.Close(false))" />
                <RadzenButton ButtonType="ButtonType.Submit" Text="@(editMode ? "Enregistrer les modifications" : "Créer le compte")" ButtonStyle="ButtonStyle.Primary" />
            </div>
        </div>
    </RadzenTemplateForm>
}

@code {
    [Parameter] public UserViewDto? UserToEdit { get; set; }

    private class UserFormData
    {
        public string Username { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public int RoleId { get; set; }
        public bool IsActive { get; set; } = true;
        public bool ForceChangePassword { get; set; } = true;
    }

    private UserFormData formData = new();
    private List<RoleViewDto> availableRoles = new();
    private bool isLoading = true;
    private bool editMode => UserToEdit != null;
    private bool isAdUser => UserToEdit?.IsAdUser ?? false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            availableRoles = await RoleService.GetRoles();

            // Seuls les rôles que l'utilisateur connecté peut attribuer sont proposés (même règle que le serveur : PermissionRules)
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var myPermissions = authState.User.Claims.Where(c => c.Type == "Permission").Select(c => c.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var currentRoleNames = UserToEdit?.Roles ?? new List<string>();
            availableRoles = availableRoles
                .Where(r => r.PermissionCodes.All(c => Autoprint.Shared.PermissionRules.CanGrant(myPermissions, c)) || currentRoleNames.Contains(r.Name))
                .ToList();

            if (editMode)
            {
                formData = new UserFormData
                {
                    Username = UserToEdit!.Username,
                    DisplayName = UserToEdit.DisplayName,
                    Email = UserToEdit.Email,
                    IsActive = UserToEdit.IsActive,
                    // Valeur réelle du compte (avant : toujours décochée, donc effacée à chaque enregistrement)
                    ForceChangePassword = UserToEdit.ForceChangePassword,
                    RoleId = GetRoleIdFromNames(UserToEdit.Roles)
                };
            }
            else
            {
                formData.RoleId = availableRoles.FirstOrDefault()?.Id ?? 0;
            }
        }
        catch (Exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", "Impossible de charger les rôles.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private int GetRoleIdFromNames(List<string> roleNames)
    {
        if (roleNames == null || !roleNames.Any()) return availableRoles.FirstOrDefault()?.Id ?? 0;
        var roleName = roleNames.First();
        return availableRoles.FirstOrDefault(r => r.Name == roleName)?.Id ?? 0;
    }

    private string? passwordError = null;
    private string? apiError = null;

    private async Task OnSubmit()
    {
        passwordError = null;
        apiError = null;

        if (!isAdUser)
        {
            if (editMode)
            {
                if (!string.IsNullOrEmpty(formData.Password) && formData.Password.Length < PasswordPolicy.MinLength)
                {
                    passwordError = PasswordPolicy.MinLengthMessage;
                    return;
                }
            }
            else
            {
                if (string.IsNullOrEmpty(formData.Password))
                {
                    return;
                }
                if (formData.Password.Length < PasswordPolicy.MinLength)
                {
                    passwordError = PasswordPolicy.MinLengthMessage;
                    return;
                }
            }
        }

        try
        {
            if (editMode)
            {
                var updateDto = new UpdateUserDto
                {
                    DisplayName = formData.DisplayName,
                    Email = string.IsNullOrWhiteSpace(formData.Email) ? null : formData.Email.Trim(),
                    IsActive = formData.IsActive,
                    RoleId = formData.RoleId,
                    ForceChangePassword = formData.ForceChangePassword,
                    NewPassword = string.IsNullOrWhiteSpace(formData.Password) ? null : formData.Password
                };
                await UserService.UpdateUser(UserToEdit!.Id, updateDto);
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Utilisateur modifié.");
            }
            else
            {
                var createDto = new CreateUserDto
                {
                    Username = formData.Username,
                    DisplayName = formData.DisplayName,
                    Email = string.IsNullOrWhiteSpace(formData.Email) ? null : formData.Email.Trim(),
                    Password = formData.Password,
                    RoleId = formData.RoleId,
                    ForceChangePassword = formData.ForceChangePassword
                };
                await UserService.CreateUser(createDto);
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Utilisateur créé.");
            }
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            var msg = ex.Message;
            string jsonPart = msg;
            if (msg.StartsWith("Erreur Création : ")) jsonPart = msg.Substring("Erreur Création : ".Length);
            else if (msg.StartsWith("Erreur Modification : ")) jsonPart = msg.Substring("Erreur Modification : ".Length);

            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(jsonPart);
                var root = doc.RootElement;
                if (root.TryGetProperty("errors", out var errorsProp) && errorsProp.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    var sb = new System.Text.StringBuilder();
                    sb.AppendLine("Certains champs sont incorrects :");
                    foreach (var prop in errorsProp.EnumerateObject())
                    {
                        foreach (var err in prop.Value.EnumerateArray())
                        {
                            sb.AppendLine($"- {err.GetString()}");
                        }
                    }
                    apiError = sb.ToString();
                }
                else if (root.TryGetProperty("message", out var msgProp))
                {
                    apiError = msgProp.GetString();
                }
                else if (root.TryGetProperty("title", out var titleProp))
                {
                    apiError = titleProp.GetString();
                }
                else
                {
                    apiError = msg;
                }
            }
            catch
            {
                apiError = msg;
            }
        }
    }
}