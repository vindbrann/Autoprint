@using Autoprint.Shared.DTOs
@using Autoprint.Web.Services
@using Radzen
@using Radzen.Blazor
@inject IUserService UserService
@inject IRoleService RoleService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject CustomAuthStateProvider AuthProvider

@if (isLoading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenTemplateForm Data="@formData" Submit="@OnSubmit" TItem="object">
        <RadzenStack Gap="1rem">

            <RadzenRow RowGap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Identifiant (Login)" Component="Username" />
                    <RadzenTextBox Name="Username" @bind-Value="@formData.Username" Style="width: 100%;"
                                   Disabled="@editMode" Placeholder="ex: jdupont" />
                    @if (!editMode)
                    {
                        <RadzenRequiredValidator Component="Username" Text="L'identifiant est requis" Popup="false" Style="display: block; margin-top: 5px;" />
                    }
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Rôle / Groupe" Component="Role" />
                    <RadzenDropDown Name="Role" @bind-Value="@formData.RoleId"
                                    Data="@availableRoles" TextProperty="Name" ValueProperty="Id"
                                    Style="width: 100%;" Placeholder="Sélectionner un rôle..." />

                    <RadzenRequiredValidator Component="Role" Text="Le rôle est requis" Popup="false" DefaultValue="0" Style="display: block; margin-top: 5px;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow RowGap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Nom Affiché" Component="DisplayName" />
                    <RadzenTextBox Name="DisplayName" @bind-Value="@formData.DisplayName" Style="width: 100%;"
                                   Disabled="@isAdUser" />
                    @if (isAdUser)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-info);">
                            <RadzenIcon Icon="info" Style="font-size: 0.8rem" /> Géré par Active Directory
                        </RadzenText>
                    }
                    else
                    {
                        <RadzenRequiredValidator Component="DisplayName" Text="Le nom est requis" Popup="false" Style="display: block; margin-top: 5px;" />
                    }
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Email (facultatif)" Component="Email" />
                    <RadzenTextBox Name="Email" @bind-Value="@formData.Email" Style="width: 100%;"
                                   Disabled="@isAdUser" Placeholder="jean.dupont@entreprise.com" />
                    @if (!isAdUser)
                    {
                        @* Facultatif : le compte admin d'origine n'en a pas et devait pouvoir être modifié (B58) ; sans e-mail, pas de « Mot de passe oublié » *@
                        @if (!string.IsNullOrWhiteSpace(formData.Email))
                        {
                            <RadzenEmailValidator Component="Email" Text="Format email invalide" Popup="false" Style="display: block; margin-top: 5px;" />
                        }
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-tertiary-color);">Sans e-mail, « Mot de passe oublié » n'est pas disponible pour ce compte.</RadzenText>
                    }
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="rz-my-2">
                <RadzenIcon Icon="lock" />
                <RadzenText TextStyle="TextStyle.Subtitle2" Class="rz-m-0">Sécurité</RadzenText>
                <div style="flex: 1; height: 1px; background-color: var(--rz-border-color);"></div>
            </RadzenStack>

            <RadzenRow RowGap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Mot de passe" Component="Password" />
                    <RadzenPassword Name="Password" @bind-Value="@formData.Password" Style="width: 100%;"
                                    Disabled="@isAdUser"
                                    Placeholder="@(isAdUser ? "Géré par Windows" : (editMode ? "Laisser vide pour ne pas changer" : ""))" />

                    @if (!editMode && !isAdUser)
                    {
                        <RadzenRequiredValidator Component="Password" Text="Mot de passe requis" Popup="false" Style="display: block; margin-top: 5px;" />
                        <RadzenLengthValidator Component="Password" Min="@PasswordPolicy.MinLength" Text="@PasswordPolicy.MinLengthMessage" Popup="false" Style="display: block; margin-top: 5px;" />
                    }
                    @if (!string.IsNullOrEmpty(passwordError))
                    {
                        <div style="color: var(--rz-danger); font-size: 0.8rem; margin-top: 5px; display: block;">@passwordError</div>
                    }
                </RadzenColumn>

                @if (!editMode)
                {
                    <RadzenColumn Size="12">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenCheckBox @bind-Value="@formData.ForceChangePassword" Name="ForceChangeNew" />
                            <RadzenLabel Text="Changement du mot de passe obligatoire à la première connexion" Component="ForceChangeNew" />
                        </RadzenStack>
                    </RadzenColumn>
                }

                @if (editMode)
                {
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenCard Variant="Variant.Outlined" Class="rz-p-2">
                            <RadzenStack Gap="0.5rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenSwitch @bind-Value="@formData.IsActive" />
                                    <RadzenLabel Text="Compte Actif" />
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenCheckBox @bind-Value="@formData.ForceChangePassword" Disabled="@isAdUser" Name="ForceChange" />
                                    <RadzenLabel Text="Forcer changement MDP" Component="ForceChange" Style="@(isAdUser ? "color: var(--rz-text-disabled-color);" : "color: var(--rz-danger); font-weight: bold;")" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>

            @if (!string.IsNullOrEmpty(apiError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="true" Close="@(() => apiError = null)" Class="rz-mt-4">
                    <div style="white-space: pre-line;">@apiError</div>
                </RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem" Class="rz-mt-4">
                <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
                <RadzenButton ButtonType="ButtonType.Submit" Text="@(editMode ? "Enregistrer" : "Créer")" Icon="save" ButtonStyle="ButtonStyle.Success" />
            </RadzenStack>

        </RadzenStack>
    </RadzenTemplateForm>
}

@code {
    [Parameter] public UserViewDto? UserToEdit { get; set; }

    private class UserFormData
    {
        public string Username { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public int RoleId { get; set; }
        public bool IsActive { get; set; } = true;
        public bool ForceChangePassword { get; set; } = true;
    }

    private UserFormData formData = new();
    private List<RoleViewDto> availableRoles = new();
    private bool isLoading = true;
    private bool editMode => UserToEdit != null;
    private bool isAdUser => UserToEdit?.IsAdUser ?? false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            availableRoles = await RoleService.GetRoles();

            // Seuls les rôles que l'utilisateur connecté peut attribuer sont proposés (même règle que le serveur : PermissionRules)
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var myPermissions = authState.User.Claims.Where(c => c.Type == "Permission").Select(c => c.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var currentRoleNames = UserToEdit?.Roles ?? new List<string>();
            availableRoles = availableRoles
                .Where(r => r.PermissionCodes.All(c => Autoprint.Shared.PermissionRules.CanGrant(myPermissions, c)) || currentRoleNames.Contains(r.Name))
                .ToList();

            if (editMode)
            {
                formData = new UserFormData
                {
                    Username = UserToEdit!.Username,
                    DisplayName = UserToEdit.DisplayName,
                    Email = UserToEdit.Email,
                    IsActive = UserToEdit.IsActive,
                    // Valeur réelle du compte (avant : toujours décochée, donc effacée à chaque enregistrement)
                    ForceChangePassword = UserToEdit.ForceChangePassword,
                    RoleId = GetRoleIdFromNames(UserToEdit.Roles)
                };
            }
            else
            {
                formData.RoleId = availableRoles.FirstOrDefault()?.Id ?? 0;
            }
        }
        catch (Exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", "Impossible de charger les rôles.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private int GetRoleIdFromNames(List<string> roleNames)
    {
        if (roleNames == null || !roleNames.Any()) return availableRoles.FirstOrDefault()?.Id ?? 0;
        var roleName = roleNames.First();
        return availableRoles.FirstOrDefault(r => r.Name == roleName)?.Id ?? 0;
    }

    private string? passwordError = null;
    private string? apiError = null;

    private async Task OnSubmit()
    {
        passwordError = null;
        apiError = null;

        if (!isAdUser)
        {
            if (editMode)
            {
                if (!string.IsNullOrEmpty(formData.Password) && formData.Password.Length < PasswordPolicy.MinLength)
                {
                    passwordError = PasswordPolicy.MinLengthMessage;
                    return;
                }
            }
            else
            {
                if (string.IsNullOrEmpty(formData.Password))
                {
                    return;
                }
                if (formData.Password.Length < PasswordPolicy.MinLength)
                {
                    passwordError = PasswordPolicy.MinLengthMessage;
                    return;
                }
            }
        }

        try
        {
            if (editMode)
            {
                var updateDto = new UpdateUserDto
                {
                    DisplayName = formData.DisplayName,
                    Email = string.IsNullOrWhiteSpace(formData.Email) ? null : formData.Email.Trim(),
                    IsActive = formData.IsActive,
                    RoleId = formData.RoleId,
                    ForceChangePassword = formData.ForceChangePassword,
                    NewPassword = string.IsNullOrWhiteSpace(formData.Password) ? null : formData.Password
                };
                await UserService.UpdateUser(UserToEdit!.Id, updateDto);
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Utilisateur modifié.");
            }
            else
            {
                var createDto = new CreateUserDto
                {
                    Username = formData.Username,
                    DisplayName = formData.DisplayName,
                    Email = string.IsNullOrWhiteSpace(formData.Email) ? null : formData.Email.Trim(),
                    Password = formData.Password,
                    RoleId = formData.RoleId,
                    ForceChangePassword = formData.ForceChangePassword
                };
                await UserService.CreateUser(createDto);
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Utilisateur créé.");
            }
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            var msg = ex.Message;
            string jsonPart = msg;
            if (msg.StartsWith("Erreur Création : ")) jsonPart = msg.Substring("Erreur Création : ".Length);
            else if (msg.StartsWith("Erreur Modification : ")) jsonPart = msg.Substring("Erreur Modification : ".Length);

            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(jsonPart);
                var root = doc.RootElement;
                if (root.TryGetProperty("errors", out var errorsProp) && errorsProp.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    var sb = new System.Text.StringBuilder();
                    sb.AppendLine("Certains champs sont incorrects :");
                    foreach (var prop in errorsProp.EnumerateObject())
                    {
                        foreach (var err in prop.Value.EnumerateArray())
                        {
                            sb.AppendLine($"- {err.GetString()}");
                        }
                    }
                    apiError = sb.ToString();
                }
                else if (root.TryGetProperty("message", out var msgProp))
                {
                    apiError = msgProp.GetString();
                }
                else if (root.TryGetProperty("title", out var titleProp))
                {
                    apiError = titleProp.GetString();
                }
                else
                {
                    apiError = msg;
                }
            }
            catch
            {
                apiError = msg;
            }
        }
    }
}