@using Autoprint.Shared
@using Autoprint.Web.Services
@using System.Text.Json
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject CustomAuthStateProvider AuthProvider
@using Autoprint.Shared.Enums

@* Maquette « modales et nommage » (retour de recette du 11/11) : aperçu du nom en haut, sections sans cadre,
   options en lignes de réglage, réglages SNMP avancés repliés, barre d'actions toujours visible *@
<RadzenTemplateForm TItem="Imprimante" Data="@imprimanteEdit" Submit="@OnSubmit">
    <div class="ap-dlg">

        <p class="ap-dlg-lead">@(imprimanteEdit.Id == 0 ? "Elle sera créée sur le serveur à la prochaine synchronisation." : "Les changements s'appliquent sur le serveur à la prochaine synchronisation.")</p>

        <div class="ap-dlg-strip" aria-live="polite">
            <span><span class="k">Nom</span><span class="ap-label-tag">@(string.IsNullOrWhiteSpace(imprimanteEdit.NomAffiche) ? "à définir" : imprimanteEdit.NomAffiche)</span></span>
            <span><span class="k">Partage Windows</span><span class="ap-label-tag">@(imprimanteEdit.EstPartagee ? $@"\\serveur\{(string.IsNullOrWhiteSpace(imprimanteEdit.NomPartage) ? imprimanteEdit.NomAffiche : imprimanteEdit.NomPartage)}" : "non partagée")</span></span>
        </div>

        <div class="ap-dlg-group">
            <h3>Emplacement</h3>
            <div class="ap-dlg-grid">
                <div class="ap-field">
                    <RadzenLabel Text="Lieu" Component="Emplacement" />
                    @if (CanReadEmplacements)
                    {
                        <RadzenDropDown Name="Emplacement" @bind-Value="@imprimanteEdit.EmplacementId"
                                        Data="@listeEmplacements" TextProperty="Nom" ValueProperty="Id"
                                        Change="@(async args => await OnLieuChanged((int)args))"
                                        Style="width: 100%;" Placeholder="Choisir un lieu"
                                        AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                            <Template Context="l">
                                @{ var lieu = (Emplacement)l; }
                                @lieu.Nom
                                @if (lieu.Networks != null && lieu.Networks.Any())
                                {
                                    <span class="ap-caption ap-mono" style="margin-left: 6px;">@lieu.Networks.First().CidrIpv4@(lieu.Networks.Count > 1 ? $" +{lieu.Networks.Count - 1}" : "")</span>
                                }
                            </Template>
                        </RadzenDropDown>
                        <RadzenRequiredValidator Component="Emplacement" Text="Choisissez un lieu" Popup="true" DefaultValue="0" />
                    }
                    else
                    {
                        <span class="ap-help is-warn">Vous n'avez pas accès aux lieux</span>
                    }
                </div>
                <div class="ap-field">
                    <RadzenLabel Component="Loc"><ChildContent>Détail <span class="ap-opt">(facultatif)</span></ChildContent></RadzenLabel>
                    <RadzenTextBox Name="Loc" @bind-Value="@imprimanteEdit.Localisation" Style="width: 100%;" Placeholder="Bureau 204" />
                </div>
            </div>
            <div class="ap-field">
                <RadzenLabel Text="Adresse IP" Component="Ip" />
                @if (!string.IsNullOrEmpty(prefixeReseau))
                {
                    <div class="ap-ip-group">
                        <span class="ap-ip-prefix">@prefixeReseau</span>
                        <input id="Ip" class="ap-ip-input" value="@ipSuffix" @onchange="OnSuffixChanged" inputmode="decimal" placeholder="50" aria-label="Fin de l'adresse IP" />
                    </div>
                    <span class="ap-help">Début imposé par le réseau principal du lieu</span>
                }
                else
                {
                    <RadzenTextBox Name="Ip" @bind-Value="@imprimanteEdit.AdresseIp" Change="@(async _ => await GenerateNameIfEnabled())" Style="width: 100%;" Class="ap-mono" Placeholder="10.0.0.50" />
                }
            </div>
        </div>

        <div class="ap-dlg-group">
            <h3>Matériel</h3>
            <div class="ap-dlg-grid">
                <div class="ap-field">
                    <RadzenLabel Text="Marque" Component="Marque" />
                    <RadzenDropDown Name="Marque" @bind-Value="@selectedMarqueId"
                                    Data="@listeMarques" TextProperty="Nom" ValueProperty="Id"
                                    Change="@OnMarqueChange" Disabled="@(!CanReadMarques)"
                                    Style="width: 100%;" Placeholder="Choisir une marque" AllowFiltering="true" />
                </div>
                <div class="ap-field">
                    <RadzenLabel Text="Modèle" Component="Modele" />
                    <RadzenDropDown Name="Modele" @bind-Value="@imprimanteEdit.ModeleId"
                                    Data="@listeModelesFiltres" TextProperty="Nom" ValueProperty="Id"
                                    Disabled="@(selectedMarqueId == 0 || !CanReadModeles)"
                                    Change="@(args => GenerateNameIfEnabled())"
                                    Style="width: 100%;" Placeholder="Choisir un modèle" AllowFiltering="true" />
                    @if (selectedMarqueId == 0)
                    {
                        <span class="ap-help">Choisissez d'abord la marque</span>
                    }
                    <RadzenRequiredValidator Component="Modele" Text="Choisissez un modèle" Popup="true" DefaultValue="0" />
                </div>
            </div>
        </div>

        <div class="ap-dlg-group">
            <h3>Identification</h3>
            @if (namingEnabled)
            {
                <div class="ap-opt-row" style="padding-top: 0;">
                    <div class="txt">
                        <div class="t">Nom automatique</div>
                        <div class="d">Construit avec la règle de Paramètres, Nommage</div>
                    </div>
                    <RadzenButton Icon="autorenew" Text="Recalculer" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@ForcerRefreshNom" />
                </div>
            }
            <div class="ap-dlg-grid">
                <div class="ap-field">
                    <RadzenLabel Text="Nom affiché" Component="NomAffiche" />
                    <RadzenTextBox Name="NomAffiche" @bind-Value="@imprimanteEdit.NomAffiche" Style="width: 100%;" Class="ap-mono"
                                   Disabled="@namingEnabled" Placeholder="IMP_ACCUEIL" />
                </div>
                <div class="ap-field">
                    <RadzenLabel Component="Code"><ChildContent>Code inventaire <span class="ap-opt">(facultatif)</span></ChildContent></RadzenLabel>
                    <RadzenTextBox Name="Code" @bind-Value="@imprimanteEdit.Code" Style="width: 100%;" Class="ap-mono"
                                   @onblur="GenerateNameIfEnabled" Placeholder="P001" />
                </div>
            </div>
        </div>

        <div class="ap-dlg-group" style="gap: 0;">
            <h3 style="margin-bottom: var(--ap-s1);">Options</h3>
            <div class="ap-opt-row">
                <div class="txt">
                    <div class="t">
                        Impression directe
                        <span class="ap-info" tabindex="0" role="img" aria-label="Le spouleur du serveur transmet les travaux tels quels à l'adresse IP de l'imprimante (bits QUEUED à 0 et DIRECT à 1). Utile pour les sites distants ou pour soulager le serveur."
                              title="Le spouleur du serveur transmet les travaux tels quels à l'adresse IP de l'imprimante (bits QUEUED à 0 et DIRECT à 1). Utile pour les sites distants ou pour soulager le serveur."><RadzenIcon Icon="info" /></span>
                    </div>
                    <div class="d">Les travaux vont directement à l'imprimante, sans file d'attente sur le serveur</div>
                </div>
                <RadzenSwitch @bind-Value="@imprimanteEdit.IsDirectPrintingEnabled" Name="ModeDirect" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Impression directe" } })" />
            </div>
            <div class="ap-opt-row">
                <div class="txt">
                    <div class="t">Partager sur le réseau Windows</div>
                    <div class="d">Les postes pourront s'y connecter par \\serveur\nom du partage</div>
                </div>
                <RadzenSwitch @bind-Value="@imprimanteEdit.EstPartagee" Name="Partage" InputAttributes="@(new Dictionary<string, object> { { "aria-label", "Partager sur le réseau Windows" } })" />
            </div>
            @if (imprimanteEdit.EstPartagee)
            {
                <div class="ap-field" style="padding-bottom: var(--ap-s2);">
                    <RadzenLabel Text="Nom du partage" Component="NomPartage" />
                    <RadzenTextBox Name="NomPartage" @bind-Value="@imprimanteEdit.NomPartage" Style="width: 100%;" Class="ap-mono"
                                   Disabled="@(namingEnabled && namingSameShare)" />
                    @if (namingEnabled && namingSameShare)
                    {
                        <span class="ap-help">Identique au nom de l'imprimante (Paramètres, Nommage)</span>
                    }
                </div>
            }
        </div>

        <div class="ap-dlg-group">
            <h3>Supervision SNMP</h3>
            <div class="ap-field">
                <RadzenLabel Text="Identifiants" Component="SnmpCredential" />
                <RadzenDropDown Name="SnmpCredential" @bind-Value="@imprimanteEdit.SnmpCredentialId"
                                Data="@listeCredentials" TextProperty="Name" ValueProperty="Id"
                                AllowClear="true" Placeholder="@CredentialPlaceholder" Style="width: 100%;" />
                <span class="ap-help">Laissez vide pour utiliser ceux du modèle ; choisissez un profil seulement pour une imprimante particulière</span>
            </div>
            <details class="ap-adv" open="@(imprimanteEdit.SnmpPort != 161 || UsesLegacyFields && imprimanteEdit.Id != 0 && imprimanteEdit.SnmpVersion != 2)">
                <summary><RadzenIcon Icon="chevron_right" />Réglages SNMP avancés</summary>
                <div class="ap-dlg-grid cols-3">
                    <div class="ap-field">
                        <RadzenLabel Text="Port" Component="SnmpPort" />
                        <RadzenNumeric Name="SnmpPort" TValue="int" @bind-Value="@imprimanteEdit.SnmpPort" Style="width: 100%;" Min="1" Max="65535" />
                    </div>
                    @if (UsesLegacyFields)
                    {
                        <div class="ap-field">
                            <RadzenLabel Text="Communauté" Component="SnmpCommunity" />
                            @* Chiffrée en base et jamais réaffichée (B32) : vide = communauté actuelle conservée *@
                            <RadzenPassword Name="SnmpCommunity" @bind-Value="@imprimanteEdit.SnmpCommunity" Style="width: 100%;" AutoComplete="false"
                                            Placeholder="@(imprimanteEdit.Id != 0 ? "Inchangée si vide" : "public")" />
                        </div>
                        <div class="ap-field">
                            <RadzenLabel Text="Version" Component="SnmpVersion" />
                            <RadzenDropDown Name="SnmpVersion" TValue="int" @bind-Value="@imprimanteEdit.SnmpVersion" Style="width: 100%;"
                                            Data="@(new[] { new { Text = "v1", Value = 1 }, new { Text = "v2c", Value = 2 } })"
                                            TextProperty="Text" ValueProperty="Value" />
                        </div>
                    }
                </div>
                @if (!UsesLegacyFields)
                {
                    <span class="ap-help">La communauté et la version viennent du profil d'identifiants</span>
                }
            </details>
        </div>

        <div class="ap-dlg-footer">
            @if (imprimanteEdit.Id != 0)
            {
                <AuthorizeView Policy="PRINTER_DELETE">
                    <Authorized Context="authContext">
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Text" Text="Supprimer" Click="@OnDelete" />
                    </Authorized>
                </AuthorizeView>
            }
            <span class="ap-help">@(IsComplete ? "" : "Choisissez le lieu, la marque et le modèle pour continuer")</span>
            <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => DialogService.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(IsStagingMode ? "Valider" : imprimanteEdit.Id == 0 ? "Créer l'imprimante" : "Enregistrer les modifications")" ButtonStyle="ButtonStyle.Primary" Disabled="@(!IsComplete)" />
        </div>

    </div>
</RadzenTemplateForm>

@code {
    [Parameter] public Imprimante ImprimanteToEdit { get; set; } = new();
    [Parameter] public bool IsStagingMode { get; set; } = false;

    private Imprimante imprimanteEdit = new();
    private List<Emplacement>? listeEmplacements;
    private List<Marque>? listeMarques;
    private List<Modele>? listeTousModeles;
    private List<Modele>? listeModelesFiltres;
    private int selectedMarqueId = 0;
    private bool CanReadEmplacements { get; set; }
    private bool CanReadMarques { get; set; }
    private bool CanReadModeles { get; set; }
    private bool namingEnabled = false;
    private bool namingSameShare = false;
    private string namingTemplate = "";
    private string prefixeReseau = "";
    private string ipSuffix = "";

    private List<Autoprint.Shared.DTOs.SnmpCredentialViewDto> listeCredentials = new();

    // Profil du modèle sélectionné (valeur par défaut de l'imprimante)
    private Autoprint.Shared.DTOs.SnmpCredentialViewDto? ModelCredential
    {
        get
        {
            var modelCredentialId = listeTousModeles?.FirstOrDefault(m => m.Id == imprimanteEdit.ModeleId)?.SnmpCredentialId;
            return modelCredentialId == null ? null : listeCredentials.FirstOrDefault(c => c.Id == modelCredentialId);
        }
    }

    private string CredentialPlaceholder => ModelCredential != null
        ? $"Identifiants du modèle : {ModelCredential.Name}"
        : "Aucun profil (communauté / version ci-dessous)";

    // Les anciens champs communauté / version ne servent que sans profil (ni sur l'imprimante, ni sur le modèle)
    private bool UsesLegacyFields => imprimanteEdit.SnmpCredentialId == null && ModelCredential == null;

    private bool IsComplete => imprimanteEdit.EmplacementId != 0 && imprimanteEdit.ModeleId != 0;

    protected override async Task OnInitializedAsync()
    {
        imprimanteEdit = new Imprimante
        {
            Id = ImprimanteToEdit.Id,
            NomAffiche = ImprimanteToEdit.NomAffiche,
            Code = ImprimanteToEdit.Code,
            AdresseIp = ImprimanteToEdit.AdresseIp,
            Localisation = ImprimanteToEdit.Localisation,
            EstPartagee = ImprimanteToEdit.EstPartagee,
            NomPartage = ImprimanteToEdit.NomPartage,
            Commentaire = ImprimanteToEdit.Commentaire,
            IsDirectPrintingEnabled = ImprimanteToEdit.IsDirectPrintingEnabled,
            ModeleId = ImprimanteToEdit.ModeleId,
            EmplacementId = ImprimanteToEdit.EmplacementId,
            Status = ImprimanteToEdit.Status,
            SnmpPort = ImprimanteToEdit.SnmpPort,
            SnmpCommunity = ImprimanteToEdit.Id != 0 ? "" : (string.IsNullOrEmpty(ImprimanteToEdit.SnmpCommunity) ? "public" : ImprimanteToEdit.SnmpCommunity),
            SnmpVersion = ImprimanteToEdit.SnmpVersion == 0 ? 2 : ImprimanteToEdit.SnmpVersion,
            SnmpCredentialId = ImprimanteToEdit.SnmpCredentialId
        };

        CanReadEmplacements = await AuthProvider.HasPermission("Permission", "LOCATION_READ");
        CanReadMarques = await AuthProvider.HasPermission("Permission", "BRAND_READ");
        CanReadModeles = await AuthProvider.HasPermission("Permission", "MODEL_READ");

        try
        {
            var tasks = new List<Task>();
            if (CanReadEmplacements) tasks.Add(Task.Run(async () => listeEmplacements = await Http.GetFromJsonAsync<List<Emplacement>>("api/Emplacements")));
            if (CanReadMarques) tasks.Add(Task.Run(async () => listeMarques = await Http.GetFromJsonAsync<List<Marque>>("api/Marques")));
            if (CanReadModeles) tasks.Add(Task.Run(async () => listeTousModeles = await Http.GetFromJsonAsync<List<Modele>>("api/Modeles")));
            tasks.Add(Task.Run(async () =>
            {
                try { listeCredentials = await Http.GetFromJsonAsync<List<Autoprint.Shared.DTOs.SnmpCredentialViewDto>>("api/SnmpCredentials") ?? new(); }
                catch { /* pas de droit SNMP_PROFILE_READ : seuls les anciens champs restent disponibles */ }
            }));
            tasks.Add(LoadSettingsAsync());

            if (tasks.Any()) await Task.WhenAll(tasks);

            InitCascadeEtIp();
        }
        catch { }
    }

    private void InitCascadeEtIp()
    {
        if (listeTousModeles != null && imprimanteEdit.ModeleId != 0)
        {
            var currentModele = listeTousModeles.FirstOrDefault(m => m.Id == imprimanteEdit.ModeleId);
            if (currentModele != null)
            {
                selectedMarqueId = currentModele.MarqueId;
                FilterModeles();
            }
        }
        else
        {
            selectedMarqueId = 0;
            listeModelesFiltres = new List<Modele>();
        }

        CalculerPrefixe(imprimanteEdit.EmplacementId);
        if (!string.IsNullOrEmpty(prefixeReseau) && !string.IsNullOrEmpty(imprimanteEdit.AdresseIp) && imprimanteEdit.AdresseIp.StartsWith(prefixeReseau))
        {
            ipSuffix = imprimanteEdit.AdresseIp.Replace(prefixeReseau, "");
        }
        else
        {
            ipSuffix = imprimanteEdit.AdresseIp ?? "";
        }
    }

    private async Task OnMarqueChange(object value)
    {
        selectedMarqueId = (int)value;
        FilterModeles();
        imprimanteEdit.ModeleId = 0;
        await GenerateNameIfEnabled();
    }

    private void FilterModeles()
    {
        if (listeTousModeles != null)
            listeModelesFiltres = listeTousModeles.Where(m => m.MarqueId == selectedMarqueId).ToList();
    }

    private async Task OnLieuChanged(int id)
    {
        imprimanteEdit.EmplacementId = id;
        CalculerPrefixe(id);
        await GenerateNameIfEnabled();
    }

    private void CalculerPrefixe(int emplacementId)
    {
        prefixeReseau = "";
        var lieu = listeEmplacements?.FirstOrDefault(e => e.Id == emplacementId);

        var mainNetwork = lieu?.Networks?.FirstOrDefault();

        if (mainNetwork != null && !string.IsNullOrEmpty(mainNetwork.CidrIpv4) && mainNetwork.CidrIpv4.Contains("/"))
        {
            try
            {
                var parts = mainNetwork.CidrIpv4.Split('/');
                var ipParts = parts[0].Split('.');
                if (parts.Length > 1 && int.TryParse(parts[1], out int cidr))
                {
                    if (cidr >= 24) prefixeReseau = $"{ipParts[0]}.{ipParts[1]}.{ipParts[2]}.";
                    else if (cidr >= 16) prefixeReseau = $"{ipParts[0]}.{ipParts[1]}.";
                    else if (cidr >= 8) prefixeReseau = $"{ipParts[0]}.";
                }
            }
            catch { prefixeReseau = ""; }
        }
    }

    private async Task OnSuffixChanged(ChangeEventArgs e)
    {
        ipSuffix = e.Value?.ToString() ?? "";
        if (!string.IsNullOrEmpty(prefixeReseau))
        {
            if (ipSuffix.StartsWith(prefixeReseau)) ipSuffix = ipSuffix.Replace(prefixeReseau, "");
            imprimanteEdit.AdresseIp = prefixeReseau + ipSuffix;
        }
        else
        {
            imprimanteEdit.AdresseIp = ipSuffix;
        }
        await GenerateNameIfEnabled();
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<List<ServerSetting>>("api/Settings");
            if (settings != null)
            {
                namingEnabled = bool.Parse(GetVal(settings, "NamingEnabled", "false"));
                namingSameShare = bool.Parse(GetVal(settings, "NamingSameShare", "false"));
                namingTemplate = GetVal(settings, "NamingTemplate", "");
            }
        }
        catch { }
    }
    private string GetVal(List<ServerSetting> list, string key, string def) => list.FirstOrDefault(s => s.Key == key)?.Value ?? def;

    private async Task ForcerRefreshNom() => await GenerateNameIfEnabled();

    private async Task GenerateNameIfEnabled()
    {
        if (!namingEnabled) return;
        var lieu = listeEmplacements?.FirstOrDefault(e => e.Id == imprimanteEdit.EmplacementId);
        var modele = listeTousModeles?.FirstOrDefault(m => m.Id == imprimanteEdit.ModeleId);
        var marque = listeMarques?.FirstOrDefault(m => m.Id == selectedMarqueId);

        var dto = new
        {
            Template = namingTemplate,
            Ip = imprimanteEdit.AdresseIp ?? "",
            LieuNom = lieu?.Nom ?? "",
            LieuCode = lieu?.Code ?? "",
            ModeleNom = modele?.Nom ?? "",
            MarqueNom = marque?.Nom ?? "",
            ImpCode = imprimanteEdit.Code ?? ""
        };

        try
        {
            var response = await Http.PostAsJsonAsync("api/Naming/Preview", dto);
            if (response.IsSuccessStatusCode)
            {
                using var doc = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
                if (doc.RootElement.TryGetProperty("generatedName", out var prop))
                {
                    string val = prop.GetString() ?? "";
                    imprimanteEdit.NomAffiche = val;
                    if (namingSameShare) imprimanteEdit.NomPartage = val;
                }
            }
        }
        catch { }
    }

    private async Task OnSubmit(Imprimante args)
    {
        if (imprimanteEdit.EmplacementId == 0 || imprimanteEdit.ModeleId == 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Incomplet", "Lieu et Modèle sont requis.");
            return;
        }

        if (IsStagingMode)
        {
            DialogService.Close(imprimanteEdit);
            return;
        }

        try
        {
            if (imprimanteEdit.Status == PrinterStatus.ImportedNeedsFix)
            {
                imprimanteEdit.Status = PrinterStatus.PendingUpdate;
            }

            if (imprimanteEdit.Id == 0)
            {
                await Http.PostAsJsonAsync("api/Imprimantes", imprimanteEdit);
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Imprimante créée.");
            }
            else
            {
                await Http.PutAsJsonAsync($"api/Imprimantes/{imprimanteEdit.Id}", imprimanteEdit);
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Imprimante mise à jour.");
            }
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
    }

    private async Task OnDelete()
    {
        var confirm = await DialogService.Confirm("Êtes-vous sûr de vouloir supprimer cette imprimante ?", "Suppression",
            new ConfirmOptions() { OkButtonText = "Oui", CancelButtonText = "Non" });
        if (confirm == true)
        {
            try
            {
                await Http.DeleteAsync($"api/Imprimantes/{imprimanteEdit.Id}");
                NotificationService.Notify(NotificationSeverity.Success, "Supprimé", "L'imprimante a été supprimée.");
                DialogService.Close(true);
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
            }
        }
    }
}