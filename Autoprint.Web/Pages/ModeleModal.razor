@using Autoprint.Shared
@using Autoprint.Web.Services
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject CustomAuthStateProvider AuthProvider

@* Maquette « modales » (retour de recette du 11/11) : sections sans cadre, explications courtes sous les champs, action principale nommée *@
<RadzenTemplateForm TItem="Modele" Data="@modeleEdit" Submit="@OnSubmit">
    <div class="ap-dlg">
        <div class="ap-dlg-group" style="padding-top: 0;">
            <h3>Identification</h3>
            <div class="ap-dlg-grid">
                <div class="ap-field">
                    <RadzenLabel Text="Marque" Component="Marque" />
                    @if (canReadMarques)
                    {
                        <RadzenDropDown Name="Marque" @bind-Value="@modeleEdit.MarqueId"
                                        Data="@listeMarques" TextProperty="Nom" ValueProperty="Id" Placeholder="Choisir une marque"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
                                        Style="width: 100%;" />
                        <RadzenRequiredValidator Component="Marque" Text="Choisissez une marque" Popup="true" DefaultValue="0" />
                    }
                    else
                    {
                        <span class="ap-help is-warn">Vous n'avez pas accès aux marques</span>
                    }
                </div>
                <div class="ap-field">
                    <RadzenLabel Text="Nom du modèle" Component="Nom" />
                    <RadzenTextBox Name="Nom" @bind-Value="@modeleEdit.Nom" Style="width: 100%;" Placeholder="IM C3000" />
                    <RadzenRequiredValidator Component="Nom" Text="Saisissez le nom du modèle" Popup="true" />
                </div>
            </div>
        </div>

        <div class="ap-dlg-group">
            <h3>Pilote</h3>
            <div class="ap-field">
                <RadzenLabel Text="Pilote d'impression" Component="Pilote" />
                @if (canReadPilotes)
                {
                    <RadzenDropDown Name="Pilote" @bind-Value="@modeleEdit.PiloteId"
                                    Data="@listePilotesFiltrée" TextProperty="Nom" ValueProperty="Id" Placeholder="Choisir un pilote installé"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
                                    Style="width: 100%;">
                        <Template Context="p">
                            @{ var pil = (Pilote)p; }
                            @pil.Nom
                            @if (!pil.EstInstalle) { <span class="ap-help is-warn" style="margin-left: 6px;">absent du serveur</span> }
                        </Template>
                    </RadzenDropDown>
                    <RadzenRequiredValidator Component="Pilote" Text="Choisissez un pilote" Popup="true" DefaultValue="0" />
                    <span class="ap-help">Installé sur les files de ce modèle ; seuls les pilotes présents sur le serveur sont proposés (Pilotes, Scanner le serveur)</span>
                }
                else
                {
                    <span class="ap-help is-warn">Vous n'avez pas accès aux pilotes</span>
                }
            </div>
        </div>

        <div class="ap-dlg-group">
            <h3>Supervision SNMP <span class="ap-opt" style="font-size: 13px;">(facultatif)</span></h3>
            <div class="ap-dlg-grid">
                <div class="ap-field">
                    <RadzenLabel Text="Profil de lecture" Component="SnmpProfile" />
                    <RadzenDropDown Name="SnmpProfile" @bind-Value="@modeleEdit.SnmpProfileId"
                                    Data="@listeProfiles" TextProperty="Name" ValueProperty="Id" AllowClear="true" Placeholder="Valeurs standard"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
                                    Style="width: 100%;" />
                    <span class="ap-help">OID propres à ce modèle pour les consommables et compteurs</span>
                </div>
                <div class="ap-field">
                    <RadzenLabel Text="Identifiants" Component="SnmpCredential" />
                    <RadzenDropDown Name="SnmpCredential" @bind-Value="@modeleEdit.SnmpCredentialId"
                                    Data="@listeCredentials" TextProperty="Name" ValueProperty="Id" AllowClear="true" Placeholder="Ceux de chaque imprimante"
                                    Style="width: 100%;" />
                    <span class="ap-help">Utilisés par toutes les imprimantes de ce modèle, sauf exception sur l'une d'elles</span>
                </div>
            </div>
        </div>

        <div class="ap-dlg-footer">
            @if (modeleEdit.Id != 0)
            {
                <AuthorizeView Policy="MODEL_DELETE">
                    <Authorized Context="authContext">
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Text" Text="Supprimer" Click="@OnDelete" />
                    </Authorized>
                </AuthorizeView>
            }
            <span class="ap-grow"></span>
            <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => DialogService.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(modeleEdit.Id == 0 ? "Créer le modèle" : "Enregistrer les modifications")" ButtonStyle="ButtonStyle.Primary" />
        </div>
    </div>
</RadzenTemplateForm>

@code {
    [Parameter] public Modele ModeleToEdit { get; set; } = new();

    private Modele modeleEdit = new();
    private List<Marque> listeMarques = new();
    private List<Pilote> listePilotesFiltrée = new(); // Liste filtrée pour l'affichage
    private List<SnmpProfile> listeProfiles = new();

    private bool canReadMarques = false;
    private bool canReadPilotes = false;

    protected override async Task OnInitializedAsync()
    {
        modeleEdit = new Modele
        {
            Id = ModeleToEdit.Id,
            Nom = ModeleToEdit.Nom,
            MarqueId = ModeleToEdit.MarqueId,
            PiloteId = ModeleToEdit.PiloteId,
            SnmpProfileId = ModeleToEdit.SnmpProfileId,
            SnmpCredentialId = ModeleToEdit.SnmpCredentialId
        };

        canReadMarques = await AuthProvider.HasPermission("Permission", "BRAND_READ");
        canReadPilotes = await AuthProvider.HasPermission("Permission", "DRIVER_READ");

        var tasks = new List<Task>();
        if (canReadMarques) tasks.Add(LoadMarques());
        if (canReadPilotes) tasks.Add(LoadPilotes());
        tasks.Add(LoadSnmpProfiles());
        tasks.Add(LoadSnmpCredentials());

        if (tasks.Any()) await Task.WhenAll(tasks);
    }

    private List<Autoprint.Shared.DTOs.SnmpCredentialViewDto> listeCredentials = new();

    private async Task LoadSnmpCredentials()
    {
        try
        {
            listeCredentials = await Http.GetFromJsonAsync<List<Autoprint.Shared.DTOs.SnmpCredentialViewDto>>("api/SnmpCredentials") ?? new();
        }
        catch { }
    }

    private async Task LoadSnmpProfiles()
    {
        try
        {
            listeProfiles = await Http.GetFromJsonAsync<List<SnmpProfile>>("api/SnmpProfiles") ?? new();
        }
        catch { }
    }

    private async Task LoadMarques()
    {
        try
        {
            listeMarques = await Http.GetFromJsonAsync<List<Marque>>("api/Marques") ?? new();
        }
        catch {  }
    }

    private async Task LoadPilotes()
    {
        try
        {
            var tousLesPilotes = await Http.GetFromJsonAsync<List<Pilote>>("api/Pilotes") ?? new();

            listePilotesFiltrée = tousLesPilotes
                .Where(p => p.EstInstalle || p.Id == modeleEdit.PiloteId)
                .OrderBy(p => p.Nom)
                .ToList();
        }
        catch {  }
    }

    private async Task OnSubmit(Modele args)
    {
        try
        {
            if (modeleEdit.Id == 0)
            {
                if (!await (await Http.PostAsJsonAsync("api/Modeles", modeleEdit)).CheckAsync(NotificationService)) return;
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Modèle créé.");
            }
            else
            {
                if (!await (await Http.PutAsJsonAsync($"api/Modeles/{modeleEdit.Id}", modeleEdit)).CheckAsync(NotificationService)) return;
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Modèle mis à jour.");
            }
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
    }

    private async Task OnDelete()
    {
        var confirm = await DialogService.Confirm("Supprimer ce modèle ?", "Suppression",
            new ConfirmOptions() { OkButtonText = "Oui", CancelButtonText = "Non" });

        if (confirm == true)
        {
            try
            {
                if (!await (await Http.DeleteAsync($"api/Modeles/{modeleEdit.Id}")).CheckAsync(NotificationService)) return;
                NotificationService.Notify(NotificationSeverity.Success, "Supprimé", "Le modèle a été supprimé.");
                DialogService.Close(true);
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
            }
        }
    }
}