@page "/reports"
@using Autoprint.Shared
@using Autoprint.Web.Services
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject CustomAuthStateProvider AuthProvider

<PageTitle>Rapports d'Activité</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H3" Class="rz-mb-0">
        📊 Rapports & Planification
    </RadzenText>
    <RadzenButton Icon="add_circle" Text="Planifier un Rapport" ButtonStyle="ButtonStyle.Success" Click="@(() => OuvrirModal(new ReportSchedule()))" title="Planifier un nouveau rapport" />
</RadzenStack>

<RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-tertiary-color);" Class="rz-mb-4">
    Configurez des rapports réguliers contenant les métriques de votre choix (compteur de pages, niveaux de toner, taux de disponibilité, etc.) envoyés automatiquement par courriel à vos équipes au format PDF ou CSV.
</RadzenText>

@if (schedules == null)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else if (!schedules.Any())
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        Aucun rapport planifié. Cliquez sur "Planifier un Rapport" ci-dessus pour démarrer.
    </RadzenAlert>
}
else
{
    <RadzenDataGrid Data="@schedules" TItem="ReportSchedule" AllowPaging="true" PageSize="10" Style="width: 100%;">
        <Columns>
            <RadzenDataGridColumn TItem="ReportSchedule" Property="ReportName" Title="Nom du Rapport" />
            <RadzenDataGridColumn TItem="ReportSchedule" Title="Fréquence" Width="200px">
                <Template Context="s">
                    @if (s.Frequency == "Quotidien")
                    {
                        <span>Chaque jour à @(s.RunHour.ToString("D2"))h@(s.RunMinute.ToString("D2"))</span>
                    }
                    else if (s.Frequency == "Hebdomadaire")
                    {
                        <span>Chaque @(ObtenirNomJour(s.RunDayOfWeek)) à @(s.RunHour.ToString("D2"))h@(s.RunMinute.ToString("D2"))</span>
                    }
                    else if (s.Frequency == "Mensuel")
                    {
                        <span>Le @(s.RunDayOfMonth ?? 1) du mois à @(s.RunHour.ToString("D2"))h@(s.RunMinute.ToString("D2"))</span>
                    }
                    else
                    {
                        <span>@s.Frequency</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ReportSchedule" Property="Format" Title="Format" Width="100px" TextAlign="TextAlign.Center">
                <Template Context="s">
                    <RadzenBadge BadgeStyle="@(s.Format == "PDF" ? BadgeStyle.Danger : BadgeStyle.Success)" Text="@s.Format" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ReportSchedule" Property="EmailRecipients" Title="Destinataires" />
            <RadzenDataGridColumn TItem="ReportSchedule" Property="IsActive" Title="Actif" Width="90px" TextAlign="TextAlign.Center">
                <Template Context="s">
                    <RadzenSwitch Value="@s.IsActive" ValueChanged="@((bool val) => BasculerStatut(s, val))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ReportSchedule" Property="LastRunAt" Title="Dernier envoi" Width="150px">
                <Template Context="s">
                    @(s.LastRunAt.HasValue ? s.LastRunAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ReportSchedule" Property="NextRunAt" Title="Prochain envoi" Width="150px">
                <Template Context="s">
                    @(s.NextRunAt.HasValue ? s.NextRunAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ReportSchedule" Title="Actions" Width="160px" TextAlign="TextAlign.Center">
                <Template Context="s">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                        <RadzenButton Icon="mail" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => TesterEnvoi(s))" Tooltip="Envoyer maintenant (Test)" title="Envoyer maintenant (Test)" />
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => OuvrirModal(s))" Tooltip="Modifier" title="Modifier" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => Supprimer(s))" Tooltip="Supprimer" title="Supprimer" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    private List<ReportSchedule>? schedules;

    protected override async Task OnInitializedAsync()
    {
        await ChargerSchedules();
    }

    private async Task ChargerSchedules()
    {
        try
        {
            schedules = await Http.GetFromJsonAsync<List<ReportSchedule>>("api/ReportSchedules");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", "Chargement des rapports : " + ex.Message);
        }
    }

    private async Task BasculerStatut(ReportSchedule s, bool val)
    {
        s.IsActive = val;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/ReportSchedules/{s.Id}", s);
            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Statut mis à jour", 
                    s.IsActive ? $"Le rapport '{s.ReportName}' est désormais actif." : $"Le rapport '{s.ReportName}' est mis en pause.");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(NotificationSeverity.Error, "Erreur lors de la modification", error);
                await ChargerSchedules();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
            await ChargerSchedules();
        }
    }

    private async Task OuvrirModal(ReportSchedule s)
    {
        var result = await DialogService.OpenAsync<ReportScheduleModal>(
            s.Id > 0 ? "Modifier la planification" : "Créer un rapport planifié",
            new Dictionary<string, object> { { "ScheduleToEdit", s } },
            new DialogOptions { Width = "750px" }
        );

        if (result == true)
        {
            await ChargerSchedules();
        }
    }

    private async Task TesterEnvoi(ReportSchedule s)
    {
        NotificationService.Notify(NotificationSeverity.Info, "Envoi en cours", "Génération et envoi du rapport...");
        try
        {
            var response = await Http.PostAsync($"api/ReportSchedules/{s.Id}/send", null);
            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Envoyé", "Le rapport a été généré et expédié par courriel.");
                await ChargerSchedules();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(NotificationSeverity.Error, "Erreur lors de l'envoi", error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
    }

    private async Task Supprimer(ReportSchedule s)
    {
        var confirm = await DialogService.Confirm($"Supprimer le rapport planifié '{s.ReportName}' ?", "Confirmation",
            new ConfirmOptions { OkButtonText = "Oui", CancelButtonText = "Non" });

        if (confirm == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/ReportSchedules/{s.Id}");
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Supprimé", "Le rapport planifié a été supprimé.");
                    await ChargerSchedules();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    NotificationService.Notify(NotificationSeverity.Error, "Erreur", error);
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
            }
        }
    }

    private string ObtenirNomJour(int? runDayOfWeek)
    {
        switch (runDayOfWeek)
        {
            case 0: return "dimanche";
            case 1: return "lundi";
            case 2: return "mardi";
            case 3: return "mercredi";
            case 4: return "jeudi";
            case 5: return "vendredi";
            case 6: return "samedi";
            default: return "lundi";
        }
    }
}
