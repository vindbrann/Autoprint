@using Autoprint.Web.Services
@using Autoprint.Shared
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

@* Maquette « modales » (retour de recette du 11/11) : champ unique, action principale nommée, barre d'actions fixe *@
<RadzenTemplateForm TItem="Marque" Data="@marqueEdit" Submit="@OnSubmit">
    <div class="ap-dlg">
        <p class="ap-dlg-lead">Les modèles d'imprimantes sont rangés par marque.</p>
        <div class="ap-field">
            <RadzenLabel Text="Nom de la marque" Component="Nom" />
            <RadzenTextBox Name="Nom" @bind-Value="@marqueEdit.Nom" Style="width: 100%;" Placeholder="Ricoh" />
            <RadzenRequiredValidator Component="Nom" Text="Saisissez le nom de la marque" Popup="true" />
        </div>

        <div class="ap-dlg-footer">
            @if (marqueEdit.Id != 0)
            {
                <AuthorizeView Policy="BRAND_DELETE">
                    <Authorized Context="authContext">
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Text" Text="Supprimer" Click="@OnDelete" />
                    </Authorized>
                </AuthorizeView>
            }
            <span class="ap-grow"></span>
            <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => DialogService.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(marqueEdit.Id == 0 ? "Créer la marque" : "Enregistrer les modifications")" ButtonStyle="ButtonStyle.Primary" />
        </div>
    </div>
</RadzenTemplateForm>

@code {
    [Parameter] public Marque MarqueToEdit { get; set; } = new();

    private Marque marqueEdit = new();

    protected override void OnInitialized()
    {
        marqueEdit = new Marque
        {
            Id = MarqueToEdit.Id,
            Nom = MarqueToEdit.Nom
        };
    }

    private async Task OnSubmit(Marque args)
    {
        try
        {
            if (marqueEdit.Id == 0)
            {
                if (!await (await Http.PostAsJsonAsync("api/Marques", marqueEdit)).CheckAsync(NotificationService)) return;
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Marque créée avec succès.");
            }
            else
            {
                if (!await (await Http.PutAsJsonAsync($"api/Marques/{marqueEdit.Id}", marqueEdit)).CheckAsync(NotificationService)) return;
                NotificationService.Notify(NotificationSeverity.Success, "Succès", "Marque mise à jour.");
            }

            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", $"Impossible d'enregistrer : {ex.Message}");
        }
    }

    private async Task OnDelete()
    {
        var confirm = await DialogService.Confirm("Êtes-vous sûr de vouloir supprimer cette marque ?", "Suppression",
            new ConfirmOptions() { OkButtonText = "Oui", CancelButtonText = "Non" });

        if (confirm == true)
        {
            try
            {
                if (!await (await Http.DeleteAsync($"api/Marques/{marqueEdit.Id}")).CheckAsync(NotificationService)) return;
                NotificationService.Notify(NotificationSeverity.Success, "Supprimé", "La marque a été supprimée.");
                DialogService.Close(true);
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", $"Erreur de suppression : {ex.Message}");
            }
        }
    }
}