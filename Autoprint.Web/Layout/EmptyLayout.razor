@inherits LayoutComponentBase
@using Radzen
@using Radzen.Blazor
@using Autoprint.Web.Services

@inject AppThemeService AppTheme

<RadzenComponents />
<RadzenTheme Theme="standard" />

<div class="main" style="background-color: var(--rz-base-background-color); min-height: 100vh;">
    <div class="content px-4">
        @Body
    </div>
</div>

@code {
    protected override Task OnInitializedAsync() => AppTheme.InitializeAsync();
}