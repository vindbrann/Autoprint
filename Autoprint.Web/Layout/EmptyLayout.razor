@inherits LayoutComponentBase
@using Radzen
@using Radzen.Blazor
@using Autoprint.Web.Services

@inject AppThemeService AppTheme

<RadzenComponents />
<RadzenTheme Theme="standard" />

<div style="background: var(--ap-background); min-height: 100vh;">
    @Body
</div>

@code {
    protected override Task OnInitializedAsync() => AppTheme.InitializeAsync();
}