@using Autoprint.Web.Services
@implements IDisposable
@inject IAuthService AuthService
@inject NavigationManager NavManager
@inject AlertService AlertService
@inject AppThemeService AppTheme

@* Menu principal (charte B77, maquette « _sidebar ») : réductible en barre d'icônes, choix mémorisé par utilisateur (MainLayout). *@
<nav class="ap-sidenav" aria-label="Navigation principale">

    <div class="ap-side-top">
        <a class="ap-brand" href="">
            <img src="images/autoprint-symbole.svg" alt="" />
            <span class="ap-brand-name">Autoprint</span>
        </a>
        <RadzenButton Icon="@(Collapsed ? "left_panel_open" : "left_panel_close")" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                      Size="ButtonSize.Small" Click="@(() => OnToggleCollapse.InvokeAsync())"
                      title="@(Collapsed ? "Agrandir le menu" : "Réduire le menu")" aria-label="@(Collapsed ? "Agrandir le menu" : "Réduire le menu")" />
    </div>

    <div class="ap-side-scroll">
        <AuthorizeView>
            <Authorized Context="menuAuth">

                <RadzenPanelMenu>
                    <NavItem Text="Tableau de bord" Icon="dashboard" Path="" />
                </RadzenPanelMenu>

                @if (CanShowGestionSection(menuAuth.User))
                {
                    <div class="ap-nav-section">Gestion</div>
                    <RadzenPanelMenu>
                        <AuthorizeView Policy="PRINTER_READ"><NavItem Text="Imprimantes" Icon="print" Path="imprimantes" /></AuthorizeView>
                        <AuthorizeView Policy="LOCATION_READ"><NavItem Text="Lieux" Icon="location_on" Path="lieux" /></AuthorizeView>
                        <AuthorizeView Policy="BRAND_READ"><NavItem Text="Marques" Icon="sell" Path="marques" /></AuthorizeView>
                        <AuthorizeView Policy="MODEL_READ"><NavItem Text="Modèles" Icon="category" Path="modeles" Alert="@AlertService.State.ModelAlert" /></AuthorizeView>
                        <AuthorizeView Policy="DRIVER_READ"><NavItem Text="Pilotes" Icon="developer_board" Path="pilotes" Alert="@AlertService.State.DriverAlert" /></AuthorizeView>
                        <AuthorizeView Policy="SNMP_PROFILE_READ">
                            <NavItem Text="Profils SNMP" Icon="lan" Path="snmp-profiles" />
                            <NavItem Text="Identifiants SNMP" Icon="key" Path="snmp-credentials" />
                        </AuthorizeView>
                        <AuthorizeView Policy="REPORT_MANAGE"><NavItem Text="Rapports et planification" Icon="bar_chart" Path="reports" /></AuthorizeView>
                    </RadzenPanelMenu>
                }

                @if (CanShowSystemSection(menuAuth.User))
                {
                    <div class="ap-nav-section">Système</div>
                    <RadzenPanelMenu>
                        <AuthorizeView Policy="SETTINGS_MANAGE"><NavItem Text="Paramètres" Icon="settings" Path="parametres" /></AuthorizeView>
                        <AuthorizeView Policy="USER_READ"><NavItem Text="Utilisateurs" Icon="group" Path="users" /></AuthorizeView>
                        <AuthorizeView Policy="AUDIT_READ"><NavItem Text="Journal d'audit" Icon="history" Path="audit" /></AuthorizeView>
                        <AuthorizeView Policy="ROLE_READ"><NavItem Text="Rôles et droits" Icon="admin_panel_settings" Path="roles" /></AuthorizeView>
                    </RadzenPanelMenu>
                }

            </Authorized>
        </AuthorizeView>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="ap-side-foot">
                <a class="ap-who" href="profile" title="Mon profil">
                    <span class="ap-avatar" aria-hidden="true">@GetInitials(GetNomAffichage(context.User))</span>
                    <span class="ap-who-text">
                        <b>@GetNomAffichage(context.User)</b>
                        <small>Connecté</small>
                    </span>
                </a>
                <RadzenButton Icon="@currentThemeIcon" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                              Click="ToggleTheme" title="Changer de thème" aria-label="Changer de thème" />
                <RadzenButton Icon="logout" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                              Click="BeginLogout" title="Déconnexion" aria-label="Déconnexion" />
            </div>
        </Authorized>
    </AuthorizeView>

</nav>
@code {
    [CascadingParameter(Name = "NavCollapsed")] public bool Collapsed { get; set; }
    [Parameter] public EventCallback OnToggleCollapse { get; set; }

    private string currentThemeIcon => AppTheme.IsDark ? "light_mode" : "dark_mode";

    protected override void OnInitialized()
    {
        AlertService.OnChange += StateHasChanged;
        AppTheme.OnChange += StateHasChanged;
        _ = AlertService.RefreshState();
    }

    public void Dispose()
    {
        AlertService.OnChange -= StateHasChanged;
        AppTheme.OnChange -= StateHasChanged;
    }

    private Task ToggleTheme() => AppTheme.ToggleAsync();

    private async Task BeginLogout()
    {
        await AuthService.Logout();
        NavManager.NavigateTo("/login", true);
    }

    private string GetNomAffichage(System.Security.Claims.ClaimsPrincipal user)
    {
        var display = user.FindFirst("DisplayName")?.Value;
        return !string.IsNullOrEmpty(display) ? display : user.Identity?.Name ?? "User";
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        return name.Substring(0, 1).ToUpper();
    }

    private bool CanShowSystemSection(System.Security.Claims.ClaimsPrincipal user)
    {
        return user.HasClaim(c => c.Type == "Permission" &&
                             (c.Value == "SETTINGS_MANAGE" ||
                              c.Value == "USER_READ" ||
                              c.Value == "AUDIT_READ" ||
                              c.Value == "ROLE_READ"));
    }

    private bool CanShowGestionSection(System.Security.Claims.ClaimsPrincipal user)
    {
        return user.HasClaim(c => c.Type == "Permission" &&
                             (c.Value == "PRINTER_READ" ||
                              c.Value == "LOCATION_READ" ||
                              c.Value == "BRAND_READ" ||
                              c.Value == "MODEL_READ" ||
                              c.Value == "DRIVER_READ" ||
                              c.Value == "SNMP_PROFILE_READ" ||
                              c.Value == "REPORT_MANAGE"));
    }
}