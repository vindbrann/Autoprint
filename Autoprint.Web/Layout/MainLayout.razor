@inherits LayoutComponentBase
@using System.Security.Claims
@using Autoprint.Shared.DTOs
@using Autoprint.Web.Pages
@using Autoprint.Web.Services
@using Radzen
@using Radzen.Blazor

@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IAuthService AuthService
@inject IJSRuntime JS
@inject AppThemeService AppTheme
@inject ILocalStorageService LocalStorage
@inject NotificationService NotificationService

<RadzenComponents />
<RadzenTheme Theme="standard" />

<AuthorizeView>
    <Authorized>
        @if (IsBlocked(context.User))
        {
            <SecurityWall OnSuccess="HandleSuccess" OnLogout="HandleLogout" />
        }
        else
        {
            <CascadingValue Value="@navCollapsed" Name="NavCollapsed">
                <RadzenLayout class="@(navCollapsed ? "ap-shell is-collapsed" : "ap-shell")" Style="height: 100vh; display: flex;">
                    <RadzenSidebar Expanded="true" class="ap-sidebar">
                        <NavMenu OnToggleCollapse="ToggleNav" />
                    </RadzenSidebar>

                    <RadzenBody Style="flex: 1; overflow: auto;">
                        <div class="ap-page">
                            @Body
                        </div>
                    </RadzenBody>
                </RadzenLayout>
            </CascadingValue>
        }
    </Authorized>

    <NotAuthorized>
        <div class="login-container d-flex align-items-center justify-content-center"
             style="min-height: 100vh; background-color: var(--rz-base-background-color);">
            <div class="w-100" style="max-width: 500px; text-align: center;">
                <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                <p class="mt-2">Redirection vers la connexion...</p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    // Menu principal réduit en barre d'icônes : choix mémorisé par navigateur ; réduit d'office sous 1024 px (charte B77)
    private bool navCollapsed;
    private const string NavCollapsedKey = "nav_collapsed";

    protected override async Task OnInitializedAsync()
    {
        await AppTheme.InitializeAsync();
        try
        {
            navCollapsed = await LocalStorage.GetItemAsync<bool?>(NavCollapsedKey) ?? false;
            if (!navCollapsed && await JS.InvokeAsync<bool>("autoprintIsNarrow")) navCollapsed = true;
        }
        catch { /* stockage ou script indisponible : menu ouvert */ }
    }

    private async Task ToggleNav()
    {
        navCollapsed = !navCollapsed;
        try { await LocalStorage.SetItemAsync(NavCollapsedKey, navCollapsed); } catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();

        if (!state.User.Identity?.IsAuthenticated ?? true)
        {
            var uri = NavManager.Uri;
            if (!uri.Contains("/login") && !uri.Contains("/reset-password"))
            {
                NavManager.NavigateTo("/login", true);
            }
        }
    }

    private bool IsBlocked(ClaimsPrincipal user)
    {
        return user.HasClaim(c => c.Type == "ForcePasswordChange" && c.Value == "true");
    }

    private async Task HandleSuccess()
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Succès",
            Detail = "Mot de passe mis à jour. Redirection...",
            Duration = 3000
        });
        await Task.Delay(2000);
        await HandleLogout();
    }

    private async Task HandleLogout()
    {
        await AuthService.Logout();
        NavManager.NavigateTo("/login", true);
    }
}