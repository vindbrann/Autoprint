<UserControl x:Class="Autoprint.Client.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="500">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="460" HorizontalAlignment="Stretch">

            <TextBlock Text="Préférences Utilisateur" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,15" Opacity="0.6"/>

            <!-- Notifications -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBlock Text="M'avertir lors du changement de lieu de travail" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" IsChecked="{Binding EnableNotifications}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
            </Grid>

            <Separator Margin="0,0,0,15"/>

            <!-- Gestion intelligente -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Gestion Intelligente" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBlock Text="Changer l'imprimante par défaut automatiquement selon mes favoris" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" IsChecked="{Binding AutoSwitchDefaultPrinter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
            </Grid>

            <Separator Margin="0,0,0,15"/>

            <!-- Démarrage automatique -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Démarrage automatique" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBlock Text="Lancer Autoprint à l'ouverture de session Windows" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" IsChecked="{Binding StartWithWindows}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
            </Grid>

            <!-- Zone Technique Administrateur (Affichée après 5 clics sur la version) -->
            <StackPanel Margin="0,15,0,0"
                        Visibility="{Binding IsAdminPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Separator Background="Orange" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Security" Foreground="Orange" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="ZONE TECHNIQUE (ADMIN)" FontWeight="Bold" Foreground="Orange" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" 
                            Style="{StaticResource MaterialDesignIconButton}" 
                            Command="{Binding CloseAdminPanelCommand}"
                            ToolTip="Verrouiller et masquer la zone technique"
                            Width="28" Height="28">
                        <materialDesign:PackIcon Kind="Lock" Foreground="Orange" Width="16" Height="16"/>
                    </Button>
                </Grid>

                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="URL Serveur d'impression"
                         Text="{Binding AdminServerUrl, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True"
                         Foreground="{DynamicResource MaterialDesignBody}"
                         Margin="0,0,0,10"/>

                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Clé API (Agent)"
                         Text="{Binding AdminApiKey, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource MaterialDesignBody}"
                         Margin="0,0,0,15"/>

                <Button Command="{Binding TestConnectionCommand}"
                        Content="TESTER LA CONNEXION SERVEUR"
                        IsEnabled="{Binding IsNotTesting}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="Orange" Foreground="Orange"
                        materialDesign:ButtonAssist.CornerRadius="5"/>

                <Grid Margin="0,10,0,0">
                    <TextBlock Text="{Binding TestStatusMessage}" 
                               Foreground="{Binding TestStatusColor}" 
                               TextWrapping="Wrap" 
                               HorizontalAlignment="Center"
                               Visibility="{Binding IsNotTesting, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ProgressBar IsIndeterminate="True" 
                                 Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 Value="0" Width="20" Height="20"
                                 Visibility="{Binding IsTesting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </StackPanel>

            <!-- Pied des options -->
            <StackPanel Margin="0,25,0,10">
                <TextBlock Text="Les modifications sont enregistrées automatiquement." 
                           HorizontalAlignment="Center" FontSize="11" Opacity="0.4" FontStyle="Italic" Margin="0,0,0,4"/>

                <Button Command="{Binding VersionClickCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Height="Auto" Padding="8,4"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesignBody}"
                        Opacity="0.4"
                        ToolTip="Version de l'agent (Cliquez 5 fois pour la zone admin)">
                    <TextBlock Text="{Binding VersionText}" FontSize="10"/>
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
