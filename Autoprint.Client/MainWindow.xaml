<Window x:Class="Autoprint.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Autoprint.Client.ViewModels"
        xmlns:views="clr-namespace:Autoprint.Client.Views"
        xmlns:converters="clr-namespace:Autoprint.Client.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Autoprint" Height="620" Width="540"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="{DynamicResource {x:Static SystemFonts.MessageFontWeightKey}}"
        TextElement.FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Icon="Autoprint.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Style personnalisé pour les onglets en pilule (Segmented Pill Tabs) -->
        <Style x:Key="ModernPillTabStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" 
                                Background="Transparent" 
                                CornerRadius="16" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                <Setter Property="TextElement.FontWeight" Value="Bold"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource MaterialDesignPaper}" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}" Opacity="0.99">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- En-tête : Lieu et statut -->
                <RowDefinition Height="Auto"/> <!-- Barre de navigation par onglets -->
                <RowDefinition Height="*"/>    <!-- Contenu dynamique (Views) -->
                <RowDefinition Height="Auto"/> <!-- Pied de page -->
            </Grid.RowDefinitions>

            <!-- 1. En-tête de la fenêtre (Draggable) -->
            <materialDesign:ColorZone Grid.Row="0" Mode="Standard" Padding="15,12,15,8" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Autoprint.ico" 
                               Width="22" Height="22" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <TextBlock Text="AUTOPRINT CLIENT" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Opacity="0.6"/>

                        <!-- Badge Hors Ligne -->
                        <Border CornerRadius="4" Background="{DynamicResource MaterialDesignValidationErrorBrush}" Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="MODE HORS LIGNE" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <!-- Titre du Lieu Actuel -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,4">
                        <materialDesign:PackIcon Kind="MapMarker" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                        <TextBlock Text="{Binding TitreLieu}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Bouton Fermer (Réduire dans le Tray) -->
                    <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" 
                            Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Click="BtnFermer_Click" 
                            ToolTip="Réduire dans la barre des tâches" 
                            VerticalAlignment="Top" 
                            Margin="0,-4,-4,0">
                        <materialDesign:PackIcon Kind="Close" />
                    </Button>
                </Grid>
            </materialDesign:ColorZone>

            <!-- 2. Barre de Navigation par Onglets Segmentés (Pill Tabs) -->
            <Border Grid.Row="1" Background="{DynamicResource MaterialDesignPaper}" Padding="15,4,15,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="18" Padding="2" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">

                        <!-- Onglet 1 : Disponibles -->
                        <RadioButton Style="{StaticResource ModernPillTabStyle}"
                                     IsChecked="{Binding IsPrintersTabSelected, Mode=OneWay}"
                                     Command="{Binding SelectTabCommand}"
                                     CommandParameter="Printers">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Disponibles" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                <Border Background="#1E88E5" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Imprimantes.Count}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <!-- Onglet 2 : Mes installations (Nettoyage) -->
                        <RadioButton Style="{StaticResource ModernPillTabStyle}"
                                     IsChecked="{Binding IsManageTabSelected, Mode=OneWay}"
                                     Command="{Binding SelectTabCommand}"
                                     CommandParameter="Manage">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Broom" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Mes installations" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                <Border Background="#43A047" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ManageViewModel.InstalledPrinters.Count}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <!-- Onglet 3 : Options -->
                        <RadioButton Style="{StaticResource ModernPillTabStyle}"
                                     IsChecked="{Binding IsOptionsTabSelected, Mode=OneWay}"
                                     Command="{Binding SelectTabCommand}"
                                     CommandParameter="Options">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Options" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </Border>
            </Border>

            <!-- 3. Zone de Contenu Dynamique (Affichage de la vue selon l'onglet actif) -->
            <Grid Grid.Row="2">
                <!-- Vue Disponibles -->
                <Grid Visibility="{Binding IsPrintersTabSelected, Converter={StaticResource BoolToVis}}">
                    <views:PrintersView DataContext="{Binding}"/>
                </Grid>

                <!-- Vue Mes installations -->
                <Grid Visibility="{Binding IsManageTabSelected, Converter={StaticResource BoolToVis}}">
                    <views:ManagePrintersView DataContext="{Binding ManageViewModel}"/>
                </Grid>

                <!-- Vue Options -->
                <Grid Visibility="{Binding IsOptionsTabSelected, Converter={StaticResource BoolToVis}}">
                    <views:OptionsView DataContext="{Binding OptionsViewModel}"/>
                </Grid>
            </Grid>

            <!-- 4. Pied de page unifié -->
            <materialDesign:ColorZone Grid.Row="3" Mode="Standard" Padding="15,8" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Version -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Opacity="0.5" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding AppVersion}" FontSize="11"/>
                    </StackPanel>

                    <!-- Raccourci vers la gestion Windows -->
                    <Button Grid.Column="1" 
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding OpenWindowsPrintersCommand}"
                            HorizontalAlignment="Center" 
                            Height="28" 
                            Padding="8,0"
                            Foreground="{DynamicResource MaterialDesignBody}"
                            ToolTip="Ouvrir la gestion des imprimantes Windows">
                        <StackPanel Orientation="Horizontal" Opacity="0.75">
                            <materialDesign:PackIcon Kind="MicrosoftWindows" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Paramètres Windows ↗" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Actualiser -->
                    <Button Grid.Column="2" 
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            HorizontalAlignment="Right" 
                            Height="28" 
                            Padding="8,0" 
                            Foreground="{DynamicResource MaterialDesignBody}"
                            Click="BtnActualiser_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="ACTUALISER" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </materialDesign:ColorZone>
        </Grid>
    </Border>
</Window>