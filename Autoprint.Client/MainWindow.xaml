<Window x:Class="Autoprint.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Autoprint.Client.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Autoprint" Width="360" SizeToContent="Height" MinHeight="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource Autoprint.Font}"
        Icon="Autoprint.ico">

    <!-- Panneau unique près de l'horloge (B81) : tout sur une page, deux volets par-dessus (réglages, autre site) -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <converters:InvertBooleanToVisibilityConverter x:Key="NotVis" />

        <!-- Titre de groupe -->
        <Style x:Key="Grp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Autoprint.Brush.TextMuted}" />
            <Setter Property="Margin" Value="6,10,6,4" />
        </Style>
        <!-- Indication discrète -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Autoprint.Brush.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="6,0,6,4" />
        </Style>
        <Style x:Key="Name" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Autoprint.Brush.Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Autoprint.Brush.TextMuted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Ligne cliquable (choisir l'imprimante par défaut, ouvrir un site) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Autoprint.FocusVisual}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Autoprint.Brush.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallIcon" TargetType="Button" BasedOn="{StaticResource Autoprint.Button.Icon}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource Autoprint.Button.Text}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource Autoprint.Button.Text}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <!-- Champ de recherche : loupe, texte indicatif (Tag), croix pour vider -->
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource Autoprint.TextBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4,4,4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource Autoprint.Brush.SurfaceRaised}" BorderBrush="{DynamicResource Autoprint.Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="10,0,4,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Autoprint.Brush.TextMuted}" />
                                <TextBlock x:Name="Ph" Grid.Column="1" Margin="10,0,0,0" Text="{TemplateBinding Tag}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Autoprint.Brush.TextMuted}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Focusable="False" />
                                <Button x:Name="Clear" Grid.Column="2" Style="{StaticResource SmallIcon}" Width="24" Height="24" Click="ClearSearch_Click"
                                        ToolTip="Effacer" AutomationProperties.Name="Effacer" Visibility="Visible">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Clear" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Autoprint.Brush.Primary}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Autoprint.Brush.Surface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton « Ajouter » ou indicateur d'ajout en cours -->
        <DataTemplate x:Key="AddAction">
            <Grid>
                <Button Style="{StaticResource AddButton}" Command="{Binding AddCommand}"
                        ToolTip="{Binding DataContext.AddDisabledTip, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="{Binding Name, StringFormat=Ajouter {0}}"
                        Visibility="{Binding IsBusy, Converter={StaticResource NotVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Ajouter" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Value="0" Width="14" Height="14" Margin="0,0,6,0" />
                    <TextBlock Text="Ajout" FontSize="13" Foreground="{DynamicResource Autoprint.Brush.TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Ligne « Retirée · Annuler » (retrait effectué à la fermeture du panneau) -->
        <DataTemplate x:Key="GoneRow">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Opacity="0.6">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Name}" TextDecorations="Strikethrough" />
                    <TextBlock Text="Retirée" Style="{StaticResource Sub}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AddButton}" Content="Annuler" Command="{Binding UndoCommand}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Vos imprimantes : bouton radio = imprimante par défaut -->
        <DataTemplate x:Key="MyRow">
            <Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GoneRow}" Visibility="{Binding IsPendingRemoval, Converter={StaticResource Vis}}" Focusable="False" />
                <Button Command="{Binding PickCommand}" Visibility="{Binding IsPendingRemoval, Converter={StaticResource NotVis}}"
                        AutomationProperties.Name="{Binding Name, StringFormat=Imprimer sur {0}}">
                    <Button.Resources>
                        <Style TargetType="Border" x:Key="FlashStyle">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Flash}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.15" Duration="0:0:0.85" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Autoprint.Brush.PrimarySubtle}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Border Style="{StaticResource FlashStyle}" Background="{DynamicResource Autoprint.Brush.Primary}" CornerRadius="8" Margin="-8,-6" IsHitTestVisible="False" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Bouton radio dessiné -->
                            <Grid Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource Autoprint.Brush.BorderStrong}" StrokeThickness="2" />
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Autoprint.Brush.Primary}" Visibility="Collapsed" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Name}" />
                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Sub}" Visibility="{Binding HasSub, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <Border Grid.Column="2" Margin="6,0,2,0" VerticalAlignment="Center" Padding="6,1" CornerRadius="4" Background="{DynamicResource Autoprint.Brush.Surface}"
                                    Visibility="{Binding IsDefault, Converter={StaticResource Vis}}">
                                <TextBlock Text="Par défaut" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Autoprint.Brush.Primary}" />
                            </Border>
                            <Button Grid.Column="3" Style="{StaticResource SmallIcon}" Command="{Binding RemoveCommand}"
                                    ToolTip="{Binding Name, StringFormat=Retirer {0}}" AutomationProperties.Name="{Binding Name, StringFormat=Retirer {0}}">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="17" Height="17" />
                            </Button>
                        </Grid>
                    </Grid>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Autoprint.Brush.Primary}" />
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Imprimante à ajouter -->
        <DataTemplate x:Key="AddRow">
            <Grid Margin="8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Name}" />
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Sub}" Visibility="{Binding HasSub, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding ErrorText}" FontSize="12" Foreground="{DynamicResource Autoprint.Brush.Danger}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource Vis}}" />
                </StackPanel>
                <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource AddAction}" VerticalAlignment="Center" Focusable="False" />
            </Grid>
        </DataTemplate>

        <!-- Imprimante du volet « autre site » : ajouter, ou déjà ajoutée -->
        <DataTemplate x:Key="SitePrinterRow">
            <Grid Margin="8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Name}" />
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Sub}" Visibility="{Binding HasSub, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding ErrorText}" FontSize="12" Foreground="{DynamicResource Autoprint.Brush.Danger}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource Vis}}" />
                </StackPanel>
                <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource AddAction}" VerticalAlignment="Center" Focusable="False"
                                Visibility="{Binding IsInstalled, Converter={StaticResource NotVis}}" />
                <TextBlock Grid.Column="1" Text="Déjà ajoutée" FontSize="12" Foreground="{DynamicResource Autoprint.Brush.Success}" VerticalAlignment="Center" Margin="8,0"
                           Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}" />
            </Grid>
        </DataTemplate>

        <!-- Imprimante installée sur un autre site -->
        <DataTemplate x:Key="OtherRow">
            <Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GoneRow}" Visibility="{Binding IsPendingRemoval, Converter={StaticResource Vis}}" Focusable="False" />
                <Grid Margin="8,5" Visibility="{Binding IsPendingRemoval, Converter={StaticResource NotVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Name}" />
                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Sub}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SmallIcon}" Command="{Binding RemoveCommand}"
                            ToolTip="{Binding Name, StringFormat=Retirer {0}}" AutomationProperties.Name="{Binding Name, StringFormat=Retirer {0}}">
                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="17" Height="17" />
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Site du volet « autre site » -->
        <DataTemplate x:Key="SiteRowTemplate">
            <Button Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Name}" />
                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Sub}" />
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="1" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource Autoprint.Brush.TextMuted}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Réglage : texte à gauche, interrupteur à droite -->
        <Style x:Key="SetTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Autoprint.Brush.Text}" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Autoprint.Client.Window}" ClipToBounds="True">
        <Grid>
            <!-- ================= Panneau principal ================= -->
            <DockPanel>
                <!-- En-tête : site actuel et état du serveur -->
                <Grid DockPanel.Dock="Top" Margin="12,10,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Autoprint.Brush.PrimarySubtle}" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="MapMarkerOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Autoprint.Brush.Primary}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Autoprint.Brush.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanInstall}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource Autoprint.Brush.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding HeaderKicker}" FontSize="12" Foreground="{DynamicResource Autoprint.Brush.TextMuted}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SiteName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Autoprint.Brush.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SiteName}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Autoprint.Button.Icon}" Command="{Binding OpenSettingsCommand}" ToolTip="Réglages" AutomationProperties.Name="Réglages">
                        <materialDesign:PackIcon Kind="CogOutline" Width="19" Height="19" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource Autoprint.Button.Icon}" Click="BtnFermer_Click" ToolTip="Fermer" AutomationProperties.Name="Fermer">
                        <materialDesign:PackIcon Kind="Close" Width="19" Height="19" />
                    </Button>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0,8,10">
                        <!-- Serveur injoignable : note discrète, sans popup -->
                        <Border Margin="4,2,4,4" Padding="10,8" CornerRadius="10" Background="{DynamicResource Autoprint.Brush.WarningSubtle}" Visibility="{Binding ShowNote, Converter={StaticResource Vis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AlertOutline" Width="16" Height="16" Margin="0,1,8,0" Foreground="{DynamicResource Autoprint.Brush.Warning}" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Autoprint.Brush.Text}">
                                    <Run Text="{Binding NoteTitle, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding NoteText, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Vos imprimantes du site -->
                        <StackPanel Visibility="{Binding ShowMySection, Converter={StaticResource Vis}}">
                            <TextBlock Text="Vos imprimantes" Style="{StaticResource Grp}" />
                            <TextBlock Text="Cochez celle qui imprime vos documents" Style="{StaticResource Hint}" Foreground="{DynamicResource Autoprint.Brush.Warning}"
                                       Visibility="{Binding ShowDefaultHint, Converter={StaticResource Vis}}" />
                            <TextBlock Text="Ajoutez la plus proche de vous : elle imprimera vos documents à chaque passage." Style="{StaticResource Hint}"
                                       Visibility="{Binding ShowNoPrinterHint, Converter={StaticResource Vis}}" />
                            <ItemsControl ItemsSource="{Binding MyPrinters}" ItemTemplate="{StaticResource MyRow}" Focusable="False"
                                          AutomationProperties.Name="Imprimante par défaut" />
                        </StackPanel>

                        <!-- Ajouter sur ce site : liste courte -->
                        <StackPanel Visibility="{Binding ShowAddSimple, Converter={StaticResource Vis}}">
                            <TextBlock Text="Ajouter sur ce site" Style="{StaticResource Grp}" />
                            <ItemsControl ItemsSource="{Binding AddPrinters}" ItemTemplate="{StaticResource AddRow}" Focusable="False" />
                        </StackPanel>

                        <!-- Ajouter sur ce site : grand site, replié -->
                        <Button Margin="4,8,4,2" Command="{Binding OpenAddCommand}" Visibility="{Binding ShowAddCollapsed, Converter={StaticResource Vis}}" Cursor="Hand"
                                AutomationProperties.Name="Ajouter une imprimante">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Rectangle x:Name="Bd" RadiusX="10" RadiusY="10" Stroke="{DynamicResource Autoprint.Brush.BorderStrong}" StrokeDashArray="4 3" StrokeThickness="1" Fill="Transparent" />
                                        <ContentPresenter Margin="10,0" MinHeight="40" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Fill" Value="{DynamicResource Autoprint.Brush.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Autoprint.Brush.Primary}" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="Ajouter une imprimante" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Autoprint.Brush.Primary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding AddCount}" FontSize="13" Foreground="{DynamicResource Autoprint.Brush.TextMuted}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Ajouter sur ce site : grand site, déplié avec filtre -->
                        <StackPanel Visibility="{Binding ShowAddOpen, Converter={StaticResource Vis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ajouter une imprimante" Style="{StaticResource Grp}" Margin="6,10,4,4" />
                                <TextBlock Grid.Column="1" Text="{Binding AddCount}" Style="{StaticResource Grp}" FontWeight="Normal" Margin="0,10,0,4" />
                                <Button Grid.Column="2" Style="{StaticResource SmallIcon}" Width="26" Height="26" Margin="0,6,2,0" Command="{Binding CloseAddCommand}" ToolTip="Replier" AutomationProperties.Name="Replier">
                                    <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                                </Button>
                            </Grid>
                            <TextBox x:Name="AddSearch" Style="{StaticResource SearchBox}" Tag="Nom, bureau ou n° sur l'étiquette" AutomationProperties.Name="Filtrer les imprimantes du site"
                                     Text="{Binding AddQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <ItemsControl ItemsSource="{Binding AddPrinters}" ItemTemplate="{StaticResource AddRow}" Focusable="False" />
                            <TextBlock Text="Aucune imprimante de ce site ne correspond." Style="{StaticResource Hint}" Visibility="{Binding ShowAddNoMatch, Converter={StaticResource Vis}}" />
                        </StackPanel>

                        <!-- Télétravail ou réseau inconnu -->
                        <StackPanel Visibility="{Binding ShowTeleworkHint, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Hint}" Margin="6,8,6,6"
                                       Text="Vous n'êtes sur le réseau d'aucun site. Vos imprimantes reviennent quand vous y retournez. Depuis chez vous, connectez le VPN puis choisissez une imprimante." />
                            <Button Margin="4,4,4,2" Command="{Binding OpenElsewhereCommand}" Style="{StaticResource Autoprint.Button.Outline}" HorizontalContentAlignment="Left" Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Choisir un site et une imprimante" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Vos imprimantes sur d'autres sites : repliées, ménage à portée de main -->
                        <Grid Visibility="{Binding HasOthers, Converter={StaticResource Vis}}" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton Style="{x:Null}" IsChecked="{Binding IsOthersOpen}" Cursor="Hand" FocusVisualStyle="{StaticResource Autoprint.FocusVisual}" HorizontalAlignment="Left"
                                          AutomationProperties.Name="Vos imprimantes sur d'autres sites">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal" Background="Transparent" Margin="6,6,6,4">
                                            <materialDesign:PackIcon x:Name="Chev" Kind="ChevronRight" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Autoprint.Brush.TextMuted}" RenderTransformOrigin="0.5,0.5">
                                                <materialDesign:PackIcon.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </materialDesign:PackIcon.RenderTransform>
                                            </materialDesign:PackIcon>
                                            <TextBlock Text="Vos imprimantes sur d'autres sites" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Autoprint.Brush.TextMuted}" Margin="4,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding OtherCount}" FontSize="12" Foreground="{DynamicResource Autoprint.Brush.TextMuted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chev" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Button Grid.Column="1" Style="{StaticResource Link}" Content="Tout retirer" Command="{Binding RemoveAllOthersCommand}" VerticalAlignment="Center"
                                    Visibility="{Binding IsOthersOpen, Converter={StaticResource Vis}}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding OtherPrinters}" ItemTemplate="{StaticResource OtherRow}" Focusable="False"
                                      Visibility="{Binding IsOthersOpen, Converter={StaticResource Vis}}" />

                        <!-- Tout en bas : imprimer sur un autre site -->
                        <Button Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="2,8,0,0" Content="Imprimer sur un autre site"
                                Command="{Binding OpenElsewhereCommand}" Visibility="{Binding ShowElsewhereLink, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ================= Volet : imprimer sur un autre site ================= -->
            <DockPanel Background="{DynamicResource Autoprint.Brush.Surface}" Visibility="{Binding IsElsewhereOpen, Converter={StaticResource Vis}}">
                <Grid DockPanel.Dock="Top" Margin="8,10,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Button Style="{StaticResource Autoprint.Button.Icon}" Command="{Binding CloseElsewhereCommand}" ToolTip="Retour" AutomationProperties.Name="Retour"
                                Visibility="{Binding IsSiteStep, Converter={StaticResource Vis}}">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="19" Height="19" />
                        </Button>
                        <Button Style="{StaticResource Autoprint.Button.Icon}" Command="{Binding BackToSitesCommand}" ToolTip="Retour aux sites" AutomationProperties.Name="Retour aux sites"
                                Visibility="{Binding IsPrinterStep, Converter={StaticResource Vis}}">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="19" Height="19" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding ElsewhereTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Autoprint.Brush.Text}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Style="{StaticResource Autoprint.Button.Icon}" Command="{Binding CloseElsewhereCommand}" ToolTip="Fermer" AutomationProperties.Name="Fermer"
                            Visibility="{Binding IsPrinterStep, Converter={StaticResource Vis}}">
                        <materialDesign:PackIcon Kind="Close" Width="19" Height="19" />
                    </Button>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0,8,10">
                        <!-- Étape 1 : le site -->
                        <StackPanel Visibility="{Binding IsSiteStep, Converter={StaticResource Vis}}">
                            <TextBox x:Name="SiteSearch" Style="{StaticResource SearchBox}" Tag="Nom du site" AutomationProperties.Name="Filtrer les sites"
                                     Text="{Binding SiteQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <ItemsControl ItemsSource="{Binding Sites}" ItemTemplate="{StaticResource SiteRowTemplate}" Focusable="False" />
                            <TextBlock Text="Aucun site ne correspond." Style="{StaticResource Hint}" Visibility="{Binding ShowSitesNoMatch, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <!-- Étape 2 : l'imprimante de ce site -->
                        <StackPanel Visibility="{Binding IsPrinterStep, Converter={StaticResource Vis}}">
                            <TextBox x:Name="PrinterSearch" Style="{StaticResource SearchBox}" Tag="Nom, bureau ou n° d'étiquette" AutomationProperties.Name="Filtrer les imprimantes"
                                     Text="{Binding PrinterQuery, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowPrinterFilter, Converter={StaticResource Vis}}" />
                            <ItemsControl ItemsSource="{Binding SitePrinters}" ItemTemplate="{StaticResource SitePrinterRow}" Focusable="False" />
                            <TextBlock Text="Aucune imprimante ne correspond." Style="{StaticResource Hint}" Visibility="{Binding ShowSitePrintersNoMatch, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ================= Volet : réglages ================= -->
            <DockPanel Background="{DynamicResource Autoprint.Brush.Surface}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource Vis}}">
                <Grid DockPanel.Dock="Top" Margin="8,10,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Autoprint.Button.Icon}" Command="{Binding CloseSettingsCommand}" ToolTip="Retour" AutomationProperties.Name="Retour">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="19" Height="19" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="Réglages" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Autoprint.Brush.Text}" VerticalAlignment="Center" Margin="6,0" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Options}" Margin="14,0,14,12">
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Imprimante selon le site" Style="{StaticResource SetTitle}" />
                                <TextBlock Text="L'imprimante cochée suit le site où vous êtes" Style="{StaticResource Sub}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Autoprint.Switch}" IsChecked="{Binding AutoSwitchDefaultPrinter}" VerticalAlignment="Center" AutomationProperties.Name="Imprimante selon le site" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Annoncer le changement de site" Style="{StaticResource SetTitle}" />
                                <TextBlock Text="Une notification Windows, panneau fermé" Style="{StaticResource Sub}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Autoprint.Switch}" IsChecked="{Binding EnableNotifications}" VerticalAlignment="Center" AutomationProperties.Name="Annoncer le changement de site" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Démarrer avec Windows" Style="{StaticResource SetTitle}" />
                                <TextBlock Text="Autoprint reste près de l'horloge" Style="{StaticResource Sub}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Autoprint.Switch}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" AutomationProperties.Name="Démarrer avec Windows" />
                        </Grid>

                        <Button Style="{StaticResource Autoprint.Button.Outline}" HorizontalContentAlignment="Left" Height="36"
                                Command="{Binding DataContext.OpenWindowsPrintersCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Imprimantes et scanners de Windows" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 5 clics sur la version : informations serveur -->
                        <Button Command="{Binding VersionClickCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" Cursor="Arrow" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Autoprint.Brush.TextMuted}">
                                <Run Text="Autoprint" /> <Run Text="{Binding VersionText, Mode=OneWay}" />
                            </TextBlock>
                        </Button>

                        <ContentControl Style="{StaticResource Autoprint.AdminZone}" Margin="0,12,0,0" Padding="14,12" Focusable="False"
                                        Visibility="{Binding IsAdminPanelVisible, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Informations serveur" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Autoprint.Brush.Text}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource Link}" HorizontalAlignment="Right" Content="Fermer" Command="{Binding CloseAdminPanelCommand}" />
                                </Grid>
                                <TextBlock Text="Console et API" Style="{StaticResource Sub}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding AdminServerUrl}" Style="{StaticResource Autoprint.Text.Mono}" Foreground="{DynamicResource Autoprint.Brush.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AdminServerUrl}" />
                                <TextBlock Text="Partages d'impression" Style="{StaticResource Sub}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding AdminPrintServer}" Style="{StaticResource Autoprint.Text.Mono}" Foreground="{DynamicResource Autoprint.Brush.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AdminPrintServer}" />
                                <TextBlock Text="Clé d'API (4 derniers caractères)" Style="{StaticResource Sub}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding AdminApiKey}" Style="{StaticResource Autoprint.Text.Mono}" Foreground="{DynamicResource Autoprint.Brush.Text}" />
                                <Button Style="{StaticResource Autoprint.Button.Outline}" Content="Tester la connexion" Margin="0,12,0,0" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsNotTesting}" />
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="{Binding TestStatusMessage}" Foreground="{Binding TestStatusColor}" FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding IsNotTesting, Converter={StaticResource Vis}}" />
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Value="0" Width="18" Height="18" HorizontalAlignment="Left"
                                                 Visibility="{Binding IsTesting, Converter={StaticResource Vis}}" />
                                </Grid>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
